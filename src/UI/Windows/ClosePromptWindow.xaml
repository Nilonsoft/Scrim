<Window x:Class="Scrim.UI.Windows.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Scrim" Height="200" Width="400"
        Background="#0b0f19" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Do you want to minimize Scrim to the system tray, or exit completely?" 
                   Foreground="White" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"/>
        
        <CheckBox x:Name="RememberCheckBox" Grid.Row="1" Foreground="#a0aabf" Content="Remember my choice" 
                  VerticalAlignment="Top"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Minimize to Tray" Click="Minimize_Click" Width="110" Height="30" Margin="0,0,10,0" 
                    Background="#1ae2ff" Foreground="Black" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="Exit" Click="Exit_Click" Width="70" Height="30" Margin="0,0,10,0" 
                    Background="#383838" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="70" Height="30" 
                    Background="#1e1e1e" Foreground="#a0aabf" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
