    private static (byte[] WavBytes, byte[] PcmStereoBytes) GenerateSound(string name) {
        int sampleRate = 44100;
        int numSamples = (int)(sampleRate * (name.ToLower() switch {
            "airhorn" => 0.7,
            "applause" => 1.4,
            "rimshot" => 0.35,
            "laser" => 0.45,
            "vinyl" => 0.55,
            _ => 0.35
        }));
        short[] samples = new short[numSamples];
        var rand = new Random(42);

        for (int i = 0; i < numSamples; i++) {
            double t = (double)i / sampleRate;
            double s = 0;
            switch (name.ToLower()) {
                case "airhorn":
                    double envAir = Math.Min(1.0, t * 50.0) * Math.Max(0.0, 1.0 - t * 1.2);
                    s = (Math.Sin(2 * Math.PI * 470 * t) * 0.5 + 
                         Math.Sin(2 * Math.PI * 370 * t) * 0.3 + 
                         Math.Sin(2 * Math.PI * 705 * t) * 0.2 +
                         Math.Sin(2 * Math.PI * 940 * t) * 0.15) * envAir;
                    break;
                case "applause":
                    double envApp = Math.Min(1.0, t * 6.0) * Math.Max(0.0, 1.0 - (t / 1.4));
                    s = (rand.NextDouble() * 2.0 - 1.0) * envApp * 0.45;
                    break;
                case "rimshot":
                    double stick = (rand.NextDouble() * 2.0 - 1.0) * Math.Exp(-t * 60.0);
                    double drum = Math.Sin(2 * Math.PI * 220 * Math.Exp(-t * 15.0) * t) * Math.Exp(-t * 12.0);
                    s = (stick * 0.7 + drum * 0.5);
                    break;
                case "bleep":
                    double envBleep = Math.Min(1.0, t * 100.0) * Math.Max(0.0, 1.0 - (t / 0.35));
                    s = Math.Sin(2 * Math.PI * 1000 * t) * envBleep * 0.6;
                    break;
                case "laser":
                    double freq = 2200 * Math.Exp(-t * 6.0);
                    s = Math.Sin(2 * Math.PI * freq * t) * Math.Max(0.0, 1.0 - t * 2.0) * 0.6;
                    break;
                case "vinyl":
                    double scratch = (rand.NextDouble() * 2.0 - 1.0) * (Math.Sin(t * 80) > 0 ? 1 : 0) * 0.3;
                    double pitch = Math.Sin(2 * Math.PI * (400 * Math.Max(0.0, 1.0 - t * 2.5)) * t) * 0.4;
                    s = (scratch + pitch) * Math.Max(0.0, 1.0 - t * 1.6);
                    break;
            }
            s = Math.Max(-1.0, Math.Min(1.0, s));
            samples[i] = (short)(s * 32767);
        }

        // Stereo 44.1kHz 16-bit PCM for broadcast ducking mixer
        byte[] pcmStereo = new byte[numSamples * 4];
        for (int i = 0; i < numSamples; i++) {
            short sample = samples[i];
            byte lo = (byte)(sample & 0xFF);
            byte hi = (byte)((sample >> 8) & 0xFF);
            int off = i * 4;
            pcmStereo[off] = lo;
            pcmStereo[off + 1] = hi;
            pcmStereo[off + 2] = lo;
            pcmStereo[off + 3] = hi;
        }

        // Mono 44.1kHz 16-bit WAV for local DJ playback
        using var ms = new MemoryStream();
        using var bw = new BinaryWriter(ms);
        bw.Write(System.Text.Encoding.ASCII.GetBytes("RIFF"));
        bw.Write(36 + numSamples * 2);
        bw.Write(System.Text.Encoding.ASCII.GetBytes("WAVE"));
        bw.Write(System.Text.Encoding.ASCII.GetBytes("fmt "));
        bw.Write(16);
        bw.Write((short)1);
        bw.Write((short)1);
        bw.Write(sampleRate);
        bw.Write(sampleRate * 2);
        bw.Write((short)2);
        bw.Write((short)16);
        bw.Write(System.Text.Encoding.ASCII.GetBytes("data"));
        bw.Write(numSamples * 2);
        for (int i = 0; i < numSamples; i++) {
            bw.Write(samples[i]);
        }
        return (ms.ToArray(), pcmStereo);
    }

    private static byte[]? LoadWavToPcm16Stereo44100(string filePath) {
        try {
            using var fs = File.OpenRead(filePath);
            using var br = new BinaryReader(fs);
            if (new string(br.ReadChars(4)) != "RIFF") return null;
            br.ReadInt32();
            if (new string(br.ReadChars(4)) != "WAVE") return null;

            short channels = 2;
            int sampleRate = 44100;
            short bitsPerSample = 16;
            short audioFormat = 1;
            byte[]? rawAudio = null;

            while (fs.Position < fs.Length - 8) {
                string chunkId = new string(br.ReadChars(4));
                int chunkSize = br.ReadInt32();
                if (chunkId == "fmt ") {
                    audioFormat = br.ReadInt16();
                    channels = br.ReadInt16();
                    sampleRate = br.ReadInt32();
                    br.ReadInt32();
                    br.ReadInt16();
                    bitsPerSample = br.ReadInt16();
                    int extra = chunkSize - 16;
                    if (extra > 0) fs.Seek(extra, SeekOrigin.Current);
                } else if (chunkId == "data") {
                    rawAudio = br.ReadBytes(chunkSize);
                    break;
                } else {
                    fs.Seek(chunkSize, SeekOrigin.Current);
                }
            }

            if (rawAudio == null || rawAudio.Length == 0) return null;

            if (sampleRate == 44100 && bitsPerSample == 16 && channels == 2 && audioFormat == 1) {
                return rawAudio;
            }

            bool isFloat = audioFormat == 3 || bitsPerSample == 32;
            int bytesPerFrame = channels * (isFloat ? 4 : (bitsPerSample / 8));
            if (bytesPerFrame <= 0) return null;

            int inFrames = rawAudio.Length / bytesPerFrame;
            if (inFrames <= 0) return null;

            int outFrames = (sampleRate == 44100) ? inFrames : (int)Math.Round(inFrames * 44100.0 / sampleRate);
            if (outFrames <= 0) return null;

            byte[] outBytes = new byte[outFrames * 4];
            double ratio = (double)sampleRate / 44100.0;

            for (int j = 0; j < outFrames; j++) {
                double inIndex = j * ratio;
                int idx0 = (int)inIndex;
                double frac = inIndex - idx0;
                int idx1 = Math.Min(idx0 + 1, inFrames - 1);

                float l0, r0, l1, r1;
                if (isFloat) {
                    int o0 = idx0 * bytesPerFrame;
                    int o1 = idx1 * bytesPerFrame;
                    l0 = BitConverter.ToSingle(rawAudio, o0);
                    r0 = channels >= 2 ? BitConverter.ToSingle(rawAudio, o0 + 4) : l0;
                    l1 = BitConverter.ToSingle(rawAudio, o1);
                    r1 = channels >= 2 ? BitConverter.ToSingle(rawAudio, o1 + 4) : l1;
                } else {
                    int o0 = idx0 * bytesPerFrame;
                    int o1 = idx1 * bytesPerFrame;
                    l0 = BitConverter.ToInt16(rawAudio, o0) / 32768.0f;
                    r0 = channels >= 2 ? BitConverter.ToInt16(rawAudio, o0 + 2) / 32768.0f : l0;
                    l1 = BitConverter.ToInt16(rawAudio, o1) / 32768.0f;
                    r1 = channels >= 2 ? BitConverter.ToInt16(rawAudio, o1 + 2) / 32768.0f : l1;
                }

                float l = (float)(l0 * (1.0 - frac) + l1 * frac);
                float r = (float)(r0 * (1.0 - frac) + r1 * frac);
                short sL = (short)Math.Clamp((int)(l * 32767.0f), short.MinValue, short.MaxValue);
                short sR = (short)Math.Clamp((int)(r * 32767.0f), short.MinValue, short.MaxValue);

                int outOffset = j * 4;
                outBytes[outOffset] = (byte)(sL & 0xFF);
                outBytes[outOffset + 1] = (byte)((sL >> 8) & 0xFF);
                outBytes[outOffset + 2] = (byte)(sR & 0xFF);
                outBytes[outOffset + 3] = (byte)((sR >> 8) & 0xFF);
            }
            return outBytes;
        } catch {
            return null;
        }
    }

    private void PlayTrack(PlaylistItem track) {
        foreach (var t in PlaylistTracks) {
            t.IsPlaying = false;
        }
        track.IsPlaying = true;
        CurrentTrackTitle = track.Title;
        CurrentTrackArtist = track.Artist;
        CurrentTrackExtra = $"Duration: {track.Duration}";
        if (TimeSpan.TryParseExact(track.Duration, @"m\:ss", null, out var d) || 
            TimeSpan.TryParseExact(track.Duration, @"mm\:ss", null, out d)) {
            CurrentTrackDuration = d;
        } else {
            CurrentTrackDuration = TimeSpan.FromMinutes(3.5);
        }
        CurrentTrackPosition = TimeSpan.Zero;
        LastPositionUpdate = DateTimeOffset.UtcNow;
        IsPlayingMedia = true;
    }

