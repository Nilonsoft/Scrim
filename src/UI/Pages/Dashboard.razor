        }

        if (p.CollapsedCards != null) {
            CollapsedCards = new HashSet<string>(p.CollapsedCards);
        }

        // Subscribe to live Windows system media changes
        MetadataService.MetadataChanged += OnMetadataReceived;

        ConsoleChatMessages = ChatService.GetRecentMessages().ToList();
        ChatService.MessagePosted += OnChatMessageReceived;
        ChatService.MessageRemoved += OnChatMessageRemoved;
        ChatService.ChatCleared += OnChatCleared;
        ChatService.ChatStatusChanged += OnChatStatusChanged;
        ChatService.UserBanned += OnUserBanned;
        ReactionService.ReactionReceived += OnReactionReceived;
        ReactionService.CountsReset += OnReactionCountsReset;
        HistoryService.HistoryChanged += OnHistoryChanged;
        PluginLoader.PluginsChanged += OnPluginsChanged;
        RequestController.QueueChanged += OnQueueChanged;
        StreamServer.PollChanged += OnPollChanged;
        DualDeck.StateChanged += OnDualDeckChanged;
        SchedulerService.EventsChanged += OnSchedulerChanged;
        SchedulerService.EventTriggered += OnSchedulerActionTriggered;
        DeadAirService.StateChanged += OnDeadAirStateChanged;
        LocalPlayer.TrackChanged += OnLocalTrackChanged;
        LocalPlayer.PlaybackStateChanged += OnLocalPlaybackStateChanged;
        LocalPlayer.PositionChanged += OnLocalPositionChanged;
        LocalPlayer.PlaylistUpdated += OnLocalPlaylistUpdated;
        RelayService.StreamsChanged += OnRelayStreamsChanged;
        RelayService.StreamStatusUpdated += OnRelayStreamStatusUpdated;
        RelayService.ActiveRelayDisconnected += OnActiveRelayDisconnected;
        RelayService.RemoteGreenRoomMessageReceived += OnRemoteGreenRoomMessageReceived;
        Mixer.RelayAudioStream = RelayService.RelayAudioStream;
        _greenRoomMessages = StreamServer.GetGreenRoomMessages().ToList();
        StreamServer.GreenRoomMessagePosted += OnGreenRoomMessagePosted;
        StationManager.StationsChanged += OnStationManagerChanged;
        StationManager.StationBroadcastingStateChanged += OnStationBroadcastingChanged;

        if (!string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Title)) {
            CurrentTrackTitle = MetadataService.CurrentMetadata.Title;
            CurrentTrackArtist = string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Artist) ? "Live Stream" : MetadataService.CurrentMetadata.Artist;
            CurrentTrackExtra = string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Album) ? "Broadcast Audio" : MetadataService.CurrentMetadata.Album;
            CurrentTrackAlbumArtBase64 = MetadataService.CurrentMetadata.AlbumArtBase64;
            CurrentTrackDuration = MetadataService.CurrentMetadata.Duration;
            CurrentTrackPosition = MetadataService.CurrentMetadata.Position;
            LastPositionUpdate = DateTimeOffset.UtcNow;
            IsPlayingMedia = MetadataService.CurrentMetadata.IsPlaying;
        }

        // Restore user choices from persisted profile
        if (!string.IsNullOrEmpty(p.SelectedMicrophoneId) && Devices.Any(d => d.Id == p.SelectedMicrophoneId)) {
            SelectedDeviceId = p.SelectedMicrophoneId;
        } else if (!string.IsNullOrEmpty(p.SelectedMicrophoneName) && Devices.Any(d => string.Equals(d.Name, p.SelectedMicrophoneName, StringComparison.OrdinalIgnoreCase))) {
            var dev = Devices.FirstOrDefault(d => string.Equals(d.Name, p.SelectedMicrophoneName, StringComparison.OrdinalIgnoreCase));
            SelectedDeviceId = dev?.Id ?? "";
            p.SelectedMicrophoneId = SelectedDeviceId;
            ProfileManager.SaveProfile(p);
        } else if (string.IsNullOrEmpty(p.SelectedMicrophoneId)) {
            SelectedDeviceId = "";
        } else if (string.IsNullOrEmpty(SelectedDeviceId) && Devices.Any()) {
            var physicalMic = Devices.FirstOrDefault(d => !d.Name.Contains("cable", StringComparison.OrdinalIgnoreCase) &&
                                                          !d.Name.Contains("vb-audio", StringComparison.OrdinalIgnoreCase) &&
                                                          !d.Name.Contains("virtual", StringComparison.OrdinalIgnoreCase));
            SelectedDeviceId = physicalMic?.Id ?? Devices.First().Id;
            p.SelectedMicrophoneId = SelectedDeviceId;
            p.SelectedMicrophoneName = physicalMic?.Name ?? Devices.First().Name;
            ProfileManager.SaveProfile(p);
        }

        if (!string.IsNullOrEmpty(p.SelectedVoiceEffect)) {
            MicService.CurrentEffect = p.SelectedVoiceEffect;
        }

        if (Enum.TryParse<MicControlMode>(p.MicControlMode, true, out var savedMode)) {
            Mixer.ControlMode = savedMode;
        }

        if (p.MicMonitoring) {
            MicService.IsMonitoring = true;
        }

        // Auto-select target window by saved name/ID if available, or default to system audio
        WindowInfo? initialWin = null;
        if (!string.IsNullOrEmpty(p.TargetProcessName) && !p.TargetProcessName.Equals("System Audio", StringComparison.OrdinalIgnoreCase)) {
            initialWin = Windows.FirstOrDefault(w => string.Equals(w.ProcessName, p.TargetProcessName, StringComparison.OrdinalIgnoreCase))
                      ?? Windows.FirstOrDefault(w => w.Title.Contains(p.TargetProcessName, StringComparison.OrdinalIgnoreCase));
        }
        if (initialWin == null && p.TargetProcessId > 0) {
            initialWin = Windows.FirstOrDefault(w => w.ProcessId == (uint)p.TargetProcessId);
        }

        if (initialWin != null) {
            SelectedProcessId = initialWin.ProcessId;
            SelectedProcessDisplayName = !string.IsNullOrEmpty(initialWin.ProcessName) ? initialWin.ProcessName : initialWin.Title;
            MetadataService.StartMonitoring(SelectedProcessId);
            EnsureAudioMonitoring(SelectedProcessId);
        } else if (!string.IsNullOrEmpty(p.TargetProcessName) && !p.TargetProcessName.Equals("System Audio", StringComparison.OrdinalIgnoreCase)) {
            SelectedProcessId = (uint)(p.TargetProcessId > 0 ? p.TargetProcessId : 999999);
            SelectedProcessDisplayName = p.TargetProcessName;
            EnsureAudioMonitoring(0);
        } else {
            SelectedProcessId = 0;
            SelectedProcessDisplayName = "System Audio";
            EnsureAudioMonitoring(0);
        }

        // Restore and ensure Virtual Cable or selected audio device routing if previously configured
        if (!string.IsNullOrEmpty(p.CaptureDeviceId)) {
            if (!RenderDevices.Any(d => d.Id == p.CaptureDeviceId)) {
                if (!string.IsNullOrEmpty(p.CaptureDeviceName)) {
                    var matched = RenderDevices.FirstOrDefault(d => string.Equals(d.Name, p.CaptureDeviceName, StringComparison.OrdinalIgnoreCase));
                    if (matched.Id != null) {
                        p.CaptureDeviceId = matched.Id;
                        ProfileManager.SaveProfile(p);
                    }
                }
                if (!RenderDevices.Any(d => d.Id == p.CaptureDeviceId)) {
                    if (IsVbCableInstalled && !string.IsNullOrEmpty(VbCableDeviceId)) {
                        p.CaptureDeviceId = VbCableDeviceId;
                        ProfileManager.SaveProfile(p);
                    } else if (IsVirtualDeviceReady && !string.IsNullOrEmpty(DetectedVirtualDeviceId)) {
                        p.CaptureDeviceId = DetectedVirtualDeviceId;
                        ProfileManager.SaveProfile(p);
                    }
                }
            }
        }
        MicService.SetVirtualOutputDevice(null);

        Mixer.AppVolume = (float)ProfileManager.CurrentProfile.AppStreamVolume / 100f;
        CustomBitrateInput = ProfileManager.CurrentProfile.Bitrate;
        CustomPortInput = ProfileManager.CurrentProfile.Port;
        LoadAllPluginConfigs();
        SyncDjEqFromProfile();

        // Ensure Web Player HTTP server is running so listeners can always view the station
        try {
            StreamServer.Start(ProfileManager.CurrentProfile.Port);
        } catch { }

        IsLive = Hub.IsBroadcasting;
        Hub.BroadcastingStateChanged += OnHubBroadcastingStateChanged;

        if (!FFmpegService.IsInstalled) {
            ShowFFmpegModal = true;
        }

        if (p.BroadcastOnOpen && !IsLive) {
            StartBroadcast();
        }

        Task.Run(async () => {
            await NetworkDiscovery.RefreshPublicIpAsync();
            await InvokeAsync(StateHasChanged);
        });

        // Periodic UI poll for active listener updates, active applications, and track progress
        _refreshTimer = new System.Timers.Timer(1000);
        _refreshTimer.Elapsed += (s, e) => {
            // 24/7 Watchdog: Ensure HTTP Web Player server remains active continuously
            if (!StreamServer.IsListening) {
                try {
                    StreamServer.Start(ProfileManager.CurrentProfile.Port);
                } catch { }
            }
            RefreshWindows();
            if (IsPlayingMedia && CurrentTrackDuration > TimeSpan.Zero) {
                var now = DateTimeOffset.UtcNow;
                var delta = now - LastPositionUpdate;
                if (delta >= TimeSpan.FromSeconds(0.7)) {
                    CurrentTrackPosition += delta;
                    if (CurrentTrackPosition > CurrentTrackDuration) {
                        CurrentTrackPosition = CurrentTrackDuration;
                    }
                    LastPositionUpdate = now;
                }
            }
            // Read active lyrics from LyricsTicker OBS output
            try {
                var userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
                string lyricsFile = Path.Combine(userProfile, ".scrim", "obs", "lyrics.txt");
                if (File.Exists(lyricsFile)) {
                    string lText = File.ReadAllText(lyricsFile).Trim();
                    if (_currentLiveLyric != lText) {
                        _currentLiveLyric = lText;
                    }
                }
            } catch { }
            InvokeAsync(StateHasChanged);
        };
        _refreshTimer.Start();

        // High-frequency real audio level update for analog VU meters and broadcast stream out (50ms)
        _vuTimer = new System.Timers.Timer(50);
        _vuTimer.Elapsed += async (s, e) => {
            try {
                float left = Mixer.LeftLevel;
                float right = Mixer.RightLevel;
                float mic = MicService.InputLevel;
                bool isLive = IsLive;
                DeadAirService.UpdateCurrentLevel(Math.Max(left, right));
                if (Hub.ActiveClientCount > _peakListenerCount) {
                    _peakListenerCount = Hub.ActiveClientCount;
                }
                await InvokeAsync(async () => {
                    try {
                        await JSRuntime.InvokeVoidAsync("scrimDragDrop.setStreamOutLevels", left, right, mic, isLive);
                    } catch { }
                });
            } catch { }
        };
        _vuTimer.Start();
    }

    private void OnProcessChanged() {
        if (SelectedProcessId != 0) {
            var win = Windows.FirstOrDefault(w => w.ProcessId == SelectedProcessId);
            ProfileManager.CurrentProfile.TargetProcessId = (int)SelectedProcessId;
            if (win != null) {
                SelectedProcessDisplayName = !string.IsNullOrEmpty(win.ProcessName) ? win.ProcessName : win.Title;
                ProfileManager.CurrentProfile.TargetProcessName = SelectedProcessDisplayName;
            }
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
