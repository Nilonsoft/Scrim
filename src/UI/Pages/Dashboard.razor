                    <div style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px;">
                            <span style="color: #94a3b8; font-weight: 600;">Left Column Width:</span>
                            <span style="color: #00d2ff; font-weight: 700; font-family: monospace;">@(ProfileManager.CurrentProfile.CustomLeftWidth)px</span>
                        </div>
                        <input type="range" min="200" max="550" step="10" 
                               style="width: 100%; cursor: pointer;"
                               value="@ProfileManager.CurrentProfile.CustomLeftWidth"
                               @oninput="@((ChangeEventArgs e) => OnCustomWidthChanged(int.Parse(e.Value?.ToString() ?? "320"), ProfileManager.CurrentProfile.CustomRightWidth))" />
                    </div>

                    <div style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px;">
                            <span style="color: #94a3b8; font-weight: 600;">Right Column Width:</span>
                            <span style="color: #00d2ff; font-weight: 700; font-family: monospace;">@(ProfileManager.CurrentProfile.CustomRightWidth)px</span>
                        </div>
                        <input type="range" min="200" max="550" step="10" 
                               style="width: 100%; cursor: pointer;"
                               value="@ProfileManager.CurrentProfile.CustomRightWidth"
                               @oninput="@((ChangeEventArgs e) => OnCustomWidthChanged(ProfileManager.CurrentProfile.CustomLeftWidth, int.Parse(e.Value?.ToString() ?? "340")))" />
                    </div>
                </div>
            }
        </div>
    </div>
}

