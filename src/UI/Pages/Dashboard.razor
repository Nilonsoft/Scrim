    private void ExecuteScheduledEvent(ScheduledEvent ev) {
        switch (ev.ActionType) {
            case ScheduledActionType.PlayJingle:
                break;
            case ScheduledActionType.PostChatMessage:
                if (!string.IsNullOrWhiteSpace(ev.ActionPayload)) {
                    ChatService.AddMessage("Radio Host", ev.ActionPayload, true);
                }
                break;
            case ScheduledActionType.SwitchTheme:
                if (!string.IsNullOrWhiteSpace(ev.ActionPayload)) {
                    ProfileManager.CurrentProfile.WebTheme = ev.ActionPayload;
                    ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
                }
                break;
            case ScheduledActionType.TriggerPoll:
                if (!string.IsNullOrWhiteSpace(ev.ActionPayload)) {
                    StreamServer.CreatePoll(ev.ActionPayload, new List<string> { "Yes / Fire 🔥", "No / Skip ⏭️" });
                }
                break;
        }
        StateHasChanged();
    }

