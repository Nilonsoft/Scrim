@page "/"
@implements IDisposable
@using Scrim.Audio
@using Scrim.Configuration
@using Scrim.Encoding
@using Scrim.Metadata
@using Scrim.Plugins
@using Scrim.Server
@using Scrim.Windows
@using System.Timers
@using System.Threading
@using System.IO
@using System.Text.Json
@using System.Net.Http
@inject IProfileManager ProfileManager
@inject HttpStreamServer StreamServer
@inject IMultiStationManager StationManager
@inject BroadcastHub Hub
@inject ProcessLoopbackCapture Capture
@inject MultiFormatTranscoder Transcoder
@inject MicrophoneCaptureService MicService
@inject AudioDuckingMixer Mixer
@inject VoiceEffectLoader EffectLoader
@inject SongRequestController RequestController
@inject IMetadataService MetadataService
@inject PluginLoader PluginLoader
@inject IJSRuntime JSRuntime
@inject LocalAudioRoutingService LocalAudioRouting
@inject INetworkDiscoveryService NetworkDiscovery
@inject VirtualAudioDeviceService VirtualDeviceService
@inject IThemeService ThemeService
@inject ILiveChatService ChatService
@inject ISongReactionService ReactionService
@inject ISongHistoryService HistoryService
@inject IFFmpegService FFmpegService
@inject DualDeckMixerService DualDeck
@inject EventSchedulerService SchedulerService
@inject DeadAirRecoveryService DeadAirService
@inject LocalMusicPlayerService LocalPlayer
@inject StreamRelayService RelayService

<style>
    :root {
        zoom: @((ProfileManager.CurrentProfile.UiScalePercentage > 0 ? ProfileManager.CurrentProfile.UiScalePercentage / 100.0 : 1.0).ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    .station-switcher-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #0d1017;
        border-bottom: 1px solid #1c2230;
        padding: 6px 16px;
        gap: 12px;
        overflow-x: auto;
    }
    .station-switcher-pills {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .station-tab-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #141923;
        border: 1px solid #232c3d;
        border-radius: 8px;
        padding: 4px 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }
    .station-tab-pill:hover {
        background: #19202d;
        border-color: #323e54;
    }
    .station-tab-pill.active {
        background: rgba(0, 210, 255, 0.08);
        border-color: #00d2ff;
        box-shadow: 0 0 12px rgba(0, 210, 255, 0.2);
    }
    .station-tab-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .station-tab-dot.live {
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
        animation: pulseLiveDot 2s infinite;
    }
    .station-tab-dot.offline {
        background: #64748b;
    }
    .station-tab-name {
        font-size: 12px;
        font-weight: 700;
        color: #f1f5f9;
    }
    .station-tab-mount {
        font-size: 10px;
        font-family: 'JetBrains Mono', monospace;
        color: #94a3b8;
        background: rgba(0, 0, 0, 0.35);
        padding: 1px 5px;
        border-radius: 4px;
    }
    .station-tab-onair-btn {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.5px;
        border: none;
        border-radius: 4px;
        padding: 2px 7px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .station-tab-onair-btn.onair {
        background: #ef4444;
        color: #ffffff;
        box-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
    }
    .station-tab-onair-btn.offline {
        background: #1e2638;
        color: #94a3b8;
    }
    .station-tab-onair-btn.offline:hover {
        background: #10b981;
        color: #ffffff;
    }
    .station-add-btn {
        background: rgba(255, 255, 255, 0.04);
        border: 1px dashed #2d3748;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
        border-radius: 8px;
        padding: 5px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .station-add-btn:hover {
        background: rgba(0, 210, 255, 0.1);
        border-color: #00d2ff;
        color: #00d2ff;
    }
    @@keyframes pulseLiveDot {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.2); opacity: 0.7; }
    }
</style>

@if (ProfileManager.CurrentProfile.SyncConsoleThemeWithWeb) {
    var activeTheme = ThemeService.GetTheme(ProfileManager.CurrentProfile.WebTheme);
    if (activeTheme != null) {
        var themeVars = activeTheme.GetConsoleCssVariables(ProfileManager.CurrentProfile.AccentColor);
        <style>
            :root {
                @foreach (var kv in themeVars) {
                    @($"{kv.Key}: {kv.Value} !important;\n")
                }
            }
        </style>
    }
}

<!-- Top Header Bar -->
<header class="scrim-topbar">
    <div style="display: flex; align-items: center; gap: 14px;">
        <button class="scrim-menu-btn" title="Add Cards / Layout" @onclick="@(() => ShowAddCardMenu = !ShowAddCardMenu)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <span style="font-weight: 700; font-size: 15px; letter-spacing: 1px; color: #fff;">SCRIM CONSOLE</span>
        
        <button class="scrim-btn-primary" style="padding: 4px 14px; font-size: 12px;" @onclick="@(() => ShowAddCardMenu = !ShowAddCardMenu)">
            + Add / Manage Cards @(GetHiddenCardsCount() > 0 ? $"({GetHiddenCardsCount()})" : "")
        </button>

        <button class="scrim-btn-secondary" style="padding: 4px 12px; font-size: 11px;" @onclick="@(() => ShowAddCardMenu = !ShowAddCardMenu)" title="Change Column Widths & Layout Proportions">
            📐 Columns: @GetLayoutModeName()
        </button>

        <button class="scrim-btn-secondary" style="padding: 4px 12px; font-size: 11px; background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.45); color: #c084fc; display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="@(() => ShowPluginsModal = !ShowPluginsModal)" title="Manage Installed Plugins">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
            <span>🔌 Plugins (@PluginLoader.Plugins.Count(p => p.IsEnabled)/@PluginLoader.Plugins.Count)</span>
        </button>

        <div style="display: flex; align-items: center; gap: 6px; background: #161922; border: 1px solid #282f3e; border-radius: 6px; padding: 2px 8px;">
            <span style="font-size: 11px; color: #8b92a2; font-weight: 600;">Venue Profile:</span>
            <select class="scrim-select" style="padding: 2px 6px; font-size: 11px; max-width: 130px; height: 24px; border: none; background: transparent; color: #00d2ff; font-weight: 700; cursor: pointer;" value="@ProfileManager.CurrentProfile.ProfileName" @onchange="OnProfileSelectChanged">
                @foreach (var prof in AvailableProfileNames) {
                    <option value="@prof" style="background: #161922; color: #fff;">@prof</option>
                }
            </select>
            <button class="scrim-dots-btn" style="padding: 2px 4px; font-size: 12px; color: #00d2ff;" title="Profile Management (Save As, Export, Import)" @onclick="@(() => ShowProfileModal = !ShowProfileModal)">
                📁
            </button>
        </div>
    </div>

    <!-- Center ON AIR Glowing Badge & Stream TX Indicator -->
    <div style="display: flex; align-items: center; gap: 10px;">
        <div class="on-air-badge @(IsLive ? "" : "offline")" @onclick="ToggleBroadcast" title="Click to toggle broadcast">
            <span class="on-air-dot"></span>
            <span>@(IsLive ? "ON AIR" : "OFFLINE")</span>
        </div>
        <div class="topbar-tx-badge @(IsLive ? "tx-on" : "tx-off")" @onclick="ToggleBroadcast" title="@(IsLive ? "Transmitter Active (Live Broadcasting) - Click to Stop TX" : "Transmitter Standby (Offline) - Click to Start TX")">
            <span class="topbar-tx-dot"></span>
            <span class="topbar-tx-label">TX</span>
            <div class="topbar-tx-meter">
                <div id="topbar-tx-indicator" class="topbar-tx-fill"></div>
            </div>
        </div>
        @if (!FFmpegService.IsInstalled) {
            <button class="scrim-btn-danger" style="padding: 4px 10px; font-size: 11px; display: flex; align-items: center; gap: 6px; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #ef4444; border-radius: 6px; cursor: pointer;" @onclick="@(() => ShowFFmpegModal = true)" title="FFmpeg not detected. Click for installation instructions.">
                <span>⚠️ FFmpeg Missing</span>
            </button>
        }
    </div>

    <!-- Right Listeners Count & Web Player Link -->
    <div style="display: flex; align-items: center; gap: 12px;">
        @if (IsLive) {
            <button class="listeners-pill" style="background: #14171d; border: 1px solid rgba(0, 210, 255, 0.3); color: #00d2ff; cursor: pointer;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Open Web Player in Default Browser">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                </svg>
                <span>Web Player :@(ProfileManager.CurrentProfile.Port) ↗</span>
            </button>
            <button class="listeners-pill" style="background: #14171d; border: 1px solid rgba(0, 210, 255, 0.3); color: #00d2ff; cursor: pointer;" @onclick="@(() => ShowShareModal = !ShowShareModal)" title="Share station link with network or outside listeners">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span>Share Stream</span>
            </button>
        }
        <div class="listeners-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Current listeners @ListenerCount</span>
        </div>
        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 12px; display: flex; align-items: center; gap: 6px; cursor: pointer;" @onclick="@(() => ShowAdminSettingsModal = true)" title="Application Settings, Updates & UI Scaling">
            <span>⚙️ Settings</span>
        </button>
    </div>
</header>

<!-- Multi-Station Console Switcher Bar -->
<div class="station-switcher-bar">
    <div class="station-switcher-pills">
        @foreach (var st in StationManager.GetAllStations()) {
            bool isActive = st.Config.Id == (StationManager.GetActiveStation()?.Config.Id ?? "");
            <div class="station-tab-pill @(isActive ? "active" : "")" @onclick="@(() => OnSwitchStation(st.Config.Id))">
                <span class="station-tab-dot @(st.IsLive ? "live" : "offline")"></span>
                <span class="station-tab-name">@st.Config.Name</span>
                <span class="station-tab-mount">/@(st.Config.MountPoint?.Trim('/') ?? "stream")</span>
                <button class="station-tab-onair-btn @(st.IsLive ? "onair" : "offline")" 
                        @onclick:stopPropagation="true" 
                        @onclick="@(() => OnToggleStationLive(st))" 
                        title="@(st.IsLive ? "Stop this station's broadcast" : "Start this station's broadcast")">
                    @(st.IsLive ? "ON AIR" : "GO LIVE")
                </button>
            </div>
        }
        <button class="station-add-btn" @onclick="OnAddNewStation" title="Add a new radio station to this console">
            ＋ Add Station
        </button>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 11px; color: #8b92a2;">
            Concurrent: <strong style="color: #10b981;">@StationManager.GetAllStations().Count(s => s.IsLive)</strong>/@StationManager.GetAllStations().Count Live
        </span>
    </div>
</div>

<AdminSettingsModal @bind-IsOpen="ShowAdminSettingsModal" OnScaleChanged="OnUiScaleChanged" />

<!-- Add Station Modal -->
@if (ShowAddStationModal) {
    <div class="scrim-modal-backdrop" @onclick="@(() => ShowAddStationModal = false)">
        <div class="scrim-modal" style="max-width: 520px; width: 90%;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px;">
                    📻 Add New Station
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => ShowAddStationModal = false)">✕</button>
            </div>

            <p style="font-size: 12px; color: #8b92a2; margin-top: 0; margin-bottom: 16px; line-height: 1.4;">
                Create an independent radio station with its own stream mount point, audio source (e.g. Spotify, Chrome, Built-in Player), branding, chat, and listener front-end.
            </p>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 18px;">
                <div>
                    <label style="font-size: 11px; font-weight: 600; color: #94a3b8; display: block; margin-bottom: 4px;">Station Display Name</label>
                    <input class="scrim-input" style="width: 100%; box-sizing: border-box;" @bind="NewStationName" placeholder="e.g. Spotify Lo-Fi Stream" />
                </div>
                <div>
                    <label style="font-size: 11px; font-weight: 600; color: #94a3b8; display: block; margin-bottom: 4px;">Stream Mount Point (URL Path)</label>
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <span style="font-size: 12px; color: #64748b; font-family: monospace;">/</span>
                        <input class="scrim-input" style="flex: 1;" @bind="NewStationMount" placeholder="e.g. spotify" />
                    </div>
                    <span style="font-size: 10px; color: #64748b; margin-top: 3px; display: block;">Listeners will tune into: http://localhost:@(ProfileManager.CurrentProfile.Port)/@(string.IsNullOrWhiteSpace(NewStationMount) ? "channel" : NewStationMount.Trim().Trim('/'))</span>
                </div>
                <div>
                    <label style="font-size: 11px; font-weight: 600; color: #94a3b8; display: block; margin-bottom: 4px;">Audio Source (Zero Virtual Cables)</label>
                    <select class="scrim-select" style="width: 100%; box-sizing: border-box;" @bind="NewStationSource">
                        <option value="@AudioSourceType.ProcessLoopback">App Loopback (Spotify, Chrome, Browser, Media Player)</option>
                        <option value="@AudioSourceType.BuiltInPlayer">Built-in Local Player (Clockwheel &amp; Automation Crate)</option>
                        <option value="@AudioSourceType.AudioDevice">Audio Hardware Input / Mic</option>
                        <option value="@AudioSourceType.SystemMix">Master System Mix</option>
                        <option value="@AudioSourceType.IcecastIngest">🎧 External DJ Ingest (Icecast / BUTT / OBS / Mixxx)</option>
                    </select>
                </div>
                @if (NewStationSource == AudioSourceType.IcecastIngest) {
                    <div style="background: rgba(0, 210, 255, 0.04); border: 1px solid rgba(0, 210, 255, 0.2); border-radius: 8px; padding: 10px 12px;">
                        <label style="font-size: 11px; font-weight: 600; color: #00d2ff; display: block; margin-bottom: 4px;">Guest DJ Ingest Password</label>
                        <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                            <input class="scrim-input" style="flex: 1;" @bind="NewStationIngestPassword" placeholder="e.g. scrimpass" />
                            <button type="button" class="scrim-btn-secondary" style="font-size: 11px; padding: 4px 10px;" @onclick="GenerateRandomIngestPassword" title="Generate Random Password">🎲 Generate</button>
                        </div>
                        <div style="font-size: 10px; color: #94a3b8; line-height: 1.6;">
                            <strong style="color: #cbd5e1;">Icecast 2 Connection Details for Guest DJ:</strong><br />
                            • <strong>Server / Host:</strong> <span style="font-family: monospace; color: #38bdf8;">@(GetIngestServerHost())</span><br />
                            • <strong>Port:</strong> <span style="font-family: monospace; color: #38bdf8;">@(ProfileManager.CurrentProfile.Port)</span><br />
                            • <strong>Mount Point:</strong> <span style="font-family: monospace; color: #38bdf8;">/@(string.IsNullOrWhiteSpace(NewStationMount) ? "channel" : NewStationMount.Trim().Trim('/'))</span><br />
                            • <strong>Username:</strong> <span style="font-family: monospace; color: #38bdf8;">source</span><br />
                            • <strong>Password:</strong> <span style="font-family: monospace; color: #38bdf8;">@NewStationIngestPassword</span><br />
                            • <strong>Compatible DJ Software:</strong> BUTT, Mixxx, OBS Studio, Traktor, SAM Broadcaster, VirtualDJ
                        </div>
                    </div>
                }
                @if (NewStationSource == AudioSourceType.ProcessLoopback) {
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                            <label style="font-size: 11px; font-weight: 600; color: #94a3b8;">Target Application / Audio Source</label>
                            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="font-size: 10px; color: #00d2ff; background: none; border: none; cursor: pointer;" @onclick="ForceRefreshWindows" title="Re-scan open applications and audio sessions">🔄 Refresh Apps</button>
                        </div>
                        <select class="scrim-select" style="width: 100%; box-sizing: border-box;" @bind="NewStationProcessId" @bind:after="OnNewStationProcessChanged">
                            <option value="0">-- Select an Application --</option>
                            @if (Windows.Any(w => w.IsPlayingAudio)) {
                                <optgroup label="🔊 Currently Playing Audio">
                                    @foreach (var w in Windows.Where(w => w.IsPlayingAudio)) {
                                        <option value="@w.ProcessId">🔊 @w.ProcessName - @w.Title</option>
                                    }
                                </optgroup>
                            }
                            <optgroup label="Available Applications">
                                @foreach (var w in Windows.Where(w => !w.IsPlayingAudio)) {
                                    <option value="@w.ProcessId">@(!string.IsNullOrEmpty(w.ProcessName) && !w.Title.StartsWith(w.ProcessName, StringComparison.OrdinalIgnoreCase) ? $"{w.ProcessName} - {w.Title}" : w.Title)</option>
                                }
                            </optgroup>
                        </select>
                        <span style="font-size: 10px; color: #64748b; margin-top: 3px; display: block;">Select the app to capture (e.g. Spotify, Chrome, VLC). Scrim will isolate its audio and stream it on this station.</span>
                    </div>
                }
                <div style="padding-top: 4px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;">
                        <input type="checkbox" @bind="NewStationShowOnMainPage" style="accent-color: #00d2ff; width: 14px; height: 14px;" />
                        <span style="font-size: 11px; font-weight: 600; color: #cbd5e1;">Link on Main Page (Channel Dial)</span>
                    </label>
                    <span style="font-size: 10px; color: #64748b; margin-top: 2px; margin-left: 22px; display: block;">
                        Unchecked by default. Leave unchecked to keep this station unlisted from the main web player dial. Listeners can still tune in directly via its direct URL or dedicated PWA.
                    </span>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button class="scrim-btn-secondary" @onclick="@(() => ShowAddStationModal = false)">Cancel</button>
                <button class="scrim-btn-primary" @onclick="ConfirmAddStation">Create Station</button>
            </div>
        </div>
    </div>
}

<!-- Profile Management Modal -->
@if (ShowProfileModal) {
    <div class="scrim-modal-backdrop" @onclick="@(() => ShowProfileModal = false)">
        <div class="scrim-modal" style="max-width: 480px; width: 90%;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px;">
                    📁 Stream Profiles &amp; Venues
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => ShowProfileModal = false)">✕</button>
            </div>

            <p style="font-size: 12px; color: #8b92a2; margin-top: 0; margin-bottom: 16px; line-height: 1.4;">
                Profiles save all your card layouts, collapsed states, DJ mixer EQ settings, audio routing, and branding for instant switching between different venues or shows.
            </p>

            @if (!string.IsNullOrEmpty(ProfileModalMessage)) {
                <div style="font-size: 12px; color: #00d2ff; background: rgba(0, 210, 255, 0.08); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(0, 210, 255, 0.2); margin-bottom: 14px;">
                    @ProfileModalMessage
                </div>
            }

            <div style="margin-bottom: 14px;">
                <label class="scrim-label">Active Profile: <strong style="color: #00d2ff;">@ProfileManager.CurrentProfile.ProfileName</strong></label>
                <div style="display: flex; gap: 8px; margin-top: 6px;">
                    <button class="scrim-btn-primary" style="flex: 1;" @onclick="QuickSaveCurrentProfile">💾 Save Current State</button>
                    <button class="scrim-btn-secondary" @onclick="ExportCurrentProfile" title="Export profile to a .json file">↗ Export</button>
                    <button class="scrim-btn-secondary" @onclick="ImportProfileFromFile" title="Import profile from a .json file">↙ Import</button>
                </div>
            </div>

            <div style="border-top: 1px dashed #282f3e; padding-top: 14px; margin-bottom: 14px;">
                <label class="scrim-label">Save As New Venue / Show Profile</label>
                <div style="display: flex; gap: 8px; margin-top: 6px;">
                    <input type="text" class="scrim-input" style="flex: 1;" @bind="NewProfileNameInput" placeholder="e.g. Club Night, Talk Radio" />
                    <button class="scrim-btn-secondary" @onclick="CreateNewProfileFromCurrent" disabled="@string.IsNullOrWhiteSpace(NewProfileNameInput)">Create</button>
                </div>
            </div>

            <div style="border-top: 1px dashed #282f3e; padding-top: 14px;">
                <label class="scrim-label">Switch or Manage Saved Profiles</label>
                <div style="display: flex; flex-direction: column; gap: 6px; max-height: 180px; overflow-y: auto; margin-top: 6px;">
                    @foreach (var name in AvailableProfileNames) {
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #161922; border: 1px solid #232731; border-radius: 6px; padding: 6px 10px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                @if (string.Equals(name, ProfileManager.CurrentProfile.ProfileName, StringComparison.OrdinalIgnoreCase)) {
                                    <span style="color: #00d2ff; font-weight: 700; font-size: 12px;">✓ @name (Active)</span>
                                } else {
                                    <span style="color: #ccc; font-size: 12px;">@name</span>
                                }
                            </div>
                            <div style="display: flex; gap: 4px;">
                                @if (!string.Equals(name, ProfileManager.CurrentProfile.ProfileName, StringComparison.OrdinalIgnoreCase)) {
                                    <button class="scrim-btn-secondary" style="font-size: 11px; padding: 2px 8px;" @onclick="@(() => SwitchToProfile(name))">Switch</button>
                                }
                                @if (!string.Equals(name, "Default", StringComparison.OrdinalIgnoreCase)) {
                                    <button class="scrim-dots-btn" style="color: #ef4444; font-size: 12px; padding: 2px 6px;" title="Delete Profile" @onclick="@(() => DeleteCustomProfile(name))">🗑</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 16px; border-top: 1px solid #232731; padding-top: 12px;">
                <button class="scrim-btn-secondary" @onclick="@(() => ShowProfileModal = false)">Close</button>
            </div>
        </div>
    </div>
}

<!-- Share Broadcast Modal -->
@if (ShowShareModal) {
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: flex; align-items: center; justify-content: center; z-index: 999;" @onclick="@(() => ShowShareModal = false)">
        <div style="background: #181b22; border: 1px solid #2d323e; border-radius: 12px; padding: 24px; max-width: 540px; width: 92%; box-shadow: 0 16px 40px rgba(0,0,0,0.85);" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 16px; color: #fff; display: flex; align-items: center; gap: 8px;">
                    🌐 Share Broadcast Stream
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => ShowShareModal = false)">✕</button>
            </div>
            
            <p style="font-size: 12px; color: #94a3b8; margin-top: 0; margin-bottom: 16px; line-height: 1.5;">
                Listeners can tune in by opening these links in their web browser or media player.
            </p>

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <!-- Localhost URL -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 700; color: #38bdf8; letter-spacing: 0.5px;">LOCAL MACHINE</span>
                        <span style="font-size: 11px; color: #64748b;">This computer</span>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 6px 10px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Click to open in browser">
                            <span style="color: #38bdf8; text-decoration: underline; font-family: monospace; font-size: 12px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                http://localhost:@(ProfileManager.CurrentProfile.Port)
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 6px 12px; font-size: 12px; white-space: nowrap;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 12px; white-space: nowrap;" @onclick='() => CopyUrl($"http://localhost:{ProfileManager.CurrentProfile.Port}", "Localhost")'>
                            @(CopiedUrlTarget == "Localhost" ? "✓ Copied!" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Local LAN URL -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 700; color: #00d2ff; letter-spacing: 0.5px;">LOCAL NETWORK (WI-FI / LAN)</span>
                        <span style="font-size: 11px; color: #64748b;">For devices on your home network</span>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 6px 10px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Click to open in browser">
                            <span style="color: #00d2ff; text-decoration: underline; font-family: monospace; font-size: 12px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetLocalNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 6px 12px; font-size: 12px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 12px; white-space: nowrap;" @onclick='() => CopyUrl(GetLocalNetworkUrl(), "LAN")'>
                            @(CopiedUrlTarget == "LAN" ? "✓ Copied!" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Outside of Local Network (Internet) -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 700; color: #10b981; letter-spacing: 0.5px;">OUTSIDE NETWORK (INTERNET)</span>
                        <span style="font-size: 11px; color: #64748b;">For remote listeners anywhere</span>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 6px 10px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Click to open in browser">
                            <span style="color: #10b981; text-decoration: underline; font-family: monospace; font-size: 12px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetOutsideNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 6px 12px; font-size: 12px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 12px; white-space: nowrap;" @onclick='() => CopyUrl(GetOutsideNetworkUrl(), "WAN")'>
                            @(CopiedUrlTarget == "WAN" ? "✓ Copied!" : "Copy")
                        </button>
                    </div>
                    <div style="margin-top: 8px; font-size: 11px; display: flex; align-items: center; justify-content: space-between;">
                        <span style="color: @(NetworkDiscovery.IsUpnpMapped ? "#10b981" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "#eab308" : "#64748b"));">
                            @(NetworkDiscovery.IsUpnpMapped ? "● UPnP Port Forwarded & Ready" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "○ Port forwarding pending / manual config" : "○ UPnP Disabled"))
                        </span>
                        <button class="pill-option" style="padding: 2px 8px; font-size: 10px;" @onclick="RefreshNetworkStatus">↻ Refresh</button>
                    </div>
                </div>

                <!-- Media Players URL (VLC, Winamp, foobar2000, mpv) -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 700; color: #f59e0b; letter-spacing: 0.5px;">MEDIA PLAYERS (VLC, WINAMP, MPV)</span>
                        <span style="font-size: 11px; color: #64748b;">Direct Stream Endpoint (/@GetNormalizedMount())</span>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 6px 10px; overflow: hidden;">
                            <span style="color: #f59e0b; font-family: monospace; font-size: 12px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @(GetLocalNetworkUrl())/@(GetNormalizedMount())
                            </span>
                        </div>
                        <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 12px; white-space: nowrap; background: #f59e0b; border-color: #f59e0b;" @onclick='() => CopyUrl($"{GetLocalNetworkUrl()}/{GetNormalizedMount()}", "VLC")'>
                            @(CopiedUrlTarget == "VLC" ? "✓ Copied!" : "Copy Stream URL")
                        </button>
                    </div>
                    <div style="font-size: 11px; color: #8e95a5; margin-top: 6px;">
                        💡 In VLC: <em>Media → Open Network Stream (Ctrl+N)</em> → paste this URL.
                    </div>
                </div>
            </div>
            
            <div style="margin-top: 18px; text-align: right;">
                <button class="scrim-btn-secondary" style="padding: 6px 16px; font-size: 12px;" @onclick="@(() => ShowShareModal = false)">Close</button>
            </div>
        </div>
    </div>
}

<!-- Plugins Manager Modal -->
@if (ShowPluginsModal) {
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 999;" @onclick="@(() => ShowPluginsModal = false)">
        <div style="background: #181b22; border: 1px solid #2d323e; border-radius: 14px; padding: 24px; max-width: 680px; width: 92%; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(0,0,0,0.9);" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #2d323e; padding-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.4); border-radius: 8px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: #c084fc;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #f8fafc;">Plugins Manager</h3>
                        <p style="margin: 2px 0 0 0; font-size: 12px; color: #94a3b8;">Enable or disable installed broadcast plugins</p>
                    </div>
                </div>
                <button class="scrim-dots-btn" @onclick="@(() => ShowPluginsModal = false)">✕</button>
            </div>

            <div style="overflow-y: auto; flex: 1; padding-right: 6px; display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
                @if (PluginLoader.Plugins.Count == 0) {
                    <div style="text-align: center; padding: 40px 20px; color: #64748b;">
                        <p style="font-size: 14px;">No plugins detected.</p>
                        <p style="font-size: 12px; margin-top: 6px;">Place plugin assemblies (<code>.dll</code>) or Python plugins into <code>~/.scrim/plugins/</code>.</p>
                    </div>
                } else {
                    @foreach (var plugin in PluginLoader.Plugins) {
                        <div style="background: #12141a; border: 1px solid @(plugin.IsEnabled ? "rgba(139, 92, 246, 0.3)" : "#222630"); border-radius: 10px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 14px;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 14px; font-weight: 600; color: #f1f5f9;">@plugin.Name</span>
                                    @if (plugin.PluginType == "Python") {
                                        <span style="font-size: 10px; padding: 1px 6px; border-radius: 4px; background: rgba(59, 130, 246, 0.15); color: #60a5fa; font-weight: 700; border: 1px solid rgba(59, 130, 246, 0.3);">Python</span>
                                    }
                                    <span style="font-size: 10px; padding: 2px 6px; border-radius: 4px; background: @(plugin.IsEnabled ? "rgba(34, 197, 94, 0.15)" : "rgba(100, 116, 139, 0.2)"); color: @(plugin.IsEnabled ? "#4ade80" : "#94a3b8"); font-weight: 600;">
                                        @(plugin.IsEnabled ? "ACTIVE" : "DISABLED")
                                    </span>
                                </div>
                                <div style="font-size: 11px; color: #64748b; margin-top: 3px;">
                                    <span>v@(plugin.Version)</span>
                                    @if (!string.IsNullOrWhiteSpace(plugin.Author)) {
                                        <span> • by @plugin.Author</span>
                                    }
                                </div>
                            </div>

                            <button class="scrim-btn @(plugin.IsEnabled ? "scrim-btn-primary" : "scrim-btn-secondary")" 
                                    style="padding: 6px 14px; font-size: 12px; border-radius: 20px; font-weight: 600; min-width: 72px; text-align: center; cursor: pointer;"
                                    @onclick="@(() => TogglePlugin(plugin.Id))">
                                @(plugin.IsEnabled ? "ON" : "OFF")
                            </button>
                        </div>
                    }
                }
            </div>

            <div style="border-top: 1px solid #2d323e; padding-top: 14px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; gap: 8px;">
                    <button class="scrim-btn-secondary" style="padding: 6px 14px; font-size: 12px; display: flex; align-items: center; gap: 6px;" @onclick="OpenPluginsFolder">
                        <span>📁 Open Plugins Folder</span>
                    </button>
                    <button class="scrim-btn-secondary" style="padding: 6px 14px; font-size: 12px; display: flex; align-items: center; gap: 6px;" @onclick="ReloadPlugins">
                        <span>🔄 Rescan</span>
                    </button>
                </div>
                <button class="scrim-btn-primary" style="padding: 6px 18px; font-size: 12px;" @onclick="@(() => ShowPluginsModal = false)">Done</button>
            </div>
        </div>
    </div>
}

<!-- FFmpeg Installation Instructions Modal -->
@if (ShowFFmpegModal) {
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="@(() => ShowFFmpegModal = false)">
        <div style="background: #181b22; border: 1px solid #ef4444; border-radius: 12px; padding: 24px; max-width: 580px; width: 92%; box-shadow: 0 16px 40px rgba(0,0,0,0.9);" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <h3 style="margin: 0; font-size: 17px; color: #f87171; display: flex; align-items: center; gap: 8px;">
                    ⚠️ FFmpeg Required for Streaming
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => ShowFFmpegModal = false)">✕</button>
            </div>

            <p style="font-size: 13px; color: #cbd5e1; margin-top: 0; margin-bottom: 16px; line-height: 1.5;">
                Scrim requires <strong>FFmpeg</strong> on your computer to encode live audio into <strong>MP3, AAC, FLAC, and Opus</strong> streams for your listeners.
            </p>

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <!-- Option 1: winget (Recommended) -->
                <div style="background: #12141a; border: 1px solid rgba(0, 210, 255, 0.4); border-radius: 8px; padding: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #00d2ff; letter-spacing: 0.5px;">RECOMMENDED (FASTEST) — WINDOWS PACKAGE MANAGER</span>
                        <span style="font-size: 10px; background: rgba(0, 210, 255, 0.15); color: #00d2ff; padding: 2px 6px; border-radius: 4px;">1-Click</span>
                    </div>
                    <div style="font-size: 12px; color: #94a3b8; margin-bottom: 10px;">
                        Open PowerShell or Windows Terminal and run:
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #0c0e12; border: 1px solid #2d323e; border-radius: 6px; padding: 8px 12px; font-family: monospace; color: #38bdf8; font-size: 13px;">
                            winget install ffmpeg
                        </div>
                        <button class="scrim-btn-primary" style="padding: 8px 16px; font-size: 12px; white-space: nowrap;" @onclick="CopyWingetCommand">
                            @(CopiedWinget ? "✓ Copied!" : "Copy Command")
                        </button>
                    </div>
                    <div style="margin-top: 10px; display: flex; justify-content: flex-end;">
                        <button class="scrim-btn-secondary" style="font-size: 11px; padding: 4px 10px;" @onclick="LaunchPowerShellWinget" title="Launch a PowerShell window with the winget install command">
                            ⚡ Open PowerShell with Command
                        </button>
                    </div>
                </div>

                <!-- Option 2: Chocolatey & Scoop -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="font-size: 11px; font-weight: 700; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 6px;">
                        ALTERNATIVE PACKAGE MANAGERS
                    </div>
                    <div style="display: flex; gap: 12px; font-size: 12px; color: #cbd5e1; font-family: monospace;">
                        <span style="background: #0c0e12; padding: 4px 8px; border-radius: 4px; border: 1px solid #1f232c;">choco install ffmpeg</span>
                        <span style="background: #0c0e12; padding: 4px 8px; border-radius: 4px; border: 1px solid #1f232c;">scoop install ffmpeg</span>
                    </div>
                </div>

                <!-- Option 3: Manual Download -->
                <div style="background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 11px; font-weight: 700; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 4px;">
                                MANUAL DOWNLOAD
                            </div>
                            <div style="font-size: 11px; color: #64748b;">
                                Download FFmpeg build and extract ffmpeg.exe into your system PATH or Scrim's install folder.
                            </div>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 6px 12px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser("https://ffmpeg.org/download.html")'>
                            ffmpeg.org ↗
                        </button>
                    </div>
                </div>
            </div>

            @if (FFmpegCheckResult != null) {
                <div style="margin-top: 14px; padding: 8px 12px; border-radius: 6px; font-size: 12px; @(FFmpegCheckResult.StartsWith("✓") ? "background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid #22c55e;" : "background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid #ef4444;")">
                    @FFmpegCheckResult
                </div>
            }

            <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                <button class="scrim-btn-primary" style="background: #10b981; border-color: #10b981; padding: 8px 18px; font-size: 12px; display: flex; align-items: center; gap: 6px;" @onclick="CheckFFmpegStatus">
                    <span>🔍 Check Again</span>
                </button>
                <button class="scrim-btn-secondary" style="padding: 8px 16px; font-size: 12px;" @onclick="@(() => ShowFFmpegModal = false)">
                    Dismiss
                </button>
            </div>
        </div>
    </div>
}

<!-- Card Management Overlay Panel -->
@if (ShowAddCardMenu) {
    <div style="background: #181b22; border-bottom: 2px solid #2d323e; padding: 16px 28px; box-shadow: 0 8px 24px rgba(0,0,0,0.6); position: sticky; top: 61px; z-index: 99;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-weight: 700; font-size: 13px; color: #cbd5e1; letter-spacing: 0.5px;">CUSTOMIZE CONSOLE CARDS & LAYOUT</span>
            <div style="display: flex; gap: 8px;">
                <button class="scrim-btn-secondary" style="padding: 4px 12px; font-size: 11px; background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.45); color: #c084fc; display: flex; align-items: center; gap: 6px;" @onclick="@(() => { ShowPluginsModal = true; ShowAddCardMenu = false; })" title="Open Plugin Manager">
                    🔌 Plugin Manager
                </button>
                <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="ResetLayoutToDefault">Reset to Default</button>
                <button class="scrim-dots-btn" @onclick="@(() => ShowAddCardMenu = false)">✕</button>
            </div>
        </div>
        <!-- Core Station Console Cards -->
        <div style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 6px;">Station Console Cards</div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
            @foreach (var kvp in AllAvailableCards.Where(k => !k.Key.StartsWith("card-plugin-"))) {
                var isVisible = LeftColumn.Contains(kvp.Key) || CenterColumn.Contains(kvp.Key) || RightColumn.Contains(kvp.Key);
                if (!isVisible) {
                    <button class="pill-option" style="background: #252830; border-color: #3b4150; color: #00d2ff;" @onclick="@(() => AddCard(kvp.Key))">
                        + Add @kvp.Value
                    </button>
                }
            }
        </div>

        <!-- Plugin & Extension Cards -->
        <div style="font-size: 11px; font-weight: 700; color: #c084fc; text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
            <span>🔌 Plugin & Extension Cards</span>
            <span style="font-size: 10px; padding: 1px 6px; border-radius: 8px; background: rgba(139, 92, 246, 0.15); color: #c084fc;">Interactive Controls</span>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            @foreach (var kvp in AllAvailableCards.Where(k => k.Key.StartsWith("card-plugin-"))) {
                var isVisible = LeftColumn.Contains(kvp.Key) || CenterColumn.Contains(kvp.Key) || RightColumn.Contains(kvp.Key);
                if (!isVisible) {
                    <button class="pill-option" style="background: rgba(139, 92, 246, 0.12); border-color: rgba(139, 92, 246, 0.35); color: #c084fc; display: flex; align-items: center; gap: 6px;" @onclick="@(() => AddCard(kvp.Key))">
                        <span>+ Add @kvp.Value</span>
                    </button>
                }
            }
            @if (GetHiddenCardsCount() == 0) {
                <span style="color: #6b7280; font-size: 12px; align-self: center;">All available cards are currently displayed. Drag them to arrange or click ✕ on any card header to remove.</span>
            }
        </div>

        <!-- Column Sizing & Proportions Section -->
        <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid #282e39;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-weight: 700; font-size: 12px; color: #94a3b8; letter-spacing: 0.5px; text-transform: uppercase;">Column Proportions & Sizing</span>
                <span style="font-size: 11px; color: #64748b;">Current: @GetLayoutModeName()</span>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                <button class="pill-option @(ProfileManager.CurrentProfile.ColumnLayoutMode == "Studio" ? "active" : "")" 
                        @onclick='() => SetColumnLayoutMode("Studio")' 
                        title="Little, Big, Little (310px - 1fr - 340px) - Classic Studio Layout">
                    📻 Studio (Little-Big-Little)
                </button>
                <button class="pill-option @(ProfileManager.CurrentProfile.ColumnLayoutMode == "Equal" ? "active" : "")" 
                        @onclick='() => SetColumnLayoutMode("Equal")' 
                        title="Three evenly-sized balanced columns (1fr - 1fr - 1fr)">
                    ⚖️ Equal (1 : 1 : 1)
                </button>
