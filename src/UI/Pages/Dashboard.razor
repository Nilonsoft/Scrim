    private void ToggleUpnpPortForwarding() {
        ProfileManager.CurrentProfile.EnableUpnpPortForwarding = !ProfileManager.CurrentProfile.EnableUpnpPortForwarding;
        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        if (ProfileManager.CurrentProfile.EnableUpnpPortForwarding) {
            Task.Run(() => NetworkDiscovery.TryMapUpnpPort(ProfileManager.CurrentProfile.Port));
        } else {
            Task.Run(() => NetworkDiscovery.TryUnmapUpnpPort(ProfileManager.CurrentProfile.Port));
        }
        StateHasChanged();
    }

    private void OpenInBrowser(string url) {
        if (string.IsNullOrWhiteSpace(url)) return;
        try {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = url,
                UseShellExecute = true
            });
        } catch { }
    }

    private void RefreshNetworkStatus() {
        Task.Run(async () => {
            await NetworkDiscovery.RefreshPublicIpAsync();
            if (ProfileManager.CurrentProfile.EnableUpnpPortForwarding) {
                NetworkDiscovery.TryMapUpnpPort(ProfileManager.CurrentProfile.Port);
            }
            await InvokeAsync(StateHasChanged);
        });
    }

    private bool ShowFFmpegModal = false;
    private bool CopiedWinget = false;
    private string? FFmpegCheckResult = null;

    private async Task CopyWingetCommand() {
        try {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", "winget install ffmpeg");
            CopiedWinget = true;
            StateHasChanged();
            _ = Task.Delay(2000).ContinueWith(_ => {
                CopiedWinget = false;
                InvokeAsync(StateHasChanged);
            });
        } catch { }
    }

    private void LaunchPowerShellWinget() {
        try {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = "powershell.exe",
                Arguments = "-NoExit -Command \"Write-Host 'Installing FFmpeg for Scrim...' -ForegroundColor Cyan; winget install ffmpeg\"",
                UseShellExecute = true
            });
        } catch { }
    }

    private void CheckFFmpegStatus() {
        bool found = FFmpegService.CheckInstallation();
        if (found) {
            FFmpegCheckResult = "✓ FFmpeg successfully detected! Streaming encoders are ready.";
            StateHasChanged();
            _ = Task.Delay(1800).ContinueWith(_ => {
                InvokeAsync(() => {
                    ShowFFmpegModal = false;
                    FFmpegCheckResult = null;
                    StateHasChanged();
                });
            });
        } else {
            FFmpegCheckResult = "✕ FFmpeg still not found. If you just installed it, you may need to wait for the installer to finish.";
            StateHasChanged();
        }
    }

    private void OpenAssetsDirectory() {
        try {
            string assetsDir = System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), ".scrim", "assets");
            if (!System.IO.Directory.Exists(assetsDir)) {
                System.IO.Directory.CreateDirectory(assetsDir);
            }
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo {
                FileName = assetsDir,
                UseShellExecute = true
            });
        } catch { }
    }

