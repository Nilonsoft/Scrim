        "card-listener-inspector" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    Live Listener Connections & IP Inspector
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Stats Bar -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 10px;">
                <div style="background: #0f121a; border: 1px solid #1f2536; border-radius: 6px; padding: 6px 8px; text-align: center;">
                    <div style="font-size: 9px; color: #94a3b8;">ACTIVE NOW</div>
                    <div style="font-size: 16px; font-weight: 800; color: #00d2ff;">@Hub.ActiveClientCount</div>
                </div>
                <div style="background: #0f121a; border: 1px solid #1f2536; border-radius: 6px; padding: 6px 8px; text-align: center;">
                    <div style="font-size: 9px; color: #94a3b8;">PEAK SESSION</div>
                    <div style="font-size: 16px; font-weight: 800; color: #10b981;">@_peakListenerCount</div>
                </div>
                <div style="background: #0f121a; border: 1px solid #1f2536; border-radius: 6px; padding: 6px 8px; text-align: center;">
                    <div style="font-size: 9px; color: #94a3b8;">FORMAT</div>
                    <div style="font-size: 12px; font-weight: 800; color: #f59e0b; margin-top: 2px;">MP3 @(ProfileManager.CurrentProfile.Bitrate)k</div>
                </div>
            </div>

            <!-- Active Clients Table -->
            <div style="max-height: 180px; overflow-y: auto; border: 1px solid #1e2433; border-radius: 6px; margin-bottom: 8px;">
                @{
                    var clients = Hub.GetActiveClients();
                }
                @if (clients.Any()) {
                    <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
                        <thead>
                            <tr style="background: #141824; color: #94a3b8; border-bottom: 1px solid #1f2637; text-align: left;">
                                <th style="padding: 4px 6px;">IP / Host</th>
                                <th style="padding: 4px 6px;">Duration</th>
                                <th style="padding: 4px 6px;">Data</th>
                                <th style="padding: 4px 6px; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in clients) {
                                var dur = DateTime.UtcNow - c.ConnectedAt;
                                var mb = c.BytesTransferred / (1024.0 * 1024.0);
                                <tr style="border-bottom: 1px solid #131722;">
                                    <td style="padding: 5px 6px; color: #fff; font-family: monospace;">@c.IpAddress</td>
                                    <td style="padding: 5px 6px; color: #cbd5e1;">@($"{(int)dur.TotalMinutes}m {dur.Seconds:D2}s")</td>
                                    <td style="padding: 5px 6px; color: #00d2ff;">@(mb.ToString("F1")) MB</td>
                                    <td style="padding: 5px 6px; text-align: right;">
                                        <button class="pill-option" style="color: #ef4444; border-color: rgba(239, 68, 68, 0.3); padding: 1px 6px; font-size: 9px;"
                                                @onclick="@(() => Hub.DisconnectClient(c.ClientId))" title="Kick / Disconnect Listener">
                                            Kick
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                } else {
                    <div style="padding: 16px; text-align: center; color: #64748b; font-size: 11px;">
                        No external listeners currently connected.
                    </div>
                }
            </div>
        </div>,

        "card-silence-recovery" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Dead-Air Auto-Recovery & Alarm
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- State Alert Banner -->
            <div style="background: @(DeadAirService.IsInDeadAirState ? "rgba(239, 68, 68, 0.2)" : "rgba(16, 185, 129, 0.1)"); border: 1px solid @(DeadAirService.IsInDeadAirState ? "#ef4444" : "rgba(16, 185, 129, 0.3)"); border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 11px; font-weight: 800; color: @(DeadAirService.IsInDeadAirState ? "#ef4444" : "#10b981");">
                        @(DeadAirService.IsInDeadAirState ? "⚠️ DEAD AIR DETECTED! RECOVERY ACTIVE" : (DeadAirService.IsEnabled ? "✓ SILENCE WATCHDOG ARMED" : "STANDBY (ARM TO MONITOR)"))
                    </span>
                    <span style="font-size: 10px; color: #cbd5e1; font-family: monospace;">
                        Countdown: @(Math.Max(0, DeadAirService.SilenceThresholdSeconds - DeadAirService.CurrentSilenceDurationSeconds))s
                    </span>
                </div>
            </div>

            <!-- Metrics Bar -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;">
                <div style="background: #0f121a; border: 1px solid #1f2536; border-radius: 6px; padding: 6px 8px;">
                    <div style="font-size: 9px; color: #94a3b8;">MONITOR STATUS</div>
                    <div style="font-size: 14px; font-weight: 800; color: @(DeadAirService.IsEnabled ? "#10b981" : "#64748b");">
                        @(DeadAirService.IsEnabled ? "ENABLED" : "OFFLINE")
                    </div>
                </div>
                <div style="background: #0f121a; border: 1px solid #1f2536; border-radius: 6px; padding: 6px 8px;">
                    <div style="font-size: 9px; color: #94a3b8;">INCIDENTS RECOVERED</div>
                    <div style="font-size: 14px; font-weight: 800; color: #00d2ff;">
                        @DeadAirService.RecoveryTriggerCount
                    </div>
                </div>
            </div>

            <!-- Configuration Sliders -->
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-size: 11px; font-weight: 700; color: #cbd5e1;">Arm Silence Watchdog</span>
                    <button class="pill-option @(DeadAirService.IsEnabled ? "active" : "")" style="padding: 2px 10px; font-size: 10px;"
                            @onclick="@(() => DeadAirService.IsEnabled = !DeadAirService.IsEnabled)">
                        @(DeadAirService.IsEnabled ? "ARMED" : "DISARMED")
                    </button>
                </div>
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                        <span>Trip Timeout (Seconds of Silence)</span>
                        <span style="color: #fff; font-weight: 700;">@DeadAirService.SilenceThresholdSeconds s</span>
                    </div>
                    <input type="range" min="3" max="30" step="1" style="width: 100%; accent-color: #ef4444;"
                           value="@DeadAirService.SilenceThresholdSeconds"
                           @oninput="@((ChangeEventArgs e) => DeadAirService.SilenceThresholdSeconds = Convert.ToInt32(e.Value))" />
                </div>
            </div>

            <!-- Emergency Actions -->
            <div style="display: flex; gap: 6px;">
                <button class="scrim-btn-secondary" style="flex: 1; font-size: 10px;" @onclick="@(() => DeadAirService.ResetAlarm())">
                    Reset Watchdog
                </button>
            </div>
        </div>,

        "card-rotation-rules" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M16 12l-4-4-4 4"></path>
                        <path d="M12 16V8"></path>
                    </svg>
                    <h3 class="scrim-card-title" style="margin: 0;">Music Rotation Rules &amp; Category Bins</h3>
                </div>
