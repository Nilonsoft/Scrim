    private string GetDjSvgPath() {
        var pts = Mixer.DjEq.CalculateResponseCurve(48);
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < pts.Length; i++) {
            float x = (float)i / (pts.Length - 1) * 460f;
            float y = 35f - (pts[i] / 12f) * 25f;
            y = Math.Clamp(y, 4f, 66f);
            if (i == 0) sb.Append($"M {x:F1} {y:F1}");
            else sb.Append($" L {x:F1} {y:F1}");
        }
        return sb.ToString();
    }

    private string GetDjSvgAreaPath() {
        string linePath = GetDjSvgPath();
        return $"{linePath} L 460 70 L 0 70 Z";
    }
