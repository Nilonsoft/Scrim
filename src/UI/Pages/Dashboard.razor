    private void CopyUrl(string url, string target) {
        try {
            System.Windows.Clipboard.SetText(url);
            CopiedUrlTarget = target;
            Task.Run(async () => {
                await Task.Delay(2000);
                CopiedUrlTarget = "";
                await InvokeAsync(StateHasChanged);
            });
        } catch { }
    }

