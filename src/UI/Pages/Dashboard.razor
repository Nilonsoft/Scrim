                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px;">💾</span>
                    <h3 class="scrim-card-title" style="margin: 0;">Stream Archiver</h3>
                    <span style="font-size: 10px; padding: 1px 6px; border-radius: 6px; background: rgba(59, 130, 246, 0.15); color: #60a5fa; font-weight: 600;">Record</span>
                </div>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 12px;">
                <div style="background: #14171e; border: 1px solid @(IsLive ? "rgba(239, 68, 68, 0.4)" : "#232731"); border-radius: 6px; padding: 8px 12px; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: @(IsLive ? "#ef4444" : "#64748b"); animation: @(IsLive ? "pulse 1.5s infinite" : "none");"></span>
                        <span style="font-size: 11px; font-weight: 600; color: @(IsLive ? "#fca5a5" : "#94a3b8");">
                            @(IsLive ? "Recording Live Stream" : "Standby (Auto-records on ON AIR)")
                        </span>
                    </div>
                    <span style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase;">.@_archiverConfig.FileExtension</span>
                </div>

                <div>
                    <label style="display: block; font-size: 11px; color: #94a3b8; margin-bottom: 4px;">Recordings Output Folder</label>
                    <input class="scrim-input" style="width: 100%; font-size: 11px;" placeholder="~/.scrim/recordings/" @bind="_archiverConfig.OutputFolder" />
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                    <button class="scrim-btn-secondary" style="padding: 5px 12px; font-size: 11px;" @onclick="OpenRecordingsFolder">📁 Open Folder</button>
                    <button class="scrim-btn-primary" style="padding: 5px 14px; font-size: 11px;" @onclick="SaveArchiverConfig">Save Archiver</button>
                </div>
            </div>
        </div>,

        "card-plugin-logger" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px;">📜</span>
                    <h3 class="scrim-card-title" style="margin: 0;">Broadcast Track Logger</h3>
                    <span style="font-size: 10px; padding: 1px 6px; border-radius: 6px; background: rgba(100, 116, 139, 0.2); color: #cbd5e1; font-weight: 600;">@_broadcastTrackLog.Count logged</span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-dots-btn" @onclick="ExportTrackLogCsv" title="Export CSV History">📥</button>
                    <button class="scrim-dots-btn" @onclick="ClearTrackLog" title="Clear History">🗑️</button>
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px; max-height: 220px; overflow-y: auto;">
                @if (_broadcastTrackLog.Count == 0) {
                    <div style="text-align: center; padding: 20px 10px; color: #64748b; font-size: 11px;">
                        No tracks played yet during this session.
                    </div>
                } else {
                    @foreach (var entry in _broadcastTrackLog.Take(15)) {
                        <div style="background: #14171e; border: 1px solid #232731; border-radius: 6px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                            <div style="min-width: 0; flex: 1;">
                                <div style="font-size: 11px; font-weight: 600; color: #f1f5f9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@entry.Title</div>
                                <div style="font-size: 10px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@entry.Artist</div>
                            </div>
                            <span style="font-size: 10px; color: #94a3b8; font-family: monospace; flex-shrink: 0;">@entry.Time.ToString("HH:mm:ss")</span>
                        </div>
                    }
                }
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px;">
                <button class="scrim-btn-secondary" style="padding: 4px 12px; font-size: 11px;" @onclick="ExportTrackLogCsv">Export CSV</button>
            </div>
        </div>,

        "card-plugin-streamdeck" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px;">🕹️</span>
                    <h3 class="scrim-card-title" style="margin: 0;">Stream Deck Companion</h3>
                    <span style="font-size: 10px; padding: 1px 6px; border-radius: 6px; background: rgba(139, 92, 246, 0.15); color: #c084fc; font-weight: 600;">WS :@_streamDeckConfig.Port</span>
                </div>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 12px;">
                <div style="background: #14171e; border: 1px solid #232731; border-radius: 6px; padding: 8px 12px; display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-size: 11px; color: #94a3b8;">WebSocket Server</span>
                    <span style="font-size: 11px; font-family: monospace; color: #c084fc;">ws://127.0.0.1:@_streamDeckConfig.Port</span>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                    <button class="scrim-btn-secondary" style="padding: 6px; font-size: 11px;" @onclick="ToggleBroadcast">Test On-Air Key</button>
                    <button class="scrim-btn-secondary" style="padding: 6px; font-size: 11px;" @onclick="ToggleMicState">Test Mic Mute Key</button>
                </div>
                <div style="display: flex; justify-content: flex-end; margin-top: 4px;">
                    <button class="scrim-btn-primary" style="padding: 5px 14px; font-size: 11px;" @onclick="SaveStreamDeckConfig">Save Companion</button>
                </div>
            </div>
        </div>,

        "card-dj-eq" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 14px;">🎚️</span>
                    <h3 class="scrim-card-title" style="margin: 0;">Pro DJ Mixer & EQ</h3>
                    <span style="font-size: 10px; padding: 1px 6px; border-radius: 6px; background: rgba(0, 210, 255, 0.15); color: #00d2ff; font-weight: 700;">
                        @(Mixer.DjEq.Is10BandMode ? "10-BAND GRAPHIC" : "3-BAND ISOLATOR")
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="pill-option @(Mixer.DjEq.Is10BandMode ? "" : "active")" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => SetDjEqMode(false))">3-Band</button>
                    <button class="pill-option @(Mixer.DjEq.Is10BandMode ? "active" : "")" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => SetDjEqMode(true))">10-Band</button>
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <!-- Top Preset & Global Bypass Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 6px; flex: 1;">
                    <span style="font-size: 11px; color: #94a3b8; white-space: nowrap;">Preset:</span>
                    <select class="scrim-select" style="padding: 3px 8px; font-size: 11px; height: 28px; flex: 1;"
                            value="@ProfileManager.CurrentProfile.DjEq.ActivePreset"
                            @onchange="@((ChangeEventArgs e) => SetDjEqPreset(e.Value?.ToString() ?? "Flat / Bypass"))">
                        @foreach (var pName in DjEqPresets.Keys) {
                            <option value="@pName">@pName</option>
                        }
                    </select>
                </div>
                <div style="display: flex; gap: 6px;">
                    <button class="scrim-btn @(Mixer.DjEq.EqBypass ? "scrim-btn-secondary" : "scrim-btn-primary")"
                            style="padding: 3px 10px; font-size: 10px; font-weight: 700;"
                            @onclick="ToggleDjEqBypass"
                            title="Toggle Equalizer Processing On / Off">
                        @(Mixer.DjEq.EqBypass ? "EQ BYPASS" : "EQ ON")
                    </button>
                    <button class="scrim-btn @(Mixer.DjEq.SoftLimiterEnabled ? "scrim-btn-primary" : "scrim-btn-secondary")"
                            style="padding: 3px 10px; font-size: 10px; font-weight: 700; background: @(Mixer.DjEq.SoftLimiterEnabled ? "rgba(16, 185, 129, 0.2)" : ""); border-color: @(Mixer.DjEq.SoftLimiterEnabled ? "#10b981" : ""); color: @(Mixer.DjEq.SoftLimiterEnabled ? "#34d399" : "");"
                            @onclick="ToggleDjSoftLimiter"
                            title="Toggle Analog Saturation Soft-Limiter to prevent digital clipping">
                        @(Mixer.DjEq.SoftLimiterEnabled ? "LIMITER ON" : "LIMITER OFF")
                    </button>
                </div>
            </div>

            <!-- Real-Time Frequency Response Curve SVG -->
            <div style="background: #0d1017; border: 1px solid #1e2430; border-radius: 8px; padding: 6px 8px; margin-bottom: 12px; position: relative;">
                <svg viewBox="0 0 460 70" style="width: 100%; height: 60px; display: block; overflow: visible;">
                    <defs>
                        <linearGradient id="djEqAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#00d2ff" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.02" />
                        </linearGradient>
                        <linearGradient id="djEqLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#38bdf8" />
                            <stop offset="50%" stop-color="#00d2ff" />
                            <stop offset="100%" stop-color="#a855f7" />
                        </linearGradient>
                    </defs>
                    <!-- Grid Lines: +12dB (y=10), 0dB (y=35), -12dB (y=60) -->
                    <line x1="0" y1="10" x2="460" y2="10" stroke="rgba(255,255,255,0.06)" stroke-dasharray="3,3" />
                    <line x1="0" y1="35" x2="460" y2="35" stroke="rgba(255,255,255,0.18)" />
                    <line x1="0" y1="60" x2="460" y2="60" stroke="rgba(255,255,255,0.06)" stroke-dasharray="3,3" />
                    <!-- Filled Area & Curve Line -->
                    <path d="@GetDjSvgAreaPath()" fill="url(#djEqAreaGrad)" />
                    <path d="@GetDjSvgPath()" fill="none" stroke="url(#djEqLineGrad)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div style="display: flex; justify-content: space-between; font-size: 9px; color: #64748b; margin-top: 2px; padding: 0 4px;">
                    <span>31Hz</span>
                    <span>125Hz</span>
                    <span>500Hz</span>
                    <span>2kHz</span>
                    <span>8kHz</span>
                    <span>16kHz</span>
                </div>
            </div>

            <!-- Channels Section: Music Deck vs Microphone Talkover -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                <!-- Music Deck Channel Strip -->
                <div style="background: #141720; border: 1px solid #242a38; border-radius: 8px; padding: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #38bdf8; display: flex; align-items: center; gap: 4px;">
                            🎵 MUSIC DECK
                        </span>
                        <div style="display: flex; gap: 4px;">
                            <button class="scrim-btn @(Mixer.DjEq.MusicMuted ? "scrim-btn-danger" : "scrim-btn-secondary")"
                                    style="padding: 2px 6px; font-size: 9px; font-weight: 700;"
                                    @onclick="ToggleDjMusicMute">
                                @(Mixer.DjEq.MusicMuted ? "MUTED" : "MUTE")
                            </button>
                        </div>
                    </div>

                    <!-- Channel Trim -->
                    <div style="margin-bottom: 6px;">
                        <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Trim / Gain</span>
                            <span style="color: #cbd5e1; font-family: monospace;">@(Mixer.DjEq.MusicTrimDb >= 0 ? "+" : "")@Mixer.DjEq.MusicTrimDb.ToString("F1") dB</span>
                        </div>
                        <input type="range" min="-12" max="12" step="0.5" style="width: 100%; accent-color: #38bdf8;"
                               value="@Mixer.DjEq.MusicTrimDb"
                               @oninput="@((ChangeEventArgs e) => OnMusicTrimChanged(Convert.ToSingle(e.Value)))" />
                    </div>

                    <!-- Stereo Pan -->
                    <div style="margin-bottom: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Pan L/R</span>
                            <div style="display: flex; align-items: center; gap: 4px;">
                                <span style="color: #cbd5e1; font-family: monospace;">@(Mixer.DjEq.MusicPan == 0 ? "CENTER" : (Mixer.DjEq.MusicPan < 0 ? $"L {Math.Abs(Mixer.DjEq.MusicPan * 100):F0}%" : $"R {Mixer.DjEq.MusicPan * 100:F0}%"))</span>
                                <button class="pill-option" style="padding: 1px 4px; font-size: 9px;" @onclick="ResetDjPan">C</button>
                            </div>
                        </div>
                        <input type="range" min="-1" max="1" step="0.05" style="width: 100%; accent-color: #38bdf8;"
                               value="@Mixer.DjEq.MusicPan"
                               @oninput="@((ChangeEventArgs e) => OnMusicPanChanged(Convert.ToSingle(e.Value)))" />
                    </div>

                    <!-- Stereo Width (Mid-Side Expander) -->
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Stereo Width</span>
                            <div style="display: flex; align-items: center; gap: 4px;">
                                <span style="font-size: 9px; padding: 1px 5px; border-radius: 4px; background: @(Mixer.DjEq.MusicStereoWidth < 0.2f ? "rgba(239, 68, 68, 0.15); color: #ef4444;" : (Mixer.DjEq.MusicStereoWidth > 1.2f ? "rgba(168, 85, 247, 0.15); color: #c084fc;" : "rgba(34, 197, 94, 0.15); color: #4ade80;")) font-weight: 700;">
                                    @(Mixer.DjEq.MusicStereoWidth < 0.2f ? "MONO" : (Mixer.DjEq.MusicStereoWidth > 1.2f ? "WIDE" : "STEREO"))
                                </span>
                                <button class="pill-option" style="padding: 1px 4px; font-size: 9px;" @onclick="ResetDjStereoWidth">1x</button>
                            </div>
                        </div>
                        <input type="range" min="0" max="2" step="0.05" style="width: 100%; accent-color: #00d2ff;"
                               value="@Mixer.DjEq.MusicStereoWidth"
                               @oninput="@((ChangeEventArgs e) => OnMusicWidthChanged(Convert.ToSingle(e.Value)))" />
                    </div>
                </div>

                <!-- Mic Talkover Channel Strip -->
                <div style="background: #141720; border: 1px solid #242a38; border-radius: 8px; padding: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #818cf8; display: flex; align-items: center; gap: 4px;">
                            🎙️ MIC TALKOVER
                        </span>
                        <button class="scrim-btn @(Mixer.DjEq.MicLowCut ? "scrim-btn-primary" : "scrim-btn-secondary")"
                                style="padding: 2px 6px; font-size: 9px; font-weight: 700; background: @(Mixer.DjEq.MicLowCut ? "rgba(99, 102, 241, 0.2)" : ""); border-color: @(Mixer.DjEq.MicLowCut ? "#6366f1" : ""); color: @(Mixer.DjEq.MicLowCut ? "#818cf8" : "");"
                                @onclick="ToggleDjMicLowCut"
                                title="80Hz High-Pass Rumble Filter removes desk bumps and vocal plosives">
                            @(Mixer.DjEq.MicLowCut ? "80Hz CUT ON" : "80Hz OFF")
                        </button>
                    </div>

                    <!-- Mic Gain -->
                    <div style="margin-bottom: 6px;">
                        <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Mic Gain</span>
                            <span style="color: #cbd5e1; font-family: monospace;">@(Mixer.DjEq.MicGainDb >= 0 ? "+" : "")@Mixer.DjEq.MicGainDb.ToString("F1") dB</span>
                        </div>
                        <input type="range" min="-12" max="12" step="0.5" style="width: 100%; accent-color: #818cf8;"
                               value="@Mixer.DjEq.MicGainDb"
                               @oninput="@((ChangeEventArgs e) => OnMicGainChanged(Convert.ToSingle(e.Value)))" />
                    </div>

                    <!-- Mic Pan -->
                    <div style="margin-bottom: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Mic Pan</span>
                            <span style="color: #cbd5e1; font-family: monospace;">@(Mixer.DjEq.MicPan == 0 ? "CENTER" : (Mixer.DjEq.MicPan < 0 ? $"L {Math.Abs(Mixer.DjEq.MicPan * 100):F0}%" : $"R {Mixer.DjEq.MicPan * 100:F0}%"))</span>
                        </div>
                        <input type="range" min="-1" max="1" step="0.05" style="width: 100%; accent-color: #818cf8;"
                               value="@Mixer.DjEq.MicPan"
                               @oninput="@((ChangeEventArgs e) => OnMicPanChanged(Convert.ToSingle(e.Value)))" />
                    </div>

                    <!-- Mic Quick Action -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.05);">
                        <span style="font-size: 10px; color: #64748b;">Live Talk State:</span>
                        <span style="font-size: 10px; font-weight: 700; color: @(Mixer.IsMicLive ? "#4ade80" : "#94a3b8");">
                            @(Mixer.IsMicLive ? "● TALKING (ON)" : "○ MUTED")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Equalizer Section -->
            @if (!Mixer.DjEq.Is10BandMode) {
                <!-- 3-Band DJ Isolator with Kill Buttons & Color Filter -->
                <div style="background: #11141c; border: 1px solid #1f2533; border-radius: 8px; padding: 12px; margin-bottom: 12px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                        <!-- High Fader -->
                        <div style="text-align: center;">
                            <div style="font-size: 11px; font-weight: 700; color: #38bdf8; margin-bottom: 2px;">HIGH</div>
                            <div style="font-size: 9px; color: #64748b; margin-bottom: 4px;">2.5kHz - 20kHz</div>
                            <input type="range" min="-26" max="6" step="0.5" style="width: 100%; accent-color: #38bdf8;"
                                   value="@Mixer.DjEq.HighGainDb"
                                   @oninput="@((ChangeEventArgs e) => OnHighGainChanged(Convert.ToSingle(e.Value)))" />
                            <div style="font-size: 11px; font-family: monospace; color: #cbd5e1; margin: 4px 0 6px 0;">
                                @(Mixer.DjEq.HighKill ? "-inf dB" : $"{(Mixer.DjEq.HighGainDb >= 0 ? "+" : "")}{Mixer.DjEq.HighGainDb:F1} dB")
                            </div>
                            <button class="scrim-btn @(Mixer.DjEq.HighKill ? "scrim-btn-danger" : "scrim-btn-secondary")"
                                    style="width: 100%; padding: 4px 0; font-size: 10px; font-weight: 700; border-radius: 4px; box-shadow: @(Mixer.DjEq.HighKill ? "0 0 10px rgba(239, 68, 68, 0.4)" : "none");"
                                    @onclick="ToggleDjHighKill">
                                @(Mixer.DjEq.HighKill ? "KILL ACTIVE" : "HIGH KILL")
                            </button>
                        </div>

                        <!-- Mid Fader -->
                        <div style="text-align: center;">
                            <div style="font-size: 11px; font-weight: 700; color: #818cf8; margin-bottom: 2px;">MID</div>
                            <div style="font-size: 9px; color: #64748b; margin-bottom: 4px;">300Hz - 2.5kHz</div>
                            <input type="range" min="-26" max="6" step="0.5" style="width: 100%; accent-color: #818cf8;"
                                   value="@Mixer.DjEq.MidGainDb"
                                   @oninput="@((ChangeEventArgs e) => OnMidGainChanged(Convert.ToSingle(e.Value)))" />
                            <div style="font-size: 11px; font-family: monospace; color: #cbd5e1; margin: 4px 0 6px 0;">
                                @(Mixer.DjEq.MidKill ? "-inf dB" : $"{(Mixer.DjEq.MidGainDb >= 0 ? "+" : "")}{Mixer.DjEq.MidGainDb:F1} dB")
                            </div>
                            <button class="scrim-btn @(Mixer.DjEq.MidKill ? "scrim-btn-danger" : "scrim-btn-secondary")"
                                    style="width: 100%; padding: 4px 0; font-size: 10px; font-weight: 700; border-radius: 4px; box-shadow: @(Mixer.DjEq.MidKill ? "0 0 10px rgba(239, 68, 68, 0.4)" : "none");"
                                    @onclick="ToggleDjMidKill">
                                @(Mixer.DjEq.MidKill ? "KILL ACTIVE" : "MID KILL")
                            </button>
                        </div>

                        <!-- Low Fader -->
                        <div style="text-align: center;">
                            <div style="font-size: 11px; font-weight: 700; color: #f43f5e; margin-bottom: 2px;">LOW</div>
                            <div style="font-size: 9px; color: #64748b; margin-bottom: 4px;">20Hz - 300Hz</div>
                            <input type="range" min="-26" max="6" step="0.5" style="width: 100%; accent-color: #f43f5e;"
                                   value="@Mixer.DjEq.LowGainDb"
                                   @oninput="@((ChangeEventArgs e) => OnLowGainChanged(Convert.ToSingle(e.Value)))" />
                            <div style="font-size: 11px; font-family: monospace; color: #cbd5e1; margin: 4px 0 6px 0;">
                                @(Mixer.DjEq.LowKill ? "-inf dB" : $"{(Mixer.DjEq.LowGainDb >= 0 ? "+" : "")}{Mixer.DjEq.LowGainDb:F1} dB")
                            </div>
                            <button class="scrim-btn @(Mixer.DjEq.LowKill ? "scrim-btn-danger" : "scrim-btn-secondary")"
                                    style="width: 100%; padding: 4px 0; font-size: 10px; font-weight: 700; border-radius: 4px; box-shadow: @(Mixer.DjEq.LowKill ? "0 0 10px rgba(239, 68, 68, 0.4)" : "none");"
                                    @onclick="ToggleDjLowKill">
                                @(Mixer.DjEq.LowKill ? "KILL ACTIVE" : "LOW KILL")
                            </button>
                        </div>
                    </div>

                    <!-- DJ Sound Color Sweep Filter (LPF <-> OFF <-> HPF) -->
                    <div style="background: #0d0f15; border: 1px solid #1a1e28; border-radius: 6px; padding: 8px 10px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                            <span style="font-size: 10px; font-weight: 700; color: #f59e0b; letter-spacing: 0.5px;">DJ SOUND COLOR FILTER</span>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span style="font-size: 10px; color: @(Mixer.DjEq.ColorFilterKnob < -1 ? "#38bdf8" : (Mixer.DjEq.ColorFilterKnob > 1 ? "#f43f5e" : "#64748b")); font-weight: 700;">
                                    @(Mixer.DjEq.ColorFilterKnob < -1 ? $"LPF ({Mixer.DjEq.ColorFilterKnob:F0}%)" : (Mixer.DjEq.ColorFilterKnob > 1 ? $"HPF (+{Mixer.DjEq.ColorFilterKnob:F0}%)" : "BYPASS"))
                                </span>
                                <button class="pill-option" style="padding: 1px 6px; font-size: 9px;" @onclick="ResetDjColorFilter">Reset</button>
                            </div>
                        </div>
                        <input type="range" min="-100" max="100" step="2" style="width: 100%; accent-color: #f59e0b;"
                               value="@Mixer.DjEq.ColorFilterKnob"
                               @oninput="@((ChangeEventArgs e) => OnColorFilterChanged(Convert.ToSingle(e.Value)))" />
                        <div style="display: flex; justify-content: space-between; font-size: 9px; color: #64748b; margin-top: 2px;">
                            <span>◄ LPF (Cut Highs)</span>
                            <span>CENTER (Bypass)</span>
                            <span>HPF (Cut Lows) ►</span>
                        </div>
                    </div>
                </div>
            } else {
                <!-- 10-Band ISO Graphic Equalizer -->
                <div style="background: #11141c; border: 1px solid #1f2533; border-radius: 8px; padding: 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #cbd5e1;">10-BAND ISO GRAPHIC EQ</span>
                        <button class="pill-option" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => SetDjEqPreset("Flat / Bypass"))">Reset Flat</button>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px;">
                        @for (int b = 0; b < 10; b++) {
                            int bandIdx = b;
                            float gain = Mixer.DjEq.Bands10Db[bandIdx];
                            string label = bandIdx switch {
                                0 => "31", 1 => "63", 2 => "125", 3 => "250", 4 => "500",
                                5 => "1k", 6 => "2k", 7 => "4k", 8 => "8k", _ => "16k"
                            };
                            <div style="display: flex; flex-direction: column; align-items: center;">
                                <span style="font-size: 9px; color: #94a3b8; font-family: monospace; height: 14px;">@(gain >= 0 ? "+" : "")@gain.ToString("F0")</span>
                                <input type="range" min="-12" max="12" step="0.5"
                                       style="writing-mode: vertical-lr; direction: rtl; height: 80px; width: 100%; margin: 4px 0; accent-color: #00d2ff;"
                                       value="@gain"
                                       @oninput="@((ChangeEventArgs e) => OnBand10Changed(bandIdx, Convert.ToSingle(e.Value)))" />
                                <span style="font-size: 9px; font-weight: 600; color: #64748b;">@label</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Master Bus Strip -->
            <div style="background: #141720; border: 1px solid #242a38; border-radius: 8px; padding: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: #cbd5e1; display: flex; align-items: center; gap: 4px;">
                        🔊 MASTER OUTPUT BUS
                    </span>
                    <span style="font-size: 10px; color: #94a3b8; font-family: monospace;">
                        @(Mixer.DjEq.MasterGainDb >= 0 ? "+" : "")@Mixer.DjEq.MasterGainDb.ToString("F1") dB
                    </span>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 10px;">
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Master Gain</span>
                        </div>
                        <input type="range" min="-12" max="6" step="0.5" style="width: 100%; accent-color: #00d2ff;"
                               value="@Mixer.DjEq.MasterGainDb"
                               @oninput="@((ChangeEventArgs e) => OnMasterGainChanged(Convert.ToSingle(e.Value)))" />
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 2px;">
                            <span>Balance</span>
                            <button class="pill-option" style="padding: 1px 4px; font-size: 9px;" @onclick="ResetDjMasterBalance">C</button>
                        </div>
                        <input type="range" min="-1" max="1" step="0.05" style="width: 100%; accent-color: #00d2ff;"
                               value="@Mixer.DjEq.MasterBalance"
                               @oninput="@((ChangeEventArgs e) => OnMasterBalanceChanged(Convert.ToSingle(e.Value)))" />
                    </div>
                </div>
            </div>
        </div>,

        "card-dual-deck" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    Dual Decks & Crossfader
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Side-by-Side Decks A & B -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;">
                <!-- Deck A -->
                <div style="background: #0e1118; border: 1px solid rgba(0, 210, 255, 0.35); border-radius: 8px; padding: 10px; position: relative;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 800; color: #00d2ff; letter-spacing: 0.5px;">DECK A</span>
                        <span style="font-size: 9px; font-weight: 700; padding: 1px 6px; border-radius: 4px; background: @(DualDeck.DeckA.IsPlaying ? "rgba(0, 210, 255, 0.2)" : "#1c212c"); color: @(DualDeck.DeckA.IsPlaying ? "#00d2ff" : "#94a3b8");">
                            @(DualDeck.DeckA.IsPlaying ? "PLAYING" : (DualDeck.DeckA.IsCueSet ? "CUED" : "STOPPED"))
                        </span>
                    </div>
                    <div style="font-size: 12px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@DualDeck.DeckA.Title</div>
                    <div style="font-size: 10px; color: #94a3b8; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@DualDeck.DeckA.Artist</div>

                    <!-- Deck A Controls -->
                    <div style="display: flex; gap: 4px; margin-bottom: 8px;">
                        <button class="pill-option" style="flex: 1; padding: 3px 0; font-size: 10px; font-weight: 700; background: @(DualDeck.DeckA.IsPlaying ? "#00d2ff" : "#1e2533"); color: @(DualDeck.DeckA.IsPlaying ? "#000" : "#fff");"
                                @onclick="@(() => DualDeck.TogglePlay("A"))">
                            @(DualDeck.DeckA.IsPlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="pill-option" style="padding: 3px 6px; font-size: 10px;" @onclick="@(() => DualDeck.SetCue("A"))">CUE</button>
                        <button class="pill-option" style="padding: 3px 6px; font-size: 10px;" @onclick="@(() => DualDeck.Stop("A"))">■</button>
                    </div>

                    <!-- Pitch Control -->
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: #94a3b8; margin-bottom: 2px;">
                        <span>Pitch / Tempo: <strong style="color: #00d2ff;">@(DualDeck.DeckA.PitchPercent >= 0 ? "+" : "")@DualDeck.DeckA.PitchPercent.ToString("F1")%</strong></span>
                        <button class="pill-option" style="padding: 1px 4px; font-size: 8px;" @onclick="@(() => DualDeck.DeckA.PitchPercent = 0f)">0%</button>
                    </div>
                    <input type="range" min="-8" max="8" step="0.1" style="width: 100%; accent-color: #00d2ff; height: 4px;"
                           value="@DualDeck.DeckA.PitchPercent"
                           @oninput="@((ChangeEventArgs e) => DualDeck.DeckA.PitchPercent = Convert.ToSingle(e.Value))" />
                </div>

                <!-- Deck B -->
                <div style="background: #0e1118; border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 8px; padding: 10px; position: relative;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <span style="font-size: 11px; font-weight: 800; color: #10b981; letter-spacing: 0.5px;">DECK B</span>
                        <span style="font-size: 9px; font-weight: 700; padding: 1px 6px; border-radius: 4px; background: @(DualDeck.DeckB.IsPlaying ? "rgba(16, 185, 129, 0.2)" : "#1c212c"); color: @(DualDeck.DeckB.IsPlaying ? "#10b981" : "#94a3b8");">
                            @(DualDeck.DeckB.IsPlaying ? "PLAYING" : (DualDeck.DeckB.IsCueSet ? "CUED" : "STOPPED"))
                        </span>
                    </div>
                    <div style="font-size: 12px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@DualDeck.DeckB.Title</div>
                    <div style="font-size: 10px; color: #94a3b8; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@DualDeck.DeckB.Artist</div>

                    <!-- Deck B Controls -->
                    <div style="display: flex; gap: 4px; margin-bottom: 8px;">
                        <button class="pill-option" style="flex: 1; padding: 3px 0; font-size: 10px; font-weight: 700; background: @(DualDeck.DeckB.IsPlaying ? "#10b981" : "#1e2533"); color: @(DualDeck.DeckB.IsPlaying ? "#000" : "#fff");"
                                @onclick="@(() => DualDeck.TogglePlay("B"))">
                            @(DualDeck.DeckB.IsPlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="pill-option" style="padding: 3px 6px; font-size: 10px;" @onclick="@(() => DualDeck.SetCue("B"))">CUE</button>
                        <button class="pill-option" style="padding: 3px 6px; font-size: 10px;" @onclick="@(() => DualDeck.Stop("B"))">■</button>
                    </div>

                    <!-- Pitch Control -->
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: #94a3b8; margin-bottom: 2px;">
                        <span>Pitch / Tempo: <strong style="color: #10b981;">@(DualDeck.DeckB.PitchPercent >= 0 ? "+" : "")@DualDeck.DeckB.PitchPercent.ToString("F1")%</strong></span>
                        <button class="pill-option" style="padding: 1px 4px; font-size: 8px;" @onclick="@(() => DualDeck.DeckB.PitchPercent = 0f)">0%</button>
                    </div>
                    <input type="range" min="-8" max="8" step="0.1" style="width: 100%; accent-color: #10b981; height: 4px;"
                           value="@DualDeck.DeckB.PitchPercent"
                           @oninput="@((ChangeEventArgs e) => DualDeck.DeckB.PitchPercent = Convert.ToSingle(e.Value))" />
                </div>
            </div>

            <!-- Professional Crossfader Strip -->
            <div style="background: #0a0c10; border: 1px solid #1a1e28; border-radius: 8px; padding: 10px; margin-bottom: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 10px; font-weight: 700; color: #00d2ff;">DECK A (@((DualDeck.GetCrossfaderGains().GainA * 100).ToString("F0"))%)</span>
                    <span style="font-size: 9px; color: #64748b;">CROSSFADER [@DualDeck.CrossfaderPosition.ToString("F2")]</span>
                    <span style="font-size: 10px; font-weight: 700; color: #10b981;">DECK B (@((DualDeck.GetCrossfaderGains().GainB * 100).ToString("F0"))%)</span>
                </div>
                <input type="range" min="-1" max="1" step="0.01" style="width: 100%; accent-color: #f59e0b; height: 6px;"
                       value="@DualDeck.CrossfaderPosition"
                       @oninput="@((ChangeEventArgs e) => DualDeck.CrossfaderPosition = Convert.ToSingle(e.Value))" />
                
                <!-- Crossfade Curve Selector & Auto Crossfade -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                    <div style="display: flex; gap: 4px;">
                        @foreach (var curve in Enum.GetValues<CrossfadeCurve>()) {
                            <button class="pill-option @(DualDeck.Curve == curve ? "active" : "")" style="padding: 2px 6px; font-size: 9px;"
                                    @onclick="@(() => DualDeck.Curve = curve)">
                                @curve
                            </button>
                        }
                    </div>
                    <div style="display: flex; gap: 4px;">
                        <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => _ = DualDeck.TriggerAutoCrossfadeAsync(4))">
                            ⚡ 1-Click Auto-DJ Crossfade
                        </button>
                    </div>
                </div>
            </div>
        </div>,

        "card-event-scheduler" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Automated Show Clock & Scheduler
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Top Status Row -->
            <div style="display: flex; justify-content: space-between; align-items: center; background: #11141c; border: 1px solid #1f2533; border-radius: 8px; padding: 8px 10px; margin-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: @(SchedulerService.Events.Any(e => e.IsEnabled) ? "#10b981" : "#64748b"); display: inline-block;"></span>
                    <span style="font-size: 11px; font-weight: 700; color: #cbd5e1;">@(SchedulerService.Events.Any(e => e.IsEnabled) ? "SCHEDULER ENGINE ARMED" : "SCHEDULER STANDBY")</span>
                </div>
                @{
                    var upcoming = SchedulerService.GetNextUpcomingEvent();
                    string nextText = upcoming.Event != null ? $"{(int)upcoming.TimeRemaining.TotalMinutes}m {upcoming.TimeRemaining.Seconds:D2}s" : "--:--";
                }
                <div style="font-size: 11px; color: #00d2ff; font-family: monospace; font-weight: 700;">
                    Next: @nextText
                </div>
            </div>

            <!-- Scheduled Events Table -->
            <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; max-height: 180px; overflow-y: auto;">
                @if (SchedulerService.Events.Any()) {
                    @foreach (var ev in SchedulerService.Events) {
                        <div style="background: #0f121a; border: 1px solid #1e2433; border-radius: 6px; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 11px; font-weight: 700; color: #fff;">@ev.Name</span>
                                    <span style="font-size: 9px; padding: 1px 4px; border-radius: 3px; background: rgba(0, 210, 255, 0.15); color: #00d2ff;">@ev.ActionType</span>
                                </div>
                                <div style="font-size: 10px; color: #94a3b8;">
                                    @(ev.TriggerType == EventTriggerType.Hourly ? $"Hourly at :{ev.Minute:D2}" : (ev.TriggerType == EventTriggerType.Daily ? $"Daily at {ev.Hour:D2}:{ev.Minute:D2}" : $"Every {ev.IntervalMinutes}m"))
                                    • Next: @ev.CalculateNextExecution(DateTime.Now).ToString("HH:mm:ss")
                                </div>
                            </div>
                            <div style="display: flex; gap: 4px;">
                                <button class="pill-option" style="padding: 2px 6px; font-size: 9px;" @onclick="@(() => TriggerScheduledEventNow(ev.Id))" title="Trigger immediately">⚡ Fire</button>
                                <button class="pill-option" style="padding: 2px 6px; font-size: 9px; color: #ef4444;" @onclick="@(() => SchedulerService.RemoveEvent(ev.Id))" title="Delete">✕</button>
                            </div>
                        </div>
                    }
                } else {
                    <div style="font-size: 11px; color: #64748b; text-align: center; padding: 12px;">No automated events scheduled. Add one below.</div>
                }
            </div>

            <!-- Add Event Form -->
            <div style="background: #090c12; border: 1px solid #161b26; border-radius: 8px; padding: 8px 10px;">
                <div style="display: flex; gap: 6px; margin-bottom: 6px;">
                    <input type="text" class="scrim-input" style="flex: 2; font-size: 11px;" placeholder="Event Name" @bind="_newSchedulerName" />
                    <select class="scrim-select" style="flex: 1; font-size: 11px;" @bind="_newSchedulerAction">
                        <option value="PlayJingle">Play Jingle</option>
                        <option value="PostChatMessage">Chat Post</option>
                        <option value="SwitchTheme">Switch Theme</option>
                        <option value="TriggerPoll">Launch Poll</option>
                    </select>
                </div>
                <div style="display: flex; gap: 6px; margin-bottom: 6px;">
                    <select class="scrim-select" style="flex: 1; font-size: 11px;" @bind="_newSchedulerType">
                        <option value="Hourly">Hourly Sweep</option>
                        <option value="Daily">Daily Show Clock</option>
                        <option value="Interval">Minute Interval</option>
                    </select>
                    <input type="text" class="scrim-input" style="flex: 2; font-size: 11px;" placeholder="Payload (e.g. jingle name / message)" @bind="_newSchedulerPayload" />
                    <button class="scrim-btn-primary" style="padding: 0 10px; font-size: 11px;" @onclick="AddScheduledEventUI">+ Add</button>
                </div>
            </div>
        </div>,

        "card-voice-tracking" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    </svg>
                    Voice-Tracking Transition Recorder
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                <div style="font-size: 11px; font-weight: 700; color: #10b981; margin-bottom: 4px;">VOICE-TRACK STUDIO RAMP</div>
                <div style="font-size: 10px; color: #94a3b8; line-height: 1.4;">
                    Record DJ announcements, song intros, and sweeps directly over the music bed with automated ducking before it airs live.
                </div>
            </div>

            <!-- Transition Visualizer Map -->
            <div style="background: #0a0d14; border: 1px solid #1a202c; border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                <div style="display: flex; justify-content: space-between; font-size: 10px; color: #64748b; margin-bottom: 4px;">
                    <span>Outro Fade: @CurrentTrackTitle</span>
                    <span style="color: #f59e0b; font-weight: 700;">[DJ VOICE OVERLAY]</span>
                    <span>Intro: Next Track</span>
                </div>
                <div style="height: 24px; background: #141924; border-radius: 4px; display: flex; overflow: hidden; align-items: center; padding: 0 4px; position: relative;">
                    <div style="width: 35%; height: 100%; background: linear-gradient(90deg, rgba(0, 210, 255, 0.4), rgba(0, 210, 255, 0.1)); border-right: 1px dashed #00d2ff;"></div>
                    <div style="width: 30%; height: 100%; background: rgba(245, 158, 11, 0.3); border-left: 1px solid #f59e0b; border-right: 1px solid #f59e0b; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 9px; font-weight: 700; color: #f59e0b;">MIC CLIP</span>
                    </div>
                    <div style="width: 35%; height: 100%; background: linear-gradient(90deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.4)); border-left: 1px dashed #10b981;"></div>
                </div>
            </div>

            <!-- Voice-Track Controls -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;">
                <div>
                    <span style="font-size: 10px; color: #94a3b8;">Ducking Level: <strong style="color: #fff;">@_voiceTrackDuckingDb dB</strong></span>
                    <input type="range" min="-24" max="-6" step="1" style="width: 100%; accent-color: #10b981;"
                           value="@_voiceTrackDuckingDb"
                           @oninput="@((ChangeEventArgs e) => _voiceTrackDuckingDb = Convert.ToInt32(e.Value))" />
                </div>
                <div>
                    <span style="font-size: 10px; color: #94a3b8;">Cross-Ramp: <strong style="color: #fff;">@_voiceTrackRampSec s</strong></span>
                    <input type="range" min="0.5" max="4.0" step="0.5" style="width: 100%; accent-color: #10b981;"
                           value="@_voiceTrackRampSec"
                           @oninput="@((ChangeEventArgs e) => _voiceTrackRampSec = Convert.ToDouble(e.Value))" />
                </div>
            </div>

            <div style="display: flex; gap: 6px;">
                <button class="scrim-btn-primary" style="flex: 1; font-size: 11px; background: @(_isRecordingVoiceTrack ? "#ef4444" : "var(--accent-blue, #00d2ff)");"
                        @onclick="ToggleVoiceTrackRecording">
                    @(_isRecordingVoiceTrack ? "■ Stop Recording (" + _voiceTrackLengthSec + "s)" : "● Record Voice Track")
                </button>
                <button class="scrim-btn-secondary" style="font-size: 11px; padding: 0 10px;" @onclick="AuditionVoiceTrack" disabled="@(!_hasRecordedVoiceTrack)">
