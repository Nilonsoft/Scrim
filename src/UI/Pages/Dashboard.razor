        "card-polls" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    DJ Live Polls & Track Battles
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            @if (StreamServer.CurrentPoll != null) {
                <div style="background: rgba(0, 210, 255, 0.08); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 8px; padding: 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 10px; font-weight: 800; color: var(--accent-blue, #00d2ff); background: rgba(0, 210, 255, 0.2); padding: 2px 6px; border-radius: 4px;">ACTIVE POLL</span>
                        <span style="font-size: 11px; color: var(--text-muted, #94a3b8);">@StreamServer.CurrentPoll.TotalVotes total votes</span>
                    </div>
                    <div style="font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 10px;">@StreamServer.CurrentPoll.Question</div>
                    <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px;">
                        @foreach (var opt in StreamServer.CurrentPoll.Options) {
                            var pct = StreamServer.CurrentPoll.TotalVotes > 0 ? (int)Math.Round(((double)opt.Votes / StreamServer.CurrentPoll.TotalVotes) * 100) : 0;
                            <div style="position: relative; background: #1a1e28; border: 1px solid #282f3e; border-radius: 6px; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center; overflow: hidden;">
                                <div style="position: absolute; left: 0; top: 0; bottom: 0; width: @(pct)%; background: rgba(0, 210, 255, 0.2); pointer-events: none;"></div>
                                <span style="position: relative; z-index: 1; font-size: 12px; color: #fff;">@opt.Text</span>
                                <span style="position: relative; z-index: 1; font-size: 11px; font-weight: 700; color: var(--accent-blue, #00d2ff);">@pct% (@opt.Votes)</span>
                            </div>
                        }
                    </div>
                    <button class="scrim-btn-secondary" style="width: 100%; color: #ef4444; border-color: rgba(239, 68, 68, 0.3);" @onclick="EndActivePoll">End Poll</button>
                </div>
            } else {
                <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
                    <label class="scrim-label" style="margin: 0;">Launch a Listener Poll</label>
                    <input type="text" class="scrim-input" @bind="NewPollQuestion" placeholder="e.g. Which track goes harder?" />
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
                        <input type="text" class="scrim-input" style="font-size: 11px;" @bind="NewPollOption1" placeholder="Option 1" />
                        <input type="text" class="scrim-input" style="font-size: 11px;" @bind="NewPollOption2" placeholder="Option 2" />
                    </div>

                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-primary" style="flex: 1;" @onclick="LaunchCustomPoll" disabled="@(string.IsNullOrWhiteSpace(NewPollQuestion) || string.IsNullOrWhiteSpace(NewPollOption1) || string.IsNullOrWhiteSpace(NewPollOption2))">
                            ⚡ Launch Poll
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 0 10px; font-size: 11px;" @onclick="QuickTrackBattle" title="Quick 1-Click Track Battle between current and previous track">
                            ⚔️ Track Battle
                        </button>
                    </div>
                </div>
            }
        </div>,

        "card-audio-routing" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">Audio Routing</h3>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-dots-btn" @onclick="RefreshAudioAndWindows" title="Refresh Applications & Audio Devices">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                        </svg>
                    </button>
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            @{
                var activeSt = StationManager.GetActiveStation();
            }
            @if (activeSt != null) {
                <div style="margin-bottom: 12px; background: rgba(0, 210, 255, 0.06); border: 1px solid rgba(0, 210, 255, 0.25); border-radius: 8px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 11px; font-weight: 700; color: #00d2ff;">Active Station: @activeSt.Config.Name</div>
                        <div style="font-size: 10px; color: #94a3b8;">Mount: /@(activeSt.Config.MountPoint?.Trim('/') ?? "stream") • Audio Source: @activeSt.Config.SourceType</div>
                        @if (!activeSt.IsPrimary) {
                            <label style="display: inline-flex; align-items: center; gap: 5px; font-size: 10px; color: #cbd5e1; cursor: pointer; margin-top: 4px;">
                                <input type="checkbox" checked="@activeSt.Config.ShowOnMainPage" @onchange="ToggleActiveStationShowOnMainPage" style="accent-color: #00d2ff;" />
                                <span>Link on Main Page Channel Dial</span>
                            </label>
                        }
                    </div>
                    <span class="station-tab-dot @(activeSt.IsLive ? "live" : "offline")"></span>
                </div>
                @if (activeSt.Config.SourceType == AudioSourceType.IcecastIngest) {
                    <div style="margin-bottom: 12px; background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 8px; padding: 10px 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <span style="font-size: 11px; font-weight: 700; color: #10b981;">🎧 External DJ Ingest</span>
                            <span style="font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px; background: @(activeSt.IsDjConnected ? "rgba(16, 185, 129, 0.2)" : "rgba(245, 158, 11, 0.2)"); color: @(activeSt.IsDjConnected ? "#34d399" : "#fbbf24");">
                                @(activeSt.IsDjConnected ? $"● Live: {activeSt.ConnectedDjName}" : "⏳ Waiting for DJ to connect...")
                            </span>
                        </div>
                        <div style="font-size: 10px; color: #94a3b8; font-family: monospace; line-height: 1.4;">
                            Host: @(GetIngestServerHost()):@(ProfileManager.CurrentProfile.Port) • Mount: /@(activeSt.Config.MountPoint?.Trim('/') ?? "stream") • User: source • Pass: @activeSt.Config.IngestPassword
                        </div>
                    </div>
                }
            }
            
            <div style="margin-bottom: 14px;">
                <label class="scrim-label">Application Window</label>
                <select class="scrim-select" @bind="SelectedProcessId" @bind:after="OnProcessChanged">
                    <option @key="0" value="0">System Audio (All Apps / Master Desktop Mix)</option>
                    @if (SelectedProcessId != 0 && !Windows.Any(w => w.ProcessId == SelectedProcessId)) {
                        <option @key="SelectedProcessId" value="@SelectedProcessId">@(string.IsNullOrEmpty(SelectedProcessDisplayName) ? "Selected Application" : SelectedProcessDisplayName)</option>
                    }
                    @if (Windows.Any(w => w.IsPlayingAudio)) {
                        <optgroup label="🔊 Currently Playing Audio">
                            @foreach (var w in Windows.Where(w => w.IsPlayingAudio)) {
                                <option @key="w.ProcessId" value="@w.ProcessId">🔊 @w.ProcessName - @w.Title</option>
                            }
                        </optgroup>
                    }
                    <optgroup label="Available Applications">
                        @foreach (var w in Windows.Where(w => !w.IsPlayingAudio)) {
                            <option @key="w.ProcessId" value="@w.ProcessId">@(!string.IsNullOrEmpty(w.ProcessName) && !w.Title.StartsWith(w.ProcessName, StringComparison.OrdinalIgnoreCase) ? $"{w.ProcessName} - {w.Title}" : w.Title)</option>
                        }
                    </optgroup>
                </select>
            </div>

            <!-- Independent Stream Audio Level for Captured Application -->
            <div style="margin-bottom: 14px; background: #14171d; border: 1px solid #252a35; border-radius: 10px; padding: 10px 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label class="scrim-label" style="margin: 0; font-size: 11px;">App Volume on Stream</label>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-family: monospace; font-size: 11px; font-weight: 700; color: #00d2ff;">@(ProfileManager.CurrentProfile.AppStreamVolume)%</span>
                        <button class="pill-option" style="padding: 2px 6px; font-size: 9px;" @onclick="@(() => SetAppStreamVolume(100))" title="Reset to 100%">Reset</button>
                        <button class="pill-option @(ProfileManager.CurrentProfile.AppStreamVolume == 0 ? "active" : "")" 
                                style="padding: 2px 6px; font-size: 9px; @(ProfileManager.CurrentProfile.AppStreamVolume == 0 ? "background: #ef4444; border-color: #ef4444; color: white;" : "")" 
                                @onclick="ToggleMuteStreamVolume" 
                                title="Mute/Unmute application audio on the broadcast stream">
                            @(ProfileManager.CurrentProfile.AppStreamVolume == 0 ? "🔇 Muted" : "Mute")
                        </button>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 11px; color: #64748b;">0%</span>
                    <input type="range" min="0" max="150" step="1" 
                           style="flex: 1; cursor: pointer; accent-color: #00d2ff;" 
                           value="@ProfileManager.CurrentProfile.AppStreamVolume" 
                           @oninput="OnAppStreamVolumeInput" />
                    <span style="font-size: 11px; color: #64748b;">150%</span>
                </div>
                <div style="font-size: 10px; color: #64748b; margin-top: 4px;">
                    Adjusts the broadcast stream level independently without affecting local Windows volume.
                </div>
            </div>

            <!-- Audio Output Capture Device & Virtual Cable Integration -->
            <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <label class="scrim-label" style="margin: 0;">Audio Output / Stream Device</label>
                    <button class="pill-option" style="padding: 2px 8px; font-size: 10px; color: #38bdf8;" @onclick="UnmuteAllLocalApps" title="Ensure all Windows application audio sessions are unmuted">
                        🔊 Restore All Local Volumes
                    </button>
                </div>
                <select class="scrim-select" @bind="ProfileManager.CurrentProfile.CaptureDeviceId" @bind:after="OnCaptureDeviceChanged">
                    <option value="">(Default Playback Device - Speakers / Headphones)</option>
                    @foreach (var rd in RenderDevices) {
                        <option value="@rd.Id">@rd.Name</option>
                    }
                </select>

                <!-- Virtual Audio Device 1-Click Setup -->
                <div style="margin-top: 10px; background: linear-gradient(135deg, rgba(0, 210, 255, 0.08), rgba(99, 102, 241, 0.08)); border: 1px solid rgba(0, 210, 255, 0.35); border-radius: 10px; padding: 12px 14px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-size: 16px;">⚡</span>
                                <span style="font-size: 13px; font-weight: 700; color: #00d2ff; letter-spacing: 0.3px;">1-Click Virtual Audio Setup</span>
                                @if (IsVirtualDeviceActive) {
                                    <span style="font-size: 10px; background: #10b981; color: #0b0d14; font-weight: 700; padding: 1px 6px; border-radius: 10px;">ACTIVE</span>
                                }
                            </div>
                            <div style="font-size: 11px; color: #94a3b8; margin-top: 3px; max-width: 380px;">
                                Installs and connects an isolated virtual cable so your music app streams cleanly to Scrim without sending your other PC sounds.
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; align-items: center;">
                            <button class="scrim-btn-secondary" style="padding: 7px 12px; font-size: 11px;" @onclick="OpenWindowsAppVolume" title="Open Windows Volume Mixer to assign your music app to CABLE Input">
                                ⚙ Sound Settings
                            </button>
                            <button class="scrim-btn-primary" style="padding: 7px 16px; font-size: 12px; font-weight: 700; box-shadow: 0 0 12px rgba(0, 210, 255, 0.3);" 
                                    @onclick="OneClickSetupVirtualAudio" disabled="@IsInstallingVirtualCable">
                                @(IsInstallingVirtualCable ? "⏳ Setting Up..." : (IsVirtualDeviceActive ? "✔ Virtual Audio Ready" : "⚡ Setup Virtual Device"))
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(VirtualCableInstallStatus)) {
                        <div style="font-size: 11px; color: #38bdf8; margin-top: 8px; padding: 6px 10px; background: rgba(0,0,0,0.35); border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                            <span>@VirtualCableInstallStatus</span>
                            <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 10px; white-space: nowrap;" @onclick="OpenWindowsAppVolume" title="Open Windows Volume Mixer">Open Settings ↗</button>
                        </div>
                    } else if (IsVirtualDeviceActive) {
                        <div style="font-size: 10px; color: #64748b; margin-top: 6px;">
                            💡 In the Windows Sound window: Find your music app (Spotify, browser, etc.) and change its <b>Output</b> dropdown to <b>CABLE Input</b>.
                        </div>
                    }
                </div>
            </div>

            <div>
                <label class="scrim-label">Microphone</label>
                <select class="scrim-select" @bind="SelectedDeviceId" @bind:after="OnMicrophoneChanged">
                    <option value="">(Default Physical Microphone)</option>
                    @foreach (var d in Devices) {
                        bool isVirtual = d.Name.Contains("cable", StringComparison.OrdinalIgnoreCase) ||
                                         d.Name.Contains("vb-audio", StringComparison.OrdinalIgnoreCase) ||
                                         d.Name.Contains("virtual", StringComparison.OrdinalIgnoreCase);
                        <option value="@d.Id">@(isVirtual ? $"⚠️ {d.Name} (Virtual Loopback - Not Voice)" : d.Name)</option>
                    }
                </select>
                @if (IsSelectedMicVirtualCable) {
                    <div style="margin-top: 8px; font-size: 11px; color: #f59e0b; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 6px; padding: 8px 10px; line-height: 1.4;">
                        ⚠️ <b>Virtual Cable is selected as your microphone.</b> Music routed through Virtual Cable will be treated as microphone voice instead of music, and will be cut off when the mic is muted! Please select your physical microphone.
                    </div>
                }
            </div>

            <!-- Stream Audio Routing Status -->
            <div style="margin-top: 12px; background: #121620; border: 1px solid @(IsVirtualDeviceActive ? "rgba(0, 210, 255, 0.35)" : "#252a35"); border-radius: 10px; padding: 10px 12px;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px;">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 14px;">🎛️</span>
                        <span style="font-size: 12px; font-weight: 700; color: #fff;">Stream Audio Routing</span>
                    </div>
                    @if (IsVirtualDeviceActive) {
                        <span style="font-size: 10px; background: #10b981; color: #0b0d14; font-weight: 700; padding: 1px 7px; border-radius: 10px; display: inline-flex; align-items: center; gap: 4px;">
                            <span>●</span> ISOLATED CABLE STREAM
                        </span>
                    } else {
                        <span style="font-size: 10px; background: #252a35; color: #94a3b8; font-weight: 600; padding: 1px 7px; border-radius: 10px;">
                            DIRECT AUDIO CAPTURE
                        </span>
                    }
                </div>
                <div style="font-size: 11px; color: #94a3b8; line-height: 1.4;">
                    @if (IsVirtualDeviceActive) {
                        <span>Music is actively captured from <strong>@(RenderDevices.FirstOrDefault(d => d.Id == ProfileManager.CurrentProfile.CaptureDeviceId).Name ?? "Virtual Cable")</strong> continuously. The microphone channel remains completely independent.</span>
                    } else {
                        <span>Music is captured directly from your selected application window or default audio endpoint.</span>
                    }
                </div>
            </div>
        </div>,

        "card-playlist" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00d2ff" stroke-width="2">
                        <path d="M9 18V5l12-2v13"></path>
                        <circle cx="6" cy="18" r="3"></circle>
                        <circle cx="18" cy="16" r="3"></circle>
                    </svg>
                    <h3 class="scrim-card-title" style="margin: 0;">Playlist & Console Player</h3>
                    <span style="font-size: 10px; background: rgba(0, 210, 255, 0.12); color: #00d2ff; padding: 1px 6px; border-radius: 4px; font-weight: 700;">
                        @LocalPlayer.Playlist.Count tracks
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <!-- Integrated Console Player Transport -->
            <div style="background: #0d1117; border: 1px solid #1e2533; border-radius: 8px; padding: 10px; margin-bottom: 10px;">
                <!-- Now Playing Details -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div style="min-width: 0; flex: 1;">
                        <div style="font-size: 13px; font-weight: 700; color: @(LocalPlayer.IsPlaying ? "#00d2ff" : "#fff"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @(LocalPlayer.CurrentTrack != null ? LocalPlayer.CurrentTrack.Title : "No Local Track Loaded")
                        </div>
                        <div style="font-size: 11px; color: #8e95a5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @(LocalPlayer.CurrentTrack != null ? $"{LocalPlayer.CurrentTrack.Artist} {(string.IsNullOrEmpty(LocalPlayer.CurrentTrack.Album) ? "" : $"• {LocalPlayer.CurrentTrack.Album}")}" : "Use '+ Add Files' or click a song to begin playback")
                        </div>
                    </div>
                    @if (LocalPlayer.IsPlaying) {
                        <div style="display: flex; gap: 2px; align-items: flex-end; height: 16px; margin-left: 8px;">
                            <div style="width: 3px; height: 12px; background: #00d2ff; border-radius: 1px;"></div>
                            <div style="width: 3px; height: 16px; background: #00d2ff; border-radius: 1px;"></div>
                            <div style="width: 3px; height: 8px; background: #00d2ff; border-radius: 1px;"></div>
                        </div>
                    }
                </div>

                <!-- Seek Slider and Time -->
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                    <span style="font-size: 10px; font-family: monospace; color: #94a3b8; min-width: 34px;">
                        @(LocalPlayer.Position.TotalHours >= 1 ? LocalPlayer.Position.ToString(@"h\:mm\:ss") : LocalPlayer.Position.ToString(@"mm\:ss"))
                    </span>
                    <input type="range" min="0" max="@Math.Max(1, LocalPlayer.Duration.TotalSeconds)" step="1"
                           value="@LocalPlayer.Position.TotalSeconds"
                           @onchange="OnLocalSeekChanged"
                           style="flex: 1; accent-color: #00d2ff; height: 4px; cursor: pointer;" />
                    <span style="font-size: 10px; font-family: monospace; color: #94a3b8; min-width: 34px; text-align: right;">
                        @(LocalPlayer.Duration.TotalHours >= 1 ? LocalPlayer.Duration.ToString(@"h\:mm\:ss") : LocalPlayer.Duration.ToString(@"mm\:ss"))
                    </span>
                </div>

                <!-- Transport Buttons and Volume -->
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px;">
                    <!-- Playback Controls -->
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <button class="scrim-dots-btn" style="padding: 4px 8px; font-size: 12px;" @onclick="@(() => LocalPlayer.Previous())" title="Previous Track">⏮</button>
                        <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 12px; font-weight: 700; background: @(LocalPlayer.IsPlaying ? "#f59e0b" : "#00d2ff"); color: #000;"
                                @onclick="@(() => LocalPlayer.TogglePlayPause())" title="@(LocalPlayer.IsPlaying ? "Pause" : "Play")">
                            @(LocalPlayer.IsPlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="scrim-dots-btn" style="padding: 4px 8px; font-size: 12px;" @onclick="@(() => LocalPlayer.Stop())" title="Stop">⏹</button>
                        <button class="scrim-dots-btn" style="padding: 4px 8px; font-size: 12px;" @onclick="@(() => LocalPlayer.Next())" title="Next Track">⏭</button>
                    </div>

                    <!-- Mode Toggles: Shuffle & Repeat -->
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <button class="pill-option @(LocalPlayer.IsShuffle ? "active" : "")"
                                style="padding: 3px 8px; font-size: 10px; border-radius: 4px; background: @(LocalPlayer.IsShuffle ? "rgba(0, 210, 255, 0.25)" : "#1e2533"); color: @(LocalPlayer.IsShuffle ? "#00d2ff" : "#8e95a5");"
                                @onclick="@(() => { LocalPlayer.IsShuffle = !LocalPlayer.IsShuffle; StateHasChanged(); })"
                                title="Shuffle: @(LocalPlayer.IsShuffle ? "ON" : "OFF")">
                            🔀
                        </button>
                        <button class="pill-option @(LocalPlayer.RepeatMode != LocalPlayerRepeatMode.Off ? "active" : "")"
                                style="padding: 3px 8px; font-size: 10px; border-radius: 4px; background: @(LocalPlayer.RepeatMode != LocalPlayerRepeatMode.Off ? "rgba(0, 210, 255, 0.25)" : "#1e2533"); color: @(LocalPlayer.RepeatMode != LocalPlayerRepeatMode.Off ? "#00d2ff" : "#8e95a5");"
                                @onclick="ToggleRepeatMode"
                                title="Repeat Mode: @LocalPlayer.RepeatMode">
                            @(LocalPlayer.RepeatMode switch {
                                LocalPlayerRepeatMode.One => "🔂 1",
                                LocalPlayerRepeatMode.All => "🔁 All",
                                _ => "🔁 Off"
                            })
                        </button>
                    </div>

                    <!-- Volume Slider -->
                    <div style="display: flex; align-items: center; gap: 4px; min-width: 90px;">
                        <button class="scrim-dots-btn" style="padding: 2px 4px; font-size: 10px;" @onclick="@(() => { LocalPlayer.IsMuted = !LocalPlayer.IsMuted; StateHasChanged(); })">
                            @(LocalPlayer.IsMuted ? "🔇" : (LocalPlayer.Volume < 0.5f ? "🔉" : "🔊"))
                        </button>
                        <input type="range" min="0" max="1" step="0.05"
                               value="@LocalPlayer.Volume"
                               @oninput="@((ChangeEventArgs e) => { if (float.TryParse(e.Value?.ToString(), out var v)) LocalPlayer.Volume = v; })"
                               style="width: 60px; accent-color: #00d2ff; height: 3px;"
                               title="Local Player Volume: @((int)(LocalPlayer.Volume * 100))%" />
                    </div>
                </div>
            </div>

            <!-- Toolbar: Add Files, Folder, Save, Load, Filter -->
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; align-items: center;">
                <button class="scrim-btn-primary" style="padding: 4px 8px; font-size: 11px;" @onclick="OpenAddAudioFilesDialog" title="Add Audio Files (MP3, WAV, FLAC, M4A, AAC)">
                    + Add Files
                </button>
                <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px;" @onclick="OpenAddAudioFolderDialog" title="Scan Folder for Music Files">
                    📁 Folder
                </button>
                <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px;" @onclick="OpenSavePlaylistDialog" title="Save Playlist (.m3u / .json)">
                    💾 Save
                </button>
                <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px;" @onclick="OpenLoadPlaylistDialog" title="Load Saved Playlist">
                    📂 Load
                </button>
                <button class="scrim-dots-btn" style="color: #ef4444; font-size: 11px; padding: 4px 6px;" @onclick="@(() => LocalPlayer.ClearPlaylist())" title="Clear Playlist">
                    🗑️
                </button>
                <input type="text" class="scrim-input" style="flex: 1; min-width: 90px; padding: 4px 6px; font-size: 11px;"
                       placeholder="🔍 Search..." @bind="PlaylistFilterQuery" @bind:event="oninput" />
            </div>

            <!-- Tracklist -->
            <div style="max-height: 220px; overflow-y: auto; margin-bottom: 4px; border: 1px solid #1b202c; border-radius: 6px; background: #07090e;">
                @{
                    var query = PlaylistFilterQuery?.Trim();
                    var tracks = string.IsNullOrEmpty(query)
                        ? LocalPlayer.Playlist
                        : LocalPlayer.Playlist.Where(t => t.Title.Contains(query, StringComparison.OrdinalIgnoreCase) || t.Artist.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
                }

                @if (tracks.Count == 0) {
                    <div style="padding: 24px; text-align: center; color: #64748b; font-size: 11px;">
                        @(LocalPlayer.Playlist.Count == 0 ? "Playlist is empty. Click '+ Add Files' or '📁 Folder' to add local tracks." : "No tracks match search filter.")
                    </div>
                } else {
                    @for (int i = 0; i < tracks.Count; i++) {
                        var track = tracks[i];
                        int trackIndex = GetTrackIndex(track);
                        bool isCurrent = trackIndex == LocalPlayer.CurrentIndex;
                        var songCounts = ReactionService.GetSongReactions(track.Title, track.Artist);

                        <div class="playlist-row @(isCurrent ? "active-track" : "")"
                             style="cursor: pointer; display: flex; align-items: center; padding: 6px 6px; gap: 6px; border-bottom: 1px solid rgba(255,255,255,0.03); background: @(isCurrent ? "rgba(0, 210, 255, 0.08)" : "transparent");"
                             @ondblclick="@(() => LocalPlayer.PlayTrack(trackIndex))">
                            
                            <!-- Track Number or Play Indicator -->
                            <div style="width: 20px; text-align: center; font-size: 11px; font-family: monospace; color: @(isCurrent ? "#00d2ff" : "#64748b");"
                                 @onclick="@(() => LocalPlayer.PlayTrack(trackIndex))">
                                @(isCurrent && LocalPlayer.IsPlaying ? "▶" : $"{trackIndex + 1}")
                            </div>

                            <!-- Track Info -->
                            <div style="flex: 1; min-width: 0;" @onclick="@(() => LocalPlayer.PlayTrack(trackIndex))">
                                <div style="color: @(isCurrent ? "#00d2ff" : "#fff"); font-size: 12px; font-weight: @(isCurrent ? "700" : "500"); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                    @track.Title
                                </div>
                                <div style="font-size: 10px; color: #8e95a5; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                    @track.Artist
                                </div>
                            </div>

                            <!-- Reactions Badge -->
                            <div style="display: flex; gap: 4px; align-items: center; font-size: 10px; white-space: nowrap;">
                                @if (songCounts.ThumbsUp > 0 || songCounts.Heart > 0 || songCounts.ThumbsDown > 0) {
                                    <span title="Listener Reactions" style="background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 6px; display: inline-flex; align-items: center; gap: 2px;">
                                        @if (songCounts.ThumbsUp > 0) { <span style="color: #38bdf8;">👍@songCounts.ThumbsUp</span> }
                                        @if (songCounts.Heart > 0) { <span style="color: #f43f5e;">❤️@songCounts.Heart</span> }
                                        @if (songCounts.ThumbsDown > 0) { <span style="color: #94a3b8;">👎@songCounts.ThumbsDown</span> }
                                    </span>
                                }
                            </div>

                            <!-- Duration -->
                            <div style="font-size: 11px; font-family: monospace; color: #8e95a5; min-width: 36px; text-align: right;" @onclick="@(() => LocalPlayer.PlayTrack(trackIndex))">
                                @track.FormattedDuration
                            </div>

                            <!-- Quick Action Buttons: Deck A, Deck B, Move, Delete -->
                            <div style="display: flex; align-items: center; gap: 2px; margin-left: 2px;">
                                <button class="scrim-dots-btn" style="font-size: 9px; padding: 1px 3px; color: #00d2ff;" @onclick="@(() => CueTrackToDeck(track, "A"))" title="Load into Deck A">
                                    [A]
                                </button>
                                <button class="scrim-dots-btn" style="font-size: 9px; padding: 1px 3px; color: #10b981;" @onclick="@(() => CueTrackToDeck(track, "B"))" title="Load into Deck B">
                                    [B]
                                </button>
                                @if (trackIndex > 0) {
                                    <button class="scrim-dots-btn" style="font-size: 10px; padding: 1px 2px; color: #94a3b8;" @onclick="@(() => LocalPlayer.MoveTrack(trackIndex, trackIndex - 1))" title="Move Up">
                                        ▲
                                    </button>
                                }
                                @if (trackIndex < LocalPlayer.Playlist.Count - 1) {
                                    <button class="scrim-dots-btn" style="font-size: 10px; padding: 1px 2px; color: #94a3b8;" @onclick="@(() => LocalPlayer.MoveTrack(trackIndex, trackIndex + 1))" title="Move Down">
                                        ▼
                                    </button>
                                }
                                <button class="scrim-dots-btn" style="color: #6b7280; font-size: 10px; padding: 1px 3px;" @onclick="@(() => LocalPlayer.RemoveTrack(track))" title="Remove Track">
                                    ✕
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>,

        "card-vu-talk" => @<div class="scrim-card">
