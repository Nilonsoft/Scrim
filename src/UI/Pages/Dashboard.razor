    private void AddBlacklistWord() {
        if (string.IsNullOrWhiteSpace(NewBlacklistWord)) return;
        string word = NewBlacklistWord.Trim();
        if (!ProfileManager.CurrentProfile.NicknameBlacklist.Any(b => b.Equals(word, StringComparison.OrdinalIgnoreCase))) {
            ProfileManager.CurrentProfile.NicknameBlacklist.Add(word);
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        }
        NewBlacklistWord = "";
        StateHasChanged();
    }

    private void RemoveBlacklistWord(string word) {
        ProfileManager.CurrentProfile.NicknameBlacklist.RemoveAll(b => b.Equals(word, StringComparison.OrdinalIgnoreCase));
        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        StateHasChanged();
    }

    private void OpenAssignNickname(string currentSender) {
        AssignTargetUser = currentSender;
        NewAssignedNickname = "";
        ShowAssignNicknameModal = true;
    }

    private void ConfirmAssignNickname() {
        if (string.IsNullOrWhiteSpace(NewAssignedNickname) || string.IsNullOrWhiteSpace(AssignTargetUser)) {
            ShowAssignNicknameModal = false;
            return;
        }
        string assigned = NewAssignedNickname.Trim();
        ChatService.AssignNickname(AssignTargetUser, assigned);
        foreach (var m in ConsoleChatMessages.Where(m => m.Sender.Equals(AssignTargetUser, StringComparison.OrdinalIgnoreCase))) {
            m.Sender = assigned;
        }
        ShowAssignNicknameModal = false;
        AssignTargetUser = "";
        NewAssignedNickname = "";
        StateHasChanged();
    }

    private async Task AutoScrollChatAsync() {
        try {
            await JSRuntime.InvokeVoidAsync("eval", "setTimeout(function() { var el = document.getElementById('consoleChatContainer'); if (el) { el.scrollTop = el.scrollHeight; } }, 40);");
        } catch { }
    }

    private void OnChatMessageReceived(ChatMessage msg) {
        InvokeAsync(async () => {
            if (!ConsoleChatMessages.Any(m => m.Id == msg.Id)) {
                ConsoleChatMessages.Add(msg);
                if (ConsoleChatMessages.Count > 100) {
                    ConsoleChatMessages.RemoveAt(0);
                }
                StateHasChanged();
                await AutoScrollChatAsync();
            }
        });
    }

    private void OnChatMessageRemoved(string messageId) {
        InvokeAsync(() => {
            ConsoleChatMessages.RemoveAll(m => m.Id.Equals(messageId, StringComparison.OrdinalIgnoreCase));
            StateHasChanged();
        });
    }

    private void DeleteChatMessage(ChatMessage msg) {
        if (msg == null || string.IsNullOrWhiteSpace(msg.Id)) return;
        ChatService.RemoveMessage(msg.Id);
        ConsoleChatMessages.RemoveAll(m => m.Id == msg.Id);
        StateHasChanged();
    }

    private void OnChatCleared() {
        InvokeAsync(() => {
            ConsoleChatMessages.Clear();
            StateHasChanged();
        });
    }

    private void OnUserBanned(string userId) {
        InvokeAsync(() => {
            ConsoleChatMessages.RemoveAll(m => m.UserId != null && m.UserId.Equals(userId, StringComparison.OrdinalIgnoreCase));
            StateHasChanged();
        });
    }

    private void BanUserFromMessage(ChatMessage msg) {
        if (msg == null || msg.IsHost) return;
        string userId = !string.IsNullOrWhiteSpace(msg.UserId) ? msg.UserId : msg.Sender;
        ChatService.BanUser(userId, msg.Sender);
        if (!ProfileManager.CurrentProfile.BannedUsers.Any(b => b.UserId.Equals(userId, StringComparison.OrdinalIgnoreCase))) {
            ProfileManager.CurrentProfile.BannedUsers.Add(new BannedChatUser {
                UserId = userId,
                Nickname = msg.Sender,
                BannedAt = DateTime.UtcNow
            });
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        }
        ConsoleChatMessages.RemoveAll(m => (m.UserId != null && m.UserId.Equals(userId, StringComparison.OrdinalIgnoreCase)) || (m.UserId == null && m.Sender.Equals(msg.Sender, StringComparison.OrdinalIgnoreCase)));
        StateHasChanged();
    }

    private void UnbanUser(string userId) {
        if (string.IsNullOrWhiteSpace(userId)) return;
        ChatService.UnbanUser(userId);
        ProfileManager.CurrentProfile.BannedUsers.RemoveAll(b => b.UserId.Equals(userId, StringComparison.OrdinalIgnoreCase));
        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        StateHasChanged();
    }

