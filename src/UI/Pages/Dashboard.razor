    private async Task OneClickSetupVirtualAudio() {
        if (IsInstallingVirtualCable) return;
        IsInstallingVirtualCable = true;
        VirtualCableInstallStatus = "Setting up virtual audio device...";
        StateHasChanged();

        if (string.IsNullOrEmpty(OriginalDefaultDeviceId)) {
            OriginalDefaultDeviceId = VirtualDeviceService.GetDefaultPlaybackDeviceId();
            OriginalDefaultDeviceName = VirtualDeviceService.GetDefaultPlaybackDeviceName();
        }

        string? targetDeviceId = null;
        string? targetDeviceName = null;

        if (!VirtualDeviceService.IsVbCableInstalled(out targetDeviceId, out targetDeviceName)) {
            VirtualCableInstallStatus = "Installing driver (please accept Windows UAC prompt)...";
            StateHasChanged();

            var installResult = await VirtualDeviceService.InstallVirtualCableAsync();
            if (!installResult.Success) {
                IsInstallingVirtualCable = false;
                VirtualCableInstallStatus = installResult.Message;
                StateHasChanged();
                return;
            }
            targetDeviceId = installResult.DeviceId;
        }

        RefreshAudioAndWindows();

        if (string.IsNullOrEmpty(targetDeviceId)) {
            VirtualDeviceService.IsVirtualDeviceInstalled(out targetDeviceId, out targetDeviceName);
        }

        if (!string.IsNullOrEmpty(targetDeviceId)) {
            ProfileManager.CurrentProfile.CaptureDeviceId = targetDeviceId;
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
            EnsureAudioMonitoring(SelectedProcessId);

            // Open Windows Sound App Volume Settings so the user can easily assign their music player
            VirtualDeviceService.OpenAppVolumeSettings();
            VirtualCableInstallStatus = $"✔ Virtual device ready! In the Windows Sound window that just opened, set your music app's output to '{targetDeviceName ?? "CABLE Input"}'.";
        } else {
            VirtualCableInstallStatus = "Driver installed. If device is not immediately visible, restart Scrim or check Windows Sound.";
        }

        IsInstallingVirtualCable = false;
        StateHasChanged();
    }

