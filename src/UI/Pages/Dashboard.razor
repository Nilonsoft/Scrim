    private void GenerateClockWheelQueue() {
        var rules = ProfileManager.CurrentProfile.RotationRules;
        var heavy = rules.HeavyRotationTracks;
        var medium = rules.RecentsTracks;
        var gold = rules.ClassicGoldTracks;
        var sweepers = rules.JingleTracks;

        int addedCount = 0;
        void AddTrack(string fallbackTitle, string fallbackArtist, string duration, List<string> sourceBin) {
            string title = fallbackTitle;
            string artist = fallbackArtist;
            if (sourceBin != null && sourceBin.Count > 0) {
                int index = Random.Shared.Next(0, sourceBin.Count);
                string raw = sourceBin[index];
                if (raw.Contains(" - ")) {
                    var parts = raw.Split(new[] { " - " }, 2, StringSplitOptions.None);
                    artist = parts[0].Trim();
                    title = parts[1].Trim();
                } else {
                    title = raw;
                    artist = "Station Library";
                }
            }
            PlaylistTracks.Add(new PlaylistItem {
                Number = PlaylistTracks.Count + 1,
                Title = title,
                Artist = artist,
                Duration = duration
            });
            addedCount++;
        }

        AddTrack("Station Top-of-Hour ID", "Scrim Sweeper", "00:15", sweepers);
        AddTrack("Power Track 1", "Heavy Current", "03:45", heavy);
        AddTrack("Classic Gold Track", "Legendary Band", "04:12", gold);
        AddTrack("Mid-Tempo Groove", "Recent Artist", "03:30", medium);
        AddTrack("Power Track 2", "High Energy", "03:55", heavy);
        AddTrack("Station Mid-Hour ID", "Scrim Sweeper", "00:12", sweepers);
        AddTrack("Secondary Hit", "Recent Artist", "03:22", medium);
        AddTrack("Power Track 3", "Heavy Current", "03:50", heavy);
        AddTrack("Deep Library Classic", "Classic Vault", "04:30", gold);
        AddTrack("Power Track 4", "Heavy Current", "03:40", heavy);

        for (int i = 0; i < PlaylistTracks.Count; i++) {
            PlaylistTracks[i].Number = i + 1;
        }

        bool hasConfiguredTracks = heavy.Count > 0 || medium.Count > 0 || gold.Count > 0 || sweepers.Count > 0;
        _rotationStatusMessage = hasConfiguredTracks
            ? $"✓ Assembled {addedCount} tracks into playlist from your Category Bins!"
            : $"✓ Generated 1-hour sequence! (Tip: populate your category bins above for personalized rotation)";
        StateHasChanged();
    }

