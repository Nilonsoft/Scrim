    private void StartBroadcast() {
        if (!FFmpegService.IsInstalled) {
            ShowFFmpegModal = true;
            return;
        }
        if (IsLive) return;

        _broadcastCts = new CancellationTokenSource();
        var token = _broadcastCts.Token;

        try {
            StreamServer.Start(ProfileManager.CurrentProfile.Port);

            string? captureDevice = ProfileManager.CurrentProfile.CaptureDeviceId;
            Capture.StartCapture(SelectedProcessId, captureDevice);
            if (SelectedProcessId != 0) {
                MetadataService.StartMonitoring(SelectedProcessId);
            }

            MicService.StartCapture(SelectedDeviceId);
            MicService.SetVirtualOutputDevice(null);
            Mixer.StartMixing(Capture.AudioStream, MicService.MicrophoneStream, token);

            var format = Enum.TryParse<AudioFormat>(ProfileManager.CurrentProfile.AudioFormat, true, out var parsed) 
                ? parsed 
                : AudioFormat.Mp3;
            Transcoder.SetFormat(format, ProfileManager.CurrentProfile.Bitrate);
            Transcoder.StartTranscoding(Mixer.MixedStream);

            Hub.StartBroadcasting(Transcoder.OutputStream);
            IsLive = true;

            _ = JSRuntime.InvokeVoidAsync("eval", "document.body.setAttribute('data-broadcasting', 'true')");
        } catch (Exception ex) {
            Console.WriteLine($"Error starting broadcast: {ex.Message}");
            IsLive = false;
            StopBroadcast();
        }

        StateHasChanged();
    }

    private void StopBroadcast() {
        if (!IsLive && !Hub.IsBroadcasting) return;
        IsLive = false;

        try {
            _broadcastCts?.Cancel();
            Hub.StopBroadcasting();
            Transcoder.StopTranscoding();
            MetadataService.StopMonitoring();

            // Resume monitoring mixer so VU meters stay responsive in console
            EnsureAudioMonitoring(SelectedProcessId);

            _ = JSRuntime.InvokeVoidAsync("eval", "document.body.setAttribute('data-broadcasting', 'false')");
        } catch (Exception ex) {
            Console.WriteLine($"Error stopping broadcast: {ex.Message}");
        }

        StateHasChanged();
    }

