    private void SyncDjEqFromProfile() {
        var cfg = ProfileManager.CurrentProfile.DjEq;
        if (cfg == null) return;
        var eq = Mixer.DjEq;
        eq.MusicTrimDb = cfg.MusicTrimDb;
        eq.MusicPan = cfg.MusicPan;
        eq.MusicStereoWidth = cfg.MusicStereoWidth;
        eq.MusicMuted = cfg.MusicMuted;
        eq.MicGainDb = cfg.MicGainDb;
        eq.MicPan = cfg.MicPan;
        eq.MicLowCut = cfg.MicLowCut;
        eq.LowGainDb = cfg.LowGainDb;
        eq.MidGainDb = cfg.MidGainDb;
        eq.HighGainDb = cfg.HighGainDb;
        eq.LowKill = cfg.LowKill;
        eq.MidKill = cfg.MidKill;
        eq.HighKill = cfg.HighKill;
        eq.ColorFilterKnob = cfg.ColorFilterKnob;
        eq.Is10BandMode = cfg.Is10BandMode;
        eq.MasterGainDb = cfg.MasterGainDb;
        eq.MasterBalance = cfg.MasterBalance;
        eq.SoftLimiterEnabled = cfg.SoftLimiterEnabled;
        eq.EqBypass = cfg.EqBypass;
        if (cfg.Bands10Db != null && cfg.Bands10Db.Length >= 10) {
            Array.Copy(cfg.Bands10Db, eq.Bands10Db, 10);
        }
        eq.RecalculateFilters();
    }

    private void SaveDjEqToProfile() {
        var cfg = ProfileManager.CurrentProfile.DjEq;
        var eq = Mixer.DjEq;
        cfg.MusicTrimDb = eq.MusicTrimDb;
        cfg.MusicPan = eq.MusicPan;
        cfg.MusicStereoWidth = eq.MusicStereoWidth;
        cfg.MusicMuted = eq.MusicMuted;
        cfg.MicGainDb = eq.MicGainDb;
        cfg.MicPan = eq.MicPan;
        cfg.MicLowCut = eq.MicLowCut;
        cfg.LowGainDb = eq.LowGainDb;
        cfg.MidGainDb = eq.MidGainDb;
        cfg.HighGainDb = eq.HighGainDb;
        cfg.LowKill = eq.LowKill;
        cfg.MidKill = eq.MidKill;
        cfg.HighKill = eq.HighKill;
        cfg.ColorFilterKnob = eq.ColorFilterKnob;
        cfg.Is10BandMode = eq.Is10BandMode;
        cfg.MasterGainDb = eq.MasterGainDb;
        cfg.MasterBalance = eq.MasterBalance;
        cfg.SoftLimiterEnabled = eq.SoftLimiterEnabled;
        cfg.EqBypass = eq.EqBypass;
        if (cfg.Bands10Db == null || cfg.Bands10Db.Length < 10) {
            cfg.Bands10Db = new float[10];
        }
        Array.Copy(eq.Bands10Db, cfg.Bands10Db, 10);
        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
    }

