            <!-- Add Custom Sound Form -->
            <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid #252830;">
                <label class="scrim-label" style="font-size: 11px;">+ Add Custom Sound File (.wav)</label>
                <div style="display: flex; gap: 6px;">
                    <input type="text" class="scrim-input" style="flex: 1; padding: 4px 8px; font-size: 11px;" @bind="NewCustomSoundName" placeholder="Sound Name" />
                    <input type="text" class="scrim-input" style="flex: 2; padding: 4px 8px; font-size: 11px;" @bind="NewCustomSoundPath" placeholder="C:\Audio\sound.wav" />
                    <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="AddCustomSound">+ Add</button>
                </div>
            </div>
        </div>,

        "card-web-branding" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    Website Branding & Links
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Station Brand / Header Title</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.StationName" @bind:event="oninput" placeholder="e.g. GLOBAL INDIE RADIO" />
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Browser Page Title</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.PageTitle" @bind:event="oninput" placeholder="e.g. Global Indie Radio - Live Broadcast" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                <div>
                    <label class="scrim-label">Show / Program Title</label>
                    <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.ShowTitle" @bind:event="oninput" placeholder="e.g. Late Night Indie Drive" />
                </div>
                <div>
                    <label class="scrim-label">Host / DJ Name</label>
                    <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.HostName" @bind:event="oninput" placeholder="e.g. Sarah J." />
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Station Tagline / Genre</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.GenreTag" @bind:event="oninput" placeholder="e.g. Indie Alternative" />
            </div>

            <div style="margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <label class="scrim-label" style="margin: 0;">Top Website Banner (Optional)</label>
                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px;" @onclick="OpenAssetsDirectory" title="Open ~/.scrim/assets/ in File Explorer">📁 Open Assets Folder</button>
                        @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.BannerUrl)) {
                            <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px; color: #ef4444;" @onclick="@(() => { ProfileManager.CurrentProfile.BannerUrl = ""; SaveBranding(); })">✕ Remove Banner</button>
                        }
                    </div>
                </div>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.BannerUrl" @bind:event="oninput" placeholder="URL (https://...) or .\assets\image.jpg (or image name in ~/.scrim/assets)" />
                <span style="font-size: 11px; color: var(--text-muted, #71717a); display: block; margin-top: 4px;">Displays a panoramic image banner across the top of the website. Supports URLs, <code>.\assets\name</code>, or images in <code>~/.scrim/assets/</code>.</span>
                @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.BannerUrl)) {
                    <div style="margin-top: 8px; border-radius: 6px; overflow: hidden; height: 60px; background: #000; border: 1px solid var(--border-color, #252830); display: flex; align-items: center; justify-content: center;">
                        <img src="@(ProfileManager.CurrentProfile.BannerUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ProfileManager.CurrentProfile.BannerUrl : $"/api/banner?t={DateTime.UtcNow.Ticks}")" 
                             alt="Banner Preview" 
                             style="width: 100%; height: 100%; object-fit: cover;" 
                             onerror="this.style.display='none'" />
                    </div>
                }
            </div>

            <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label class="scrim-label" style="margin: 0;">Website Theme</label>
                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 11px;" @onclick="() => ThemeService.RefreshThemes()" title="Reload user themes from disk">⟳ Refresh</button>
                        <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 11px;" @onclick="() => ThemeService.OpenThemesDirectory()" title="Open ~/.scrim/themes/ in Explorer">📁 Open Themes Folder</button>
                    </div>
                </div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    @foreach (var theme in ThemeService.GetAvailableThemes()) {
                        <button class="pill-option @(ProfileManager.CurrentProfile.WebTheme == theme.Id ? "active" : "")" 
                                style="padding: 4px 10px; font-size: 11px;" 
                                title="@theme.Description"
                                @onclick='@(() => SetWebTheme(theme.Id, theme.AccentColor))'>
                            @(theme.Icon) @(theme.Name)@(theme.IsCustom ? " (User)" : "")
                        </button>
                    }
                </div>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                    <input type="checkbox" id="syncConsoleThemeCheck"
                           checked="@ProfileManager.CurrentProfile.SyncConsoleThemeWithWeb"
                           @onchange="ToggleSyncConsoleTheme"
                           style="accent-color: var(--accent-blue, #00d2ff); width: 15px; height: 15px; cursor: pointer;" />
                    <label for="syncConsoleThemeCheck" style="font-size: 11.5px; color: var(--text-muted, #94a3b8); cursor: pointer; user-select: none; margin: 0;">
                        Sync Scrim Console with Website Theme (desktop console updates colors to match)
                    </label>
                </div>
            </div>

            <div style="margin-bottom: 14px;">
                <label class="scrim-label">Accent Color Theme</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="color" style="width: 36px; height: 36px; border: none; border-radius: 8px; background: transparent; cursor: pointer;"
                           value="@ProfileManager.CurrentProfile.AccentColor"
                           @onchange="@((ChangeEventArgs e) => SetAccentColor(e.Value?.ToString() ?? "#ef4444"))" />
                    
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #ef4444; color: white; border: none;" @onclick="@(() => SetAccentColor("#ef4444"))">Red</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #00d2ff; color: #121316; border: none;" @onclick="@(() => SetAccentColor("#00d2ff"))">Cyan</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #a855f7; color: white; border: none;" @onclick="@(() => SetAccentColor("#a855f7"))">Purple</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #10b981; color: white; border: none;" @onclick="@(() => SetAccentColor("#10b981"))">Green</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #f59e0b; color: #121316; border: none;" @onclick="@(() => SetAccentColor("#f59e0b"))">Amber</button>
                    </div>
                </div>
            </div>

            <!-- Custom Navigation Links with Label + Exact Destination URL -->
            <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label class="scrim-label" style="margin: 0;">Navigation Links & Destinations</label>
                    <button class="scrim-btn-secondary" style="padding: 3px 8px; font-size: 11px;" @onclick="AddNavLink">+ Add Link</button>
                </div>
                @foreach (var link in ProfileManager.CurrentProfile.CustomNavLinks) {
                    <div style="display: flex; gap: 6px; margin-bottom: 8px; align-items: center;">
                        <input type="text" class="scrim-input" style="flex: 1; padding: 6px 8px; font-size: 12px;" @bind="link.Label" placeholder="Label (e.g. Discord)" />
                        <input type="text" class="scrim-input" style="flex: 2; padding: 6px 8px; font-size: 12px;" @bind="link.Url" placeholder="URL (e.g. https://discord.gg/...)" />
                        <button class="scrim-dots-btn" style="color: #ef4444; font-size: 12px;" @onclick="@(() => RemoveNavLink(link))" title="Delete Link">✕</button>
                    </div>
                }
            </div>

            <!-- Recently Played Song History Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Show Recently Played Songs</div>
                        <div style="font-size: 11px; color: #64748b;">Allow web listeners to view songs played during this session</div>
                    </div>
                    <label class="scrim-switch">
                        <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableSongHistory" @onchange="ToggleSongHistoryEnabled" />
                        <span class="scrim-slider"></span>
                    </label>
                </div>
                @if (ProfileManager.CurrentProfile.EnableSongHistory) {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); gap: 8px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 11px; color: #94a3b8;">Max songs:</span>
                            <div style="display: flex; gap: 4px; align-items: center;">
                                @foreach (var count in new[] { 5, 10, 15, 20, 25, 50 }) {
                                    <button class="pill-option @(ProfileManager.CurrentProfile.SongHistoryLimit == count ? "active" : "")" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => SetSongHistoryLimit(count))">
                                        @count
                                    </button>
                                }
                                <input type="number" min="1" max="100" style="width: 48px; background: #1a1d26; border: 1px solid #2d323e; border-radius: 4px; color: #fff; font-size: 10px; padding: 2px 4px; text-align: center;" value="@ProfileManager.CurrentProfile.SongHistoryLimit" @onchange="OnSongHistoryLimitChanged" title="Custom maximum songs count (1-100)" />
                            </div>
                        </div>
                        @if (HistoryService.GetHistory(100).Count > 0) {
                            <button class="pill-option" style="padding: 2px 8px; font-size: 10px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; border-radius: 6px;" @onclick="ClearSessionHistory" title="Clear all song history from web player and console">
                                🗑️ Clear History (@(HistoryService.GetHistory(100).Count))
                            </button>
                        }
                    </div>
                }
            </div>

            <button class="scrim-btn-primary" style="width: 100%;" @onclick="SaveBranding">Save & Apply Branding</button>
        </div>,

        "card-network-access" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    Network & Internet Broadcasting
                </h3>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Enable Network Broadcasting Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 10px 14px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">Network Broadcasting</div>
                    <div style="font-size: 11px; color: #64748b;">Allow devices on Wi-Fi and remote listeners to connect</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableNetworkAccess" @onchange="ToggleNetworkAccess" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Enable UPnP Router Forwarding Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 10px 14px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">UPnP Router Port Forwarding</div>
                    <div style="font-size: 11px; color: #64748b;">Automatically map port @ProfileManager.CurrentProfile.Port on router</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableUpnpPortForwarding" @onchange="ToggleUpnpPortForwarding" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Stream Server Port Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Server Port (HTTP & Stream)</div>
                        <div style="font-size: 11px; color: #64748b;">Port used by the web player and audio stream listener endpoint</div>
                    </div>
                    <span style="font-family: monospace; font-size: 12px; font-weight: 700; color: #00d2ff; background: #181b22; padding: 2px 8px; border-radius: 4px; border: 1px solid #2d3342;">
                        :@(ProfileManager.CurrentProfile.Port)
                    </span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 0 8px; flex: 1; min-width: 140px;">
                        <span style="color: #64748b; font-family: monospace; font-size: 12px; margin-right: 4px;">Port:</span>
                        <input type="number" min="1024" max="65535" class="scrim-input" style="border: none; background: transparent; padding: 6px 4px; font-family: monospace; font-size: 12px; color: #fff; width: 100%;" 
                               value="@CustomPortInput" 
                               @oninput="@((ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out int p)) CustomPortInput = p; })" 
                               placeholder="e.g. 8080" />
                    </div>
                    <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 11px; white-space: nowrap;" @onclick="ApplyServerPort">
                        Apply Port
                    </button>
                    <!-- Quick preset port pills -->
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 8080 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(8080))">8080</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 8000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(8000))">8000</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 9000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(9000))">9000</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 5000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(5000))">5000</button>
                </div>
                @if (!string.IsNullOrEmpty(PortChangeStatusMessage)) {
                    <div style="font-size: 11px; margin-top: 6px; color: @(PortChangeSuccess ? "#10b981" : "#ef4444");">
                        @PortChangeStatusMessage
                    </div>
                }
            </div>

            <!-- Restrict to Local Network Only (Private Stream) Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; background: #12141a; border: 1px solid @(ProfileManager.CurrentProfile.RestrictToLocalNetwork ? "rgba(245, 158, 11, 0.5)" : "#232731"); border-radius: 8px; padding: 10px 14px; transition: border-color 0.2s ease;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 6px;">
                        <span>Restrict to Local Network Only</span>
                        @if (ProfileManager.CurrentProfile.RestrictToLocalNetwork) {
                            <span style="font-size: 9px; font-weight: 700; color: #f59e0b; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); padding: 1px 6px; border-radius: 4px;">PRIVATE (LAN ONLY)</span>
                        }
                    </div>
                    <div style="font-size: 11px; color: #64748b;">When enabled, website users outside your Wi-Fi/LAN see only a "Private Stream" banner</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.RestrictToLocalNetwork" @onchange="ToggleRestrictToLocalNetwork" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Stream URL Mount Point Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Live Stream URL Path</div>
                        <div style="font-size: 11px; color: #64748b;">Direct mount path for the live audio stream</div>
                    </div>
                    <span style="font-family: monospace; font-size: 12px; font-weight: 700; color: #10b981; background: #181b22; padding: 2px 8px; border-radius: 4px; border: 1px solid #2d3342;">
                        /@(GetNormalizedMount())
                    </span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 0 8px; flex: 1; min-width: 140px;">
                        <span style="color: #64748b; font-family: monospace; font-size: 12px; margin-right: 2px;">/</span>
                        <input type="text" class="scrim-input" style="border: none; background: transparent; padding: 6px 4px; font-family: monospace; font-size: 12px; color: #fff; width: 100%;" 
                               value="@ProfileManager.CurrentProfile.StreamMountPoint" 
                               @onchange="OnStreamMountPointChanged" 
                               placeholder="stream" />
                    </div>
                    <!-- Quick preset mount pills -->
                    <button class="pill-option @(GetNormalizedMount() == "stream" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("stream")'>stream</button>
                    <button class="pill-option @(GetNormalizedMount() == "live" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("live")'>live</button>
                    <button class="pill-option @(GetNormalizedMount() == "radio" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("radio")'>radio</button>
                    <button class="pill-option @(GetNormalizedMount() == "station" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("station")'>station</button>
                </div>
            </div>

            <!-- Connection URLs List -->
            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px;">
                <!-- Localhost -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Local Machine:</span>
                        <button style="background: none; border: none; color: #00d2ff; cursor: pointer; padding: 0; font-size: 10px;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")'>Open in Browser ↗</button>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #00d2ff; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                http://localhost:@(ProfileManager.CurrentProfile.Port)
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl($"http://localhost:{ProfileManager.CurrentProfile.Port}", "Local")'>
                            @(CopiedUrlTarget == "Local" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Local LAN -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Local Network (Wi-Fi / LAN):</span>
                        <span style="color: #64748b; font-size: 10px;">For home devices</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #00d2ff; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetLocalNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl(GetLocalNetworkUrl(), "LAN")'>
                            @(CopiedUrlTarget == "LAN" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Outside Network (Public IP) -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Outside Network (Internet):</span>
                        <span style="color: #64748b; font-size: 10px;">For remote listeners</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #10b981; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetOutsideNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl(GetOutsideNetworkUrl(), "WAN")'>
                            @(CopiedUrlTarget == "WAN" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Custom Public Domain / Host / IP (Optional) -->
                <div style="background: #14171d; border: 1px solid #252a35; border-radius: 6px; padding: 10px 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-size: 11px; font-weight: 600; color: #cbd5e1;">Custom Domain / Public Host (Optional)</span>
                        @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.CustomPublicUrl)) {
                            <button class="pill-option" style="padding: 1px 6px; font-size: 9px; color: #ef4444;" @onclick="ClearCustomPublicUrl" title="Reset to auto-detected public IP">✕ Reset</button>
                        }
                    </div>
                    <div style="font-size: 10px; color: #64748b; margin-bottom: 6px;">
                        Override public IP with your DDNS, domain name, or custom IP.
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 8px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 4px 8px; font-family: monospace; background: #0f1115; border-color: #2b303c;"
                               placeholder="@(ProfileManager.CurrentProfile.UseReverseProxy ? "e.g. radio.mydomain.com or 123.45.67.89" : "e.g. radio.mydomain.com:8080 or 123.45.67.89:8080")"
                               value="@ProfileManager.CurrentProfile.CustomPublicUrl"
                               @onchange="OnCustomPublicUrlChanged" />
                    </div>

                    <!-- HTTPS & Reverse Proxy Options -->
                    <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding-top: 6px; border-top: 1px solid #1f232c;">
                        <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: #cbd5e1; user-select: none;" title="Format generated share and VLC links with https:// instead of http://">
                            <input type="checkbox" style="accent-color: #00d2ff; cursor: pointer;"
                                   checked="@ProfileManager.CurrentProfile.UseHttps"
                                   @onchange="ToggleUseHttps" />
                            <span>Use HTTPS</span>
                            @if (ProfileManager.CurrentProfile.UseHttps) {
                                <span style="font-size: 8px; font-weight: 700; color: #10b981; background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); padding: 1px 4px; border-radius: 3px;">HTTPS</span>
                            }
                        </label>

                        <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: #cbd5e1; user-select: none;" title="Omit server port (e.g. :4242) from outside links when using Caddy, Nginx, or Cloudflare Tunnel">
                            <input type="checkbox" style="accent-color: #00d2ff; cursor: pointer;"
                                   checked="@ProfileManager.CurrentProfile.UseReverseProxy"
                                   @onchange="ToggleUseReverseProxy" />
                            <span>Using Reverse Proxy</span>
                            @if (ProfileManager.CurrentProfile.UseReverseProxy) {
                                <span style="font-size: 8px; font-weight: 700; color: #00d2ff; background: rgba(0,210,255,0.15); border: 1px solid rgba(0,210,255,0.4); padding: 1px 4px; border-radius: 3px;">NO PORT</span>
                            }
                        </label>
                    </div>
                </div>

                <!-- Direct Stream Endpoint for VLC / Media Players -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>VLC & Media Players Endpoint:</span>
                        <span style="color: #f59e0b; font-size: 10px;">Direct Audio Stream (/@(GetNormalizedMount()))</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden;">
                            <span style="font-family: monospace; font-size: 11px; color: #f59e0b; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @(GetOutsideNetworkUrl())/@(GetNormalizedMount())
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap; color: #f59e0b; border-color: rgba(245, 158, 11, 0.4);" @onclick='() => CopyUrl($"{GetOutsideNetworkUrl()}/{GetNormalizedMount()}", "VLC_Card")'>
                            @(CopiedUrlTarget == "VLC_Card" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>
            </div>

            <!-- UPnP & Router Status info -->
            <div style="background: #101217; border: 1px solid #1f232c; border-radius: 6px; padding: 8px 12px; font-size: 11px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: @(NetworkDiscovery.IsUpnpMapped ? "#10b981" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "#eab308" : "#64748b")); display: inline-block;"></span>
                    <span style="color: #94a3b8;">
                        UPnP Status: <strong style="color: @(NetworkDiscovery.IsUpnpMapped ? "#10b981" : "#cbd5e1");">@(NetworkDiscovery.IsUpnpMapped ? $"Port {ProfileManager.CurrentProfile.Port} Forwarded" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "Ready / Manual forwarding" : "Disabled"))</strong>
                    </span>
                </div>
                <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 10px;" @onclick="RefreshNetworkStatus">↻ Refresh</button>
            </div>
        </div>,

        "card-chat" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Live Station Chat
                    @if (ProfileManager.CurrentProfile.EnableChat) {
                        <span style="display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 9px; font-weight: 700; color: #10b981; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 4px;">ACTIVE</span>
                    } else {
                        <span style="display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 9px; font-weight: 700; color: #ef4444; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 4px;">PAUSED</span>
                    }
                </h3>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="pill-option" style="padding: 2px 8px; font-size: 10px; color: #f43f5e;" @onclick="ClearChat" title="Clear all chat history">🗑️ Clear</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <!-- Chat Broadcaster Controls -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 8px 12px; flex-wrap: wrap; gap: 8px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">Enable Listener Chat</div>
                    <div style="font-size: 10px; color: #64748b;">Allow web listeners to chat anonymously in real time</div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25);" @onclick="ClearChat" title="Clear all station chat history">🗑️ Clear Chat</button>
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #38bdf8; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25);" @onclick="@(() => ShowBlacklistManager = !ShowBlacklistManager)" title="Manage banned/blacklisted nicknames">🚫 Blacklist (@ProfileManager.CurrentProfile.NicknameBlacklist.Count)</button>
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25);" @onclick="@(() => ShowBansManager = !ShowBansManager)" title="Manage banned chat users">🔨 Bans (@ProfileManager.CurrentProfile.BannedUsers.Count)</button>
                    <label class="scrim-switch">
                        <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableChat" @onchange="ToggleChatEnabled" />
                        <span class="scrim-slider"></span>
                    </label>
                </div>
            </div>

            @if (ShowBlacklistManager) {
                <div style="background: #14171f; border: 1px solid #2a313e; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #38bdf8;">BANNED NICKNAME BLACKLIST</span>
                        <button class="scrim-dots-btn" @onclick="@(() => ShowBlacklistManager = false)" style="font-size: 10px;">✕</button>
                    </div>
                    <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 5px 8px; background: #0c0e12;" 
                               placeholder="Add word or phrase to block..." 
                               value="@NewBlacklistWord" 
                               @oninput="@((ChangeEventArgs e) => NewBlacklistWord = e.Value?.ToString() ?? "")"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") AddBlacklistWord(); })" />
                        <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 11px;" @onclick="AddBlacklistWord">+ Add</button>
                    </div>
                    @if (ProfileManager.CurrentProfile.NicknameBlacklist.Count == 0) {
                        <div style="font-size: 10px; color: #64748b; font-style: italic;">No blacklisted nicknames configured.</div>
                    } else {
                        <div style="display: flex; flex-wrap: wrap; gap: 5px; max-height: 90px; overflow-y: auto;">
                            @foreach (var banned in ProfileManager.CurrentProfile.NicknameBlacklist) {
                                <span style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; font-size: 10px; border-radius: 4px; padding: 2px 6px; display: inline-flex; align-items: center; gap: 4px;">
                                    @banned
                                    <button style="background: none; border: none; color: #f87171; cursor: pointer; padding: 0; font-size: 9px;" @onclick="@(() => RemoveBlacklistWord(banned))">✕</button>
                                </span>
                            }
                        </div>
                    }
                </div>
            }

            @if (ShowBansManager) {
                <div style="background: #14171f; border: 1px solid #382a32; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #f43f5e;">BANNED CHAT USERS</span>
                        <button class="scrim-dots-btn" @onclick="@(() => ShowBansManager = false)" style="font-size: 10px;">✕</button>
                    </div>
                    @if (ProfileManager.CurrentProfile.BannedUsers.Count == 0) {
                        <div style="font-size: 10px; color: #64748b; font-style: italic;">No users currently banned.</div>
                    } else {
                        <div style="display: flex; flex-direction: column; gap: 6px; max-height: 120px; overflow-y: auto;">
                            @foreach (var banned in ProfileManager.CurrentProfile.BannedUsers) {
                                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); border-radius: 4px; padding: 4px 8px; font-size: 10px;">
                                    <div>
                                        <strong style="color: #fca5a5;">@banned.Nickname</strong>
                                        <span style="color: #64748b; font-family: monospace; margin-left: 6px;">[@banned.UserId]</span>
                                    </div>
                                    <button class="pill-option" style="padding: 2px 6px; font-size: 9px; color: #34d399; background: rgba(52, 211, 153, 0.15); border: 1px solid rgba(52, 211, 153, 0.3);" @onclick="@(() => UnbanUser(banned.UserId))">Unban</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (ShowAssignNicknameModal && !string.IsNullOrEmpty(AssignTargetUser)) {
                <div style="background: #151922; border: 1px solid #38bdf8; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; box-shadow: 0 4px 14px rgba(0,0,0,0.5);">
                    <div style="font-size: 11px; font-weight: 700; color: #fff; margin-bottom: 4px;">
                        Assign Nickname to <span style="color: #38bdf8;">@AssignTargetUser</span>
                    </div>
                    <div style="font-size: 10px; color: #94a3b8; margin-bottom: 8px;">
                        The listener's active handle will update automatically. They can customize it anytime.
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 6px 8px; background: #0c0e12;" 
                               placeholder="Enter new nickname..." 
                               value="@NewAssignedNickname" 
                               @oninput="@((ChangeEventArgs e) => NewAssignedNickname = e.Value?.ToString() ?? "")"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") ConfirmAssignNickname(); })" />
                        <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 11px;" @onclick="ConfirmAssignNickname">Assign</button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="@(() => ShowAssignNicknameModal = false)">Cancel</button>
                    </div>
                </div>
            }

            <!-- Message Stream Viewport -->
            <div style="height: 260px; overflow-y: auto; scroll-behavior: smooth; background: #0c0e12; border: 1px solid #1f232c; border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;" id="consoleChatContainer">
                @if (ConsoleChatMessages.Count == 0) {
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #64748b; font-size: 11px; text-align: center; padding: 16px;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="1.5" style="margin-bottom: 6px;">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>No chat messages yet.</span>
                        <span style="font-size: 10px; color: #475569; margin-top: 2px;">Messages from web listeners and your host replies will appear here in real time.</span>
                    </div>
                } else {
                    @foreach (var msg in ConsoleChatMessages) {
                        <div style="background: @(msg.IsHost ? "rgba(239, 68, 68, 0.08)" : "#14171d"); border: 1px solid @(msg.IsHost ? "rgba(239, 68, 68, 0.3)" : "#232731"); border-radius: 6px; padding: 6px 10px; font-size: 11px; line-height: 1.4;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <strong style="color: @(msg.IsHost ? "#ef4444" : msg.Color); cursor: @(msg.IsHost ? "default" : "pointer");" 
                                            title="@(msg.IsHost ? "" : "Click to assign a nickname to this user")" 
                                            @onclick="@(() => { if (!msg.IsHost) OpenAssignNickname(msg.Sender); })">
                                        @msg.Sender @(msg.IsHost ? "" : "✏️")
                                    </strong>
                                    @if (msg.IsHost) {
                                        <span style="font-size: 9px; font-weight: 700; color: #fff; background: #ef4444; border-radius: 3px; padding: 1px 4px; letter-spacing: 0.5px;">DJ</span>
                                    } else {
                                        <button class="pill-option" style="padding: 1px 5px; font-size: 9px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); margin-left: 4px;" 
                                                title="Ban this user from chat" 
                                                @onclick="@(() => BanUserFromMessage(msg))">
                                            🚫 Ban
                                        </button>
                                    }
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 9px; color: #64748b; font-family: monospace;">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <button class="scrim-dots-btn" style="color: #94a3b8; font-size: 11px; padding: 0 4px; line-height: 1; border-radius: 4px;" 
                                            title="Delete this message" 
                                            @onclick="@(() => DeleteChatMessage(msg))">
                                        ✕
                                    </button>
                                </div>
                            </div>
                            <div style="color: #e2e8f0; word-break: break-word;">@LiveChatService.ConvertEmoticons(msg.Text)</div>
                        </div>
                    }
                }
            </div>

            <!-- Broadcaster Message Input -->
            <div style="position: relative;">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div style="position: relative; flex: 1; display: flex; align-items: center;">
                        <input type="text" class="scrim-input" style="width: 100%; font-size: 12px; padding: 8px 34px 8px 10px; background: #12141a; border-color: #2b303c;" 
                               placeholder="Reply to chat as DJ... (:O, :), :D autoconvert)" 
                               value="@HostChatMessage" 
                               @oninput="OnHostChatMessageInput"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") SendHostMessage(); })" />
                        <button type="button" style="position: absolute; right: 6px; background: transparent; border: none; font-size: 16px; cursor: pointer; padding: 2px 4px; border-radius: 4px; line-height: 1; opacity: 0.8;" 
                                title="Choose emoji" 
                                @onclick="ToggleHostEmojiPicker">
                            😊
                        </button>
                    </div>
                    <button class="scrim-btn-primary" style="padding: 8px 14px; font-size: 12px; white-space: nowrap; background: #ef4444; border-color: #ef4444;" @onclick="SendHostMessage">
                        Send 🎙️
                    </button>
                </div>

                @if (ShowHostEmojiPicker) {
                    <div style="position: absolute; bottom: 100%; left: 0; margin-bottom: 6px; background: #14171e; border: 1px solid #2b303d; border-radius: 8px; padding: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.6); z-index: 50; width: 280px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; font-weight: 700; color: #00d2ff;">
                            <span>EMOJIS</span>
                            <span style="font-size: 10px; color: #64748b; font-weight: normal;">:O converts to 😮</span>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; max-height: 140px; overflow-y: auto;">
                            @foreach (var emo in QuickEmojis) {
                                <button type="button" style="background: transparent; border: 1px solid transparent; font-size: 16px; cursor: pointer; padding: 4px; border-radius: 4px;" 
                                        @onclick="@(() => InsertHostEmoji(emo))">
                                    @emo
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 10px; color: #64748b;">
                <span>Sending as verified <strong>@(string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.HostName) ? "DJ" : $"{ProfileManager.CurrentProfile.HostName} [DJ]")</strong></span>
                <span>Press Enter to send</span>
            </div>
        </div>,

        "card-plugins" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <h3 class="scrim-card-title" style="margin: 0;">Plugins & Extensions</h3>
                    <span style="font-size: 11px; padding: 2px 7px; border-radius: 10px; background: rgba(139, 92, 246, 0.15); color: #c084fc; font-weight: 700;">
                        @PluginLoader.Plugins.Count(p => p.IsEnabled)/@PluginLoader.Plugins.Count Active
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-dots-btn" @onclick="ReloadPlugins" title="Reload & Rescan Plugins">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                        </svg>
                    </button>
                    <button class="scrim-dots-btn" @onclick="OpenPluginsFolder" title="Open Plugins Folder in File Explorer">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; max-height: 480px; overflow-y: auto; padding-right: 4px;">
                @if (PluginLoader.Plugins.Count == 0) {
                    <div style="text-align: center; padding: 24px 12px; color: #64748b; font-size: 12px;">
                        No plugins detected. Place plugin .dll assemblies into <code>~/.scrim/plugins/</code>.
                    </div>
                } else {
                    @foreach (var plugin in PluginLoader.Plugins) {
                        <div style="background: #14171e; border: 1px solid @(plugin.IsEnabled ? "rgba(139, 92, 246, 0.3)" : "#232731"); border-radius: 8px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; transition: border-color 0.2s ease;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 13px; font-weight: 600; color: #f1f5f9;">@plugin.Name</span>
                                    <span style="font-size: 9px; padding: 1px 5px; border-radius: 4px; background: @(plugin.IsEnabled ? "rgba(34, 197, 94, 0.15)" : "rgba(100, 116, 139, 0.2)"); color: @(plugin.IsEnabled ? "#4ade80" : "#94a3b8"); font-weight: 700;">
                                        @(plugin.IsEnabled ? "ON" : "OFF")
                                    </span>
                                </div>

                                <div style="font-size: 10px; color: #64748b; margin-top: 2px;">
                                    <span>v@(plugin.Version)</span>
                                    @if (!string.IsNullOrWhiteSpace(plugin.Author)) {
                                        <span> • @plugin.Author</span>
                                    }
                                </div>
                            </div>
                            <label class="scrim-switch" style="flex-shrink: 0;" title="@(plugin.IsEnabled ? "Click to Disable" : "Click to Enable")">
                                <input type="checkbox" checked="@plugin.IsEnabled" @onchange="@(() => TogglePlugin(plugin.Id))" />
                                <span class="scrim-slider"></span>
                            </label>
                        </div>
                    }
                }
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 11px;">
                <button class="pill-option" style="padding: 3px 10px; font-size: 10px; color: #c084fc; border-color: rgba(139, 92, 246, 0.3);" @onclick="OpenPluginsFolder">
                    📁 Open Folder
                </button>
                <button class="pill-option" style="padding: 3px 10px; font-size: 10px; color: #38bdf8;" @onclick="ReloadPlugins">
                    🔄 Rescan
                </button>
            </div>
        </div>,

        _ => @<div></div>
    };

