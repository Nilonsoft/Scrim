    private void OnMetadataReceived(object? sender, MediaMetadata meta) {
        InvokeAsync(() => {
            if (!string.IsNullOrWhiteSpace(meta.Title)) {
                bool trackChanged = !string.Equals(meta.Title, CurrentTrackTitle, StringComparison.OrdinalIgnoreCase) ||
                                    !string.Equals(meta.Artist, CurrentTrackArtist, StringComparison.OrdinalIgnoreCase);
                CurrentTrackTitle = meta.Title;
                CurrentTrackArtist = string.IsNullOrWhiteSpace(meta.Artist) ? "Live Stream" : meta.Artist;
                CurrentTrackExtra = string.IsNullOrWhiteSpace(meta.Album) ? "Broadcast Audio" : meta.Album;
                if (trackChanged) {
                    _broadcastTrackLog.Insert(0, (DateTime.Now, CurrentTrackTitle, CurrentTrackArtist));
                    if (_broadcastTrackLog.Count > 40) {
                        _broadcastTrackLog.RemoveAt(_broadcastTrackLog.Count - 1);
                    }
                }
                if (!string.IsNullOrEmpty(meta.AlbumArtBase64)) {
                    CurrentTrackAlbumArtBase64 = meta.AlbumArtBase64;
                } else if (trackChanged) {
                    CurrentTrackAlbumArtBase64 = null;
                }
                if (meta.Duration > TimeSpan.Zero) {
                    CurrentTrackDuration = meta.Duration;
                } else if (trackChanged) {
                    CurrentTrackDuration = TimeSpan.Zero;
                }
                double diff = (meta.Position - CurrentTrackPosition).TotalSeconds;
                if (trackChanged || Math.Abs(diff) > 2.5 || diff > 0.3 || !meta.IsPlaying) {
                    CurrentTrackPosition = meta.Position;
                    LastPositionUpdate = DateTimeOffset.UtcNow;
                }
                IsPlayingMedia = meta.IsPlaying;
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnCardDropped(int oldIndex, int newIndex, string sourceColId, string targetColId) {
        var sourceList = GetColumnList(sourceColId);
        var targetList = GetColumnList(targetColId);

        if (sourceList != null && targetList != null && oldIndex >= 0 && oldIndex < sourceList.Count) {
            var item = sourceList[oldIndex];
            sourceList.RemoveAt(oldIndex);
            
            if (newIndex >= targetList.Count) {
                targetList.Add(item);
            } else if (newIndex < 0) {
                targetList.Insert(0, item);
            } else {
                targetList.Insert(newIndex, item);
            }

            SaveCardLayout();
            InvokeAsync(StateHasChanged);
        }
    }

    private List<string>? GetColumnList(string colId) => colId switch {
        "col-left" => LeftColumn,
