        }
        <button class="scrim-no-drag" style="background: transparent; border: 1px dashed #2f3442; color: #727988; border-radius: 12px; padding: 10px; font-size: 12px; cursor: pointer; transition: all 0.2s ease; margin-top: 4px;" @onclick="@(() => ShowAddCardMenu = true)">+ Add Card</button>
    </div>

    <!-- CENTER COLUMN -->
    <div class="scrim-column" id="col-center">
        @foreach (var cardId in CenterColumn) {
            <div class="scrim-draggable-item" @key="cardId" id="@cardId">
                @RenderCard(cardId)
            </div>
        }
        <button class="scrim-no-drag" style="background: transparent; border: 1px dashed #2f3442; color: #727988; border-radius: 12px; padding: 10px; font-size: 12px; cursor: pointer; transition: all 0.2s ease; margin-top: 4px;" @onclick="@(() => ShowAddCardMenu = true)">+ Add Card</button>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="scrim-column" id="col-right">
        @foreach (var cardId in RightColumn) {
            <div class="scrim-draggable-item" @key="cardId" id="@cardId">
                @RenderCard(cardId)
            </div>
        }
        <button class="scrim-no-drag" style="background: transparent; border: 1px dashed #2f3442; color: #727988; border-radius: 12px; padding: 10px; font-size: 12px; cursor: pointer; transition: all 0.2s ease; margin-top: 4px;" @onclick="@(() => ShowAddCardMenu = true)">+ Add Card</button>
    </div>

</div>

@code {
    private List<string> LeftColumn = new();
    private List<string> CenterColumn = new();
    private List<string> RightColumn = new();

    private readonly Dictionary<string, string> AllAvailableCards = new() {
        { "card-audio-routing", "Audio Routing" },
        { "card-network-access", "Network & Internet Broadcasting" },
        { "card-playlist", "Playlist & Tracks" },
        { "card-vu-talk", "Master VU & Microphone" },
        { "card-voice-fx", "Phone-In Line & Voice FX" },
        { "card-queue", "Song Requests Queue" },
        { "card-chat", "Live Station Chat" },
        { "card-encoding", "Encoding & Broadcast" },
        { "card-media-player", "Media Player" },
        { "card-soundboard", "Soundboard" },
        { "card-web-branding", "Website Branding & Links" },
        { "card-plugins", "Plugins & Extensions" }
    };

    private bool ShowAddCardMenu = false;
    private bool ShowShareModal = false;
    private bool ShowPluginsModal = false;
    private string CopiedUrlTarget = "";
    private bool IsLive = false;
    private int ListenerCount => Hub.ActiveClientCount;
    private uint SelectedProcessId = 0;
    private string SelectedProcessDisplayName = "";
    private string SelectedDeviceId = "";
    private IEnumerable<WindowInfo> Windows = Array.Empty<WindowInfo>();
    private IEnumerable<MicrophoneDevice> Devices = Array.Empty<MicrophoneDevice>();
    private List<(string Id, string Name)> RenderDevices = new();
    private bool IsVirtualDeviceReady = false;
    private string? DetectedVirtualDeviceId;
    private string? DetectedVirtualDeviceName;
    private bool IsVbCableInstalled = false;
    private string? VbCableDeviceId;
    private string? VbCableDeviceName;
    private bool IsInstallingVirtualCable = false;
    private string? VirtualCableInstallStatus;
    private string? OriginalDefaultDeviceId;
    private string? OriginalDefaultDeviceName;
    private bool IsVirtualDeviceActive => 
        !string.IsNullOrEmpty(ProfileManager.CurrentProfile.CaptureDeviceId) &&
        (ProfileManager.CurrentProfile.CaptureDeviceId == VbCableDeviceId || ProfileManager.CurrentProfile.CaptureDeviceId == DetectedVirtualDeviceId);
    private bool IsSelectedMicVirtualCable {
        get {
            if (string.IsNullOrEmpty(SelectedDeviceId)) return false;
            var dev = Devices.FirstOrDefault(d => d.Id == SelectedDeviceId);
            if (dev == null) return false;
            return dev.Name.Contains("cable", StringComparison.OrdinalIgnoreCase) ||
                   dev.Name.Contains("vb-audio", StringComparison.OrdinalIgnoreCase) ||
                   dev.Name.Contains("virtual", StringComparison.OrdinalIgnoreCase);
        }
    }
    private readonly WindowEnumerator _enumerator = new();
    private DotNetObjectReference<Dashboard>? _dotNetRef;
    private System.Timers.Timer? _refreshTimer;
    private System.Timers.Timer? _vuTimer;
    private CancellationTokenSource? _broadcastCts;
    private int CustomBitrateInput = 128;
    private int CustomPortInput = 8080;
    private string PortChangeStatusMessage = "";
    private bool PortChangeSuccess = false;
    private string NewCustomSoundName = "";
    private string NewCustomSoundPath = "";

    // Media Player Live State
    private bool IsPlayingMedia = false;
    private string CurrentTrackTitle = "Awaiting Audio Source...";
    private string CurrentTrackArtist = "Scrim Broadcast";
    private string CurrentTrackExtra = "Live System Audio";
    private string? CurrentTrackAlbumArtBase64 = null;
    private TimeSpan CurrentTrackDuration = TimeSpan.Zero;
    private TimeSpan CurrentTrackPosition = TimeSpan.Zero;
    private DateTimeOffset LastPositionUpdate = DateTimeOffset.UtcNow;

    // Playlists
    private class PlaylistItem {
        public int Number { get; set; }
        public string Title { get; set; } = "";
        public string Artist { get; set; } = "";
        public string Duration { get; set; } = "";
        public bool IsPlaying { get; set; }
    }

    private List<PlaylistItem> PlaylistTracks = new() {
        new PlaylistItem { Number = 1, Title = "Contimwield", Artist = "Klin Spare", Duration = "11:00", IsPlaying = true },
        new PlaylistItem { Number = 2, Title = "Steel Lilyam", Artist = "Klin Spare", Duration = "12:30" },
        new PlaylistItem { Number = 3, Title = "Buarno Round", Artist = "Klin Spare", Duration = "13:05" },
        new PlaylistItem { Number = 4, Title = "Michari Balda", Artist = "Klin Spare", Duration = "14:30" }
    };

    private string NewTrackTitle = "";
    private string NewTrackArtist = "";
    private string NewTrackDuration = "03:45";

    protected override void OnInitialized() {
        RefreshWindows();
        Devices = MicService.GetDevices();
        RenderDevices = ProcessLoopbackCapture.GetRenderDevices().ToList();
        LocalAudioRouting.RestoreAllMuted();
        CheckVirtualDeviceStatus();

        // Load persisted card layout from current profile (card-playlist removed by default)
        var p = ProfileManager.CurrentProfile;
        if (p.LeftColumnCards?.Any() == true) {
            LeftColumn = new List<string>(p.LeftColumnCards);
        } else {
            LeftColumn = new() { "card-audio-routing", "card-network-access", "card-web-branding" };
        }

        if (p.CenterColumnCards?.Any() == true) {
            CenterColumn = new List<string>(p.CenterColumnCards);
        } else {
            CenterColumn = new() { "card-vu-talk", "card-voice-fx", "card-queue", "card-chat" };
        }

        if (p.RightColumnCards?.Any() == true) {
            RightColumn = new List<string>(p.RightColumnCards);
        } else {
            RightColumn = new() { "card-encoding", "card-media-player", "card-soundboard" };
        }

        // Subscribe to live Windows system media changes
        MetadataService.MetadataChanged += OnMetadataReceived;

        ConsoleChatMessages = ChatService.GetRecentMessages().ToList();
        ChatService.MessagePosted += OnChatMessageReceived;
        ChatService.MessageRemoved += OnChatMessageRemoved;
        ChatService.ChatCleared += OnChatCleared;
        ChatService.ChatStatusChanged += OnChatStatusChanged;
        ChatService.UserBanned += OnUserBanned;
        ReactionService.ReactionReceived += OnReactionReceived;
        ReactionService.CountsReset += OnReactionCountsReset;
        HistoryService.HistoryChanged += OnHistoryChanged;
        PluginLoader.PluginsChanged += OnPluginsChanged;

        if (!string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Title)) {
            CurrentTrackTitle = MetadataService.CurrentMetadata.Title;
            CurrentTrackArtist = string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Artist) ? "Live Stream" : MetadataService.CurrentMetadata.Artist;
            CurrentTrackExtra = string.IsNullOrWhiteSpace(MetadataService.CurrentMetadata.Album) ? "Broadcast Audio" : MetadataService.CurrentMetadata.Album;
            CurrentTrackAlbumArtBase64 = MetadataService.CurrentMetadata.AlbumArtBase64;
            CurrentTrackDuration = MetadataService.CurrentMetadata.Duration;
            CurrentTrackPosition = MetadataService.CurrentMetadata.Position;
            LastPositionUpdate = DateTimeOffset.UtcNow;
            IsPlayingMedia = MetadataService.CurrentMetadata.IsPlaying;
        }

        // Restore user choices from persisted profile
        if (!string.IsNullOrEmpty(p.SelectedMicrophoneId) && Devices.Any(d => d.Id == p.SelectedMicrophoneId)) {
            SelectedDeviceId = p.SelectedMicrophoneId;
        } else if (!string.IsNullOrEmpty(p.SelectedMicrophoneName) && Devices.Any(d => string.Equals(d.Name, p.SelectedMicrophoneName, StringComparison.OrdinalIgnoreCase))) {
            var dev = Devices.FirstOrDefault(d => string.Equals(d.Name, p.SelectedMicrophoneName, StringComparison.OrdinalIgnoreCase));
            SelectedDeviceId = dev?.Id ?? "";
            p.SelectedMicrophoneId = SelectedDeviceId;
            ProfileManager.SaveProfile(p);
        } else if (string.IsNullOrEmpty(p.SelectedMicrophoneId)) {
            SelectedDeviceId = "";
        } else if (string.IsNullOrEmpty(SelectedDeviceId) && Devices.Any()) {
            var physicalMic = Devices.FirstOrDefault(d => !d.Name.Contains("cable", StringComparison.OrdinalIgnoreCase) &&
                                                          !d.Name.Contains("vb-audio", StringComparison.OrdinalIgnoreCase) &&
                                                          !d.Name.Contains("virtual", StringComparison.OrdinalIgnoreCase));
            SelectedDeviceId = physicalMic?.Id ?? Devices.First().Id;
            p.SelectedMicrophoneId = SelectedDeviceId;
            p.SelectedMicrophoneName = physicalMic?.Name ?? Devices.First().Name;
            ProfileManager.SaveProfile(p);
        }

        if (!string.IsNullOrEmpty(p.SelectedVoiceEffect)) {
            MicService.CurrentEffect = p.SelectedVoiceEffect;
        }

        if (Enum.TryParse<MicControlMode>(p.MicControlMode, true, out var savedMode)) {
            Mixer.ControlMode = savedMode;
        }

        if (p.MicMonitoring) {
            MicService.IsMonitoring = true;
        }

        // Auto-select target window by saved name/ID if available, or default to system audio
        WindowInfo? initialWin = null;
        if (!string.IsNullOrEmpty(p.TargetProcessName) && !p.TargetProcessName.Equals("System Audio", StringComparison.OrdinalIgnoreCase)) {
            initialWin = Windows.FirstOrDefault(w => string.Equals(w.ProcessName, p.TargetProcessName, StringComparison.OrdinalIgnoreCase))
                      ?? Windows.FirstOrDefault(w => w.Title.Contains(p.TargetProcessName, StringComparison.OrdinalIgnoreCase));
        }
        if (initialWin == null && p.TargetProcessId > 0) {
            initialWin = Windows.FirstOrDefault(w => w.ProcessId == (uint)p.TargetProcessId);
        }

        if (initialWin != null) {
            SelectedProcessId = initialWin.ProcessId;
            SelectedProcessDisplayName = !string.IsNullOrEmpty(initialWin.ProcessName) ? initialWin.ProcessName : initialWin.Title;
            MetadataService.StartMonitoring(SelectedProcessId);
            EnsureAudioMonitoring(SelectedProcessId);
        } else if (!string.IsNullOrEmpty(p.TargetProcessName) && !p.TargetProcessName.Equals("System Audio", StringComparison.OrdinalIgnoreCase)) {
            SelectedProcessId = (uint)(p.TargetProcessId > 0 ? p.TargetProcessId : 999999);
            SelectedProcessDisplayName = p.TargetProcessName;
            EnsureAudioMonitoring(0);
        } else {
            SelectedProcessId = 0;
            SelectedProcessDisplayName = "System Audio";
            EnsureAudioMonitoring(0);
        }

        // Restore and ensure Virtual Cable or selected audio device routing if previously configured
        if (!string.IsNullOrEmpty(p.CaptureDeviceId)) {
            if (!RenderDevices.Any(d => d.Id == p.CaptureDeviceId)) {
                if (!string.IsNullOrEmpty(p.CaptureDeviceName)) {
                    var matched = RenderDevices.FirstOrDefault(d => string.Equals(d.Name, p.CaptureDeviceName, StringComparison.OrdinalIgnoreCase));
                    if (matched.Id != null) {
                        p.CaptureDeviceId = matched.Id;
                        ProfileManager.SaveProfile(p);
                    }
                }
                if (!RenderDevices.Any(d => d.Id == p.CaptureDeviceId)) {
                    if (IsVbCableInstalled && !string.IsNullOrEmpty(VbCableDeviceId)) {
                        p.CaptureDeviceId = VbCableDeviceId;
                        ProfileManager.SaveProfile(p);
                    } else if (IsVirtualDeviceReady && !string.IsNullOrEmpty(DetectedVirtualDeviceId)) {
                        p.CaptureDeviceId = DetectedVirtualDeviceId;
                        ProfileManager.SaveProfile(p);
                    }
                }
            }
        }
        MicService.SetVirtualOutputDevice(null);

        Mixer.AppVolume = (float)ProfileManager.CurrentProfile.AppStreamVolume / 100f;
        CustomBitrateInput = ProfileManager.CurrentProfile.Bitrate;
        CustomPortInput = ProfileManager.CurrentProfile.Port;

        // Ensure Web Player HTTP server is running so listeners can always view the station
        try {
            StreamServer.Start(ProfileManager.CurrentProfile.Port);
        } catch { }

        IsLive = Hub.IsBroadcasting;
        Hub.BroadcastingStateChanged += OnHubBroadcastingStateChanged;

        if (!FFmpegService.IsInstalled) {
            ShowFFmpegModal = true;
        }

        if (p.BroadcastOnOpen && !IsLive) {
            StartBroadcast();
        }

        Task.Run(async () => {
            await NetworkDiscovery.RefreshPublicIpAsync();
            await InvokeAsync(StateHasChanged);
        });

        // Periodic UI poll for active listener updates, active applications, and track progress
        _refreshTimer = new System.Timers.Timer(1000);
        _refreshTimer.Elapsed += (s, e) => {
            RefreshWindows();
            if (IsPlayingMedia && CurrentTrackDuration > TimeSpan.Zero) {
                var now = DateTimeOffset.UtcNow;
                var delta = now - LastPositionUpdate;
                if (delta >= TimeSpan.FromSeconds(0.7)) {
                    CurrentTrackPosition += delta;
                    if (CurrentTrackPosition > CurrentTrackDuration) {
                        CurrentTrackPosition = CurrentTrackDuration;
                    }
                    LastPositionUpdate = now;
                }
            }
            InvokeAsync(StateHasChanged);
        };
        _refreshTimer.Start();

        // High-frequency real audio level update for analog VU meters and broadcast stream out (50ms)
        _vuTimer = new System.Timers.Timer(50);
        _vuTimer.Elapsed += async (s, e) => {
            try {
                float left = Mixer.LeftLevel;
                float right = Mixer.RightLevel;
                float mic = MicService.InputLevel;
                bool isLive = IsLive;
                await InvokeAsync(async () => {
                    try {
                        await JSRuntime.InvokeVoidAsync("scrimDragDrop.setStreamOutLevels", left, right, mic, isLive);
                    } catch { }
                });
            } catch { }
        };
        _vuTimer.Start();
    }

    private void OnProcessChanged() {
        if (SelectedProcessId != 0) {
            var win = Windows.FirstOrDefault(w => w.ProcessId == SelectedProcessId);
            ProfileManager.CurrentProfile.TargetProcessId = (int)SelectedProcessId;
            if (win != null) {
                SelectedProcessDisplayName = !string.IsNullOrEmpty(win.ProcessName) ? win.ProcessName : win.Title;
                ProfileManager.CurrentProfile.TargetProcessName = SelectedProcessDisplayName;
            }
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
            MetadataService.StartMonitoring(SelectedProcessId);
            EnsureAudioMonitoring(SelectedProcessId);
        } else {
            SelectedProcessDisplayName = "System Audio";
            ProfileManager.CurrentProfile.TargetProcessId = 0;
            ProfileManager.CurrentProfile.TargetProcessName = "System Audio";
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
            MetadataService.StartMonitoring(0);
            EnsureAudioMonitoring(0);
        }
    }

    private void OnCaptureDeviceChanged() {
        ProfileManager.CurrentProfile.CaptureDeviceName = RenderDevices.FirstOrDefault(d => d.Id == ProfileManager.CurrentProfile.CaptureDeviceId).Name ?? "";
        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
        MicService.SetVirtualOutputDevice(null);
        EnsureAudioMonitoring(SelectedProcessId);
        StateHasChanged();
    }

    private void EnsureAudioMonitoring(uint pid) {
        try {
            string? captureDevice = ProfileManager.CurrentProfile.CaptureDeviceId;
            Capture.StartCapture(pid, captureDevice);
            MicService.StartCapture(SelectedDeviceId);
            MicService.SetVirtualOutputDevice(null);
            if (!Mixer.IsMixing) {
                Mixer.StartMixing(Capture.AudioStream, MicService.MicrophoneStream, CancellationToken.None);
            }
        } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("scrimDragDrop.init", new[] { "col-left", "col-center", "col-right" }, _dotNetRef);
            if (ConsoleChatMessages.Count > 0) {
                await AutoScrollChatAsync();
            }
        }
    }

    private void OnMetadataReceived(object? sender, MediaMetadata meta) {
        InvokeAsync(() => {
            if (!string.IsNullOrWhiteSpace(meta.Title)) {
                bool trackChanged = !string.Equals(meta.Title, CurrentTrackTitle, StringComparison.OrdinalIgnoreCase) ||
                                    !string.Equals(meta.Artist, CurrentTrackArtist, StringComparison.OrdinalIgnoreCase);
                CurrentTrackTitle = meta.Title;
                CurrentTrackArtist = string.IsNullOrWhiteSpace(meta.Artist) ? "Live Stream" : meta.Artist;
                CurrentTrackExtra = string.IsNullOrWhiteSpace(meta.Album) ? "Broadcast Audio" : meta.Album;
                if (!string.IsNullOrEmpty(meta.AlbumArtBase64)) {
                    CurrentTrackAlbumArtBase64 = meta.AlbumArtBase64;
                } else if (trackChanged) {
                    CurrentTrackAlbumArtBase64 = null;
                }
                if (meta.Duration > TimeSpan.Zero) {
                    CurrentTrackDuration = meta.Duration;
                } else if (trackChanged) {
                    CurrentTrackDuration = TimeSpan.Zero;
                }
                double diff = (meta.Position - CurrentTrackPosition).TotalSeconds;
                if (trackChanged || Math.Abs(diff) > 2.5 || diff > 0.3 || !meta.IsPlaying) {
                    CurrentTrackPosition = meta.Position;
                    LastPositionUpdate = DateTimeOffset.UtcNow;
                }
                IsPlayingMedia = meta.IsPlaying;
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnCardDropped(int oldIndex, int newIndex, string sourceColId, string targetColId) {
        var sourceList = GetColumnList(sourceColId);
        var targetList = GetColumnList(targetColId);

        if (sourceList != null && targetList != null && oldIndex >= 0 && oldIndex < sourceList.Count) {
            var item = sourceList[oldIndex];
            sourceList.RemoveAt(oldIndex);
            
            if (newIndex >= targetList.Count) {
                targetList.Add(item);
            } else if (newIndex < 0) {
                targetList.Insert(0, item);
            } else {
                targetList.Insert(newIndex, item);
            }

            SaveCardLayout();
            InvokeAsync(StateHasChanged);
        }
    }

