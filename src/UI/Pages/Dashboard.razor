                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="font-size: 11px; color: #94a3b8; margin-bottom: 10px; line-height: 1.4;">
                Configure broadcast category crates (bins) and enforce radio automation separation rules for clockwheel queue generation.
            </div>

            <!-- Master Enforce Switch -->
            <div style="background: #0d121c; border: 1px solid #1a2336; border-radius: 8px; padding: 8px 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 11px; font-weight: 700; color: #e2e8f0;">Enforce Rotation Rules</div>
                    <div style="font-size: 9px; color: #64748b;">Block repeat artists and tracks within separation windows</div>
                </div>
                <button class="pill-option @(ProfileManager.CurrentProfile.RotationRules.Enabled ? "active" : "")"
                        style="padding: 2px 10px; font-size: 10px;"
                        @onclick="ToggleRotationRulesEnabled">
                    @(ProfileManager.CurrentProfile.RotationRules.Enabled ? "ARMED / ON" : "BYPASSED")
                </button>
            </div>

            <!-- Category Bins (Interactive Crates) -->
            <div style="margin-bottom: 6px; font-size: 11px; font-weight: 700; color: #cbd5e1; display: flex; justify-content: space-between; align-items: center;">
                <span>Category Bins (Click to Select &amp; Edit)</span>
                <span style="font-size: 9px; color: #94a3b8;">@(GetSelectedBinTracks().Count) tracks in selected bin</span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px;">
                <div style="background: @(_activeCategoryBin == "heavy" ? "rgba(0, 210, 255, 0.14)" : "#0e121a"); border: 1px solid @(_activeCategoryBin == "heavy" ? "#00d2ff" : "#1c2333"); border-radius: 6px; padding: 6px 8px; cursor: pointer; transition: all 0.15s;"
                     @onclick='() => _activeCategoryBin = "heavy"'>
                    <div style="font-size: 10px; font-weight: 700; color: #00d2ff; display: flex; justify-content: space-between; align-items: center;">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 4px;">@GetBinTitle("heavy")</span>
                        <span style="font-size: 9px; background: rgba(0, 210, 255, 0.2); padding: 0 4px; border-radius: 3px; flex-shrink: 0;">@ProfileManager.CurrentProfile.RotationRules.HeavyRotationTracks.Count</span>
                    </div>
                    <div style="font-size: 9px; color: #64748b;">Power currents • 30m</div>
                </div>

                <div style="background: @(_activeCategoryBin == "medium" ? "rgba(16, 185, 129, 0.14)" : "#0e121a"); border: 1px solid @(_activeCategoryBin == "medium" ? "#10b981" : "#1c2333"); border-radius: 6px; padding: 6px 8px; cursor: pointer; transition: all 0.15s;"
                     @onclick='() => _activeCategoryBin = "medium"'>
                    <div style="font-size: 10px; font-weight: 700; color: #10b981; display: flex; justify-content: space-between; align-items: center;">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 4px;">@GetBinTitle("medium")</span>
                        <span style="font-size: 9px; background: rgba(16, 185, 129, 0.2); padding: 0 4px; border-radius: 3px; flex-shrink: 0;">@ProfileManager.CurrentProfile.RotationRules.RecentsTracks.Count</span>
                    </div>
                    <div style="font-size: 9px; color: #64748b;">Recent hits • 60m</div>
                </div>

                <div style="background: @(_activeCategoryBin == "gold" ? "rgba(245, 158, 11, 0.14)" : "#0e121a"); border: 1px solid @(_activeCategoryBin == "gold" ? "#f59e0b" : "#1c2333"); border-radius: 6px; padding: 6px 8px; cursor: pointer; transition: all 0.15s;"
                     @onclick='() => _activeCategoryBin = "gold"'>
                    <div style="font-size: 10px; font-weight: 700; color: #f59e0b; display: flex; justify-content: space-between; align-items: center;">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 4px;">@GetBinTitle("gold")</span>
                        <span style="font-size: 9px; background: rgba(245, 158, 11, 0.2); padding: 0 4px; border-radius: 3px; flex-shrink: 0;">@ProfileManager.CurrentProfile.RotationRules.ClassicGoldTracks.Count</span>
                    </div>
                    <div style="font-size: 9px; color: #64748b;">Recurrent library • 120m</div>
                </div>

                <div style="background: @(_activeCategoryBin == "sweepers" ? "rgba(236, 72, 153, 0.14)" : "#0e121a"); border: 1px solid @(_activeCategoryBin == "sweepers" ? "#ec4899" : "#1c2333"); border-radius: 6px; padding: 6px 8px; cursor: pointer; transition: all 0.15s;"
                     @onclick='() => _activeCategoryBin = "sweepers"'>
                    <div style="font-size: 10px; font-weight: 700; color: #ec4899; display: flex; justify-content: space-between; align-items: center;">
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 4px;">@GetBinTitle("sweepers")</span>
                        <span style="font-size: 9px; background: rgba(236, 72, 153, 0.2); padding: 0 4px; border-radius: 3px; flex-shrink: 0;">@ProfileManager.CurrentProfile.RotationRules.JingleTracks.Count</span>
                    </div>
                    <div style="font-size: 9px; color: #64748b;">Top-of-hour promos</div>
                </div>
            </div>

            <!-- Active Bin Track Inspector & Editor -->
            <div style="background: #080b11; border: 1px solid @GetActiveBinColor(); border-radius: 8px; padding: 10px; margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                    <div style="display: flex; align-items: center; gap: 6px; flex: 1; min-width: 170px;">
                        <span style="font-size: 11px;">📂</span>
                        <input type="text"
                               class="scrim-input"
                               style="font-size: 11px; font-weight: 700; color: @GetActiveBinColor(); background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.15); padding: 2px 6px; height: 23px; border-radius: 4px; width: 100%; max-width: 200px;"
                               value="@GetActiveBinTitle()"
                               @oninput="OnActiveBinTitleChanged"
                               placeholder="Category Title"
                               title="Click to rename this category bin" />
                        <span style="font-size: 10px; color: #64748b;" title="Click to rename this category bin">✏️</span>
                    </div>
                    <div style="display: flex; gap: 6px;">
                        @if (!string.IsNullOrWhiteSpace(CurrentTrackTitle)) {
                            <button class="scrim-btn-secondary" style="padding: 2px 7px; font-size: 9px;"
                                    title="Add currently playing track to this bin"
                                    @onclick="AddCurrentPlayingTrackToActiveBin">
                                📥 + Now Playing
                            </button>
                        }
                        @if (PlaylistTracks.Count > 0) {
                            <button class="scrim-btn-secondary" style="padding: 2px 7px; font-size: 9px;"
                                    title="Import all tracks from console playlist into this bin"
                                    @onclick="ImportPlaylistToActiveBin">
                                📋 + Import Playlist
                            </button>
                        }
                        @if (GetSelectedBinTracks().Count > 0) {
                            <button class="scrim-btn-secondary" style="padding: 2px 7px; font-size: 9px; color: #ef4444;"
                                    title="Clear all tracks in this bin"
                                    @onclick="ClearActiveBin">
                                🗑️ Clear
                            </button>
                        }
                    </div>
                </div>

                <!-- Track List -->
                <div style="background: #05070a; border: 1px solid #141924; border-radius: 6px; height: 115px; overflow-y: auto; padding: 4px 6px; display: flex; flex-direction: column; gap: 3px; margin-bottom: 8px;">
                    @if (GetSelectedBinTracks().Count == 0) {
                        <div style="color: #64748b; font-size: 10px; text-align: center; padding-top: 36px; font-style: italic;">
                            No tracks in this bin yet. Type a track below or import from your playlist.
                        </div>
                    } else {
                        var binTracks = GetSelectedBinTracks();
                        for (int i = 0; i < binTracks.Count; i++) {
                            var trackItem = binTracks[i];
                            int idx = i;
                            <div style="display: flex; justify-content: space-between; align-items: center; background: #0c1017; border: 1px solid #182030; border-radius: 4px; padding: 3px 6px; font-size: 10.5px;">
                                <span style="color: #64748b; font-family: monospace; font-size: 9.5px; width: 18px;">@(idx + 1).</span>
                                <span style="color: #e2e8f0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 6px;">@trackItem</span>
                                <button style="background: transparent; border: none; color: #ef4444; cursor: pointer; font-size: 11px; padding: 0 4px;"
                                        title="Remove from bin"
                                        @onclick="@(() => RemoveTrackFromActiveBin(trackItem))">
                                    ✕
                                </button>
                            </div>
                        }
                    }
                </div>

                <!-- Add Track Bar -->
                <div style="display: flex; gap: 6px;">
                    <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 4px 8px;"
                           placeholder="Enter track: Artist - Title (or file path)"
                           @bind="_newCategoryTrackText"
                           @bind:event="oninput"
                           @onkeydown="@(e => { if (e.Key == "Enter") AddTrackToActiveBin(); })" />
                    <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 11px; white-space: nowrap;"
                            @onclick="AddTrackToActiveBin">
                        + Add Track
                    </button>
                </div>
            </div>

            <!-- Separation Rules Sliders & Clockwheel Template -->
            <div style="background: #080b10; border: 1px solid #151a24; border-radius: 6px; padding: 10px; margin-bottom: 10px;">
                <div style="font-size: 10px; font-weight: 700; color: #cbd5e1; margin-bottom: 8px;">
                    ⏱️ Separation Rules &amp; Clockwheel Format
                </div>

                <!-- Artist Separation -->
                <div style="margin-bottom: 8px;">
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Artist Separation Limit:</span>
                        <span style="color: #00d2ff; font-weight: 700;">@ProfileManager.CurrentProfile.RotationRules.ArtistSeparationMinutes min</span>
                    </div>
                    <input type="range" min="15" max="180" step="5" style="width: 100%; accent-color: #00d2ff; height: 4px;"
                           value="@ProfileManager.CurrentProfile.RotationRules.ArtistSeparationMinutes"
                           @oninput="OnArtistSeparationChanged" />
                </div>

                <!-- Track Separation -->
                <div style="margin-bottom: 8px;">
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Track Repeat Separation Limit:</span>
                        <span style="color: #10b981; font-weight: 700;">@ProfileManager.CurrentProfile.RotationRules.TrackSeparationMinutes min</span>
                    </div>
                    <input type="range" min="30" max="360" step="15" style="width: 100%; accent-color: #10b981; height: 4px;"
                           value="@ProfileManager.CurrentProfile.RotationRules.TrackSeparationMinutes"
                           @oninput="OnTrackSeparationChanged" />
                </div>

                <!-- Clockwheel Template -->
                <div>
                    <label class="scrim-label" style="font-size: 10px; margin-bottom: 3px;">Clockwheel Sequence Template</label>
                    <input type="text" class="scrim-input" style="font-size: 11px; padding: 4px 8px;"
                           @bind="ProfileManager.CurrentProfile.RotationRules.ClockWheelTemplate"
                           @bind:event="oninput"
                           @bind:after="SaveRotationRules"
                           placeholder="e.g. 2 A-List -> 1 Jingle -> 1 Gold -> 1 B-List" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_rotationStatusMessage)) {
                <div style="font-size: 10px; color: #38bdf8; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 4px; padding: 5px 8px; margin-bottom: 8px; text-align: center;">
                    @_rotationStatusMessage
                </div>
            }

            <button class="scrim-btn-primary" style="width: 100%; font-size: 11px; padding: 8px;" @onclick="GenerateClockWheelQueue">
                ⚡ Generate 1-Hour Clock Sequence
            </button>
        </div>,

        "card-stream-relay" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="2"></circle>
                        <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
                    </svg>
                    Stream Relaying & Multi-DJ Party Hub
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="font-size: 10px; color: #94a3b8; margin-bottom: 10px;">
                Relay remote sister stations, party co-hosts, or guest DJs. Scrim broadcasts auto-detect DJ name, bio & avatar.
            </div>

            @if (!string.IsNullOrEmpty(_relayAlertMessage)) {
                <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 6px; padding: 6px 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #fca5a5;">
                    <span>@_relayAlertMessage</span>
                    <button style="background: none; border: none; color: #fca5a5; cursor: pointer; font-size: 12px; font-weight: bold;" @onclick="@(() => _relayAlertMessage = "")">✕</button>
                </div>
            }

            <!-- Party Hub Quick Controls: B2B Crossfade & Green Room Talkback -->
            <div style="background: #0d121c; border: 1px solid #1a2336; border-radius: 8px; padding: 10px; margin-bottom: 12px; display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: #00d2ff; display: flex; align-items: center; gap: 6px;">
                        <span>🎛️ B2B Stage & Intercom</span>
                    </span>
                    <button class="pill-option @(Mixer.TalkbackActive ? "active" : "")"
                            style="padding: 3px 10px; font-size: 10px; font-weight: 700; @(Mixer.TalkbackActive ? "background: #8b5cf6; border-color: #8b5cf6; color: white;" : "color: #a78bfa; border-color: rgba(139, 92, 246, 0.4);")"
                            title="When active, host microphone is muted from the master broadcast so you can talk to guest DJs privately"
                            @onclick="@(() => Mixer.TalkbackActive = !Mixer.TalkbackActive)">
                        🎙️ @(Mixer.TalkbackActive ? "TALKBACK ACTIVE (OFF-AIR)" : "TALKBACK (GREEN ROOM)")
                    </button>
                </div>
                <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                    <span style="font-size: 10px; color: #94a3b8; font-weight: 600;">Automated Crossfade:</span>
                    <button class="pill-option" style="padding: 3px 8px; font-size: 10px; background: rgba(0, 210, 255, 0.15); border-color: #00d2ff; color: #00d2ff; font-weight: 700;"
                            title="Smoothly fade host app volume down and fade guest stream up over 8 seconds"
                            @onclick="@(() => Mixer.StartB2bCrossfade(1.0f, 0.0f, 8000))">
                        ⚡ Hand-Off to Guest (8s)
                    </button>
                    <button class="pill-option" style="padding: 3px 8px; font-size: 10px; background: rgba(16, 185, 129, 0.15); border-color: #10b981; color: #10b981; font-weight: 700;"
                            title="Smoothly fade guest stream down and fade host volume back up over 8 seconds"
                            @onclick="@(() => Mixer.StartB2bCrossfade(0.0f, 1.0f, 8000))">
                        ⚡ Take Back Decks (8s)
                    </button>
                    <span style="font-size: 9px; color: #64748b; margin-left: auto;">
                        Host: @((int)(Mixer.AppVolume * 100))% | Guest: @((int)(Mixer.RelayVolume * 100))%
                    </span>
                </div>
            </div>

            <!-- Backstage DJ & Green Room Private Chat (Private to Hosts & Guest DJs) -->
            <div style="background: #0d121c; border: 1px solid #1a2336; border-radius: 8px; padding: 10px; margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: #a855f7; display: flex; align-items: center; gap: 6px;">
                        <span>💬 Backstage DJ &amp; Green Room Chat</span>
                    </span>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <button class="pill-option" style="padding: 2px 7px; font-size: 9px; background: rgba(168, 85, 247, 0.25); border-color: #a855f7; color: #e9d5ff; font-weight: 600; cursor: pointer;"
                                title="Open Green Room Backstage in a new browser window automatically logged in as Host"
                                @onclick="OpenHostGreenRoomInBrowser">
                            ↗ Pop Out Chat
                        </button>
                        <span style="font-size: 9px; font-weight: 700; color: #a855f7; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); padding: 1px 6px; border-radius: 4px;">
                            PRIVATE / DJS ONLY
                        </span>
                    </div>
                </div>

                <!-- Green Room Passcode & Invite Link Bar -->
                <div style="background: #080a10; border: 1px solid #1e1b4b; border-radius: 6px; padding: 6px 8px; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 10px; color: #c084fc; font-weight: 600;">🔑 Green Room PIN:</span>
                        <input type="text" class="scrim-input" style="font-size: 11px; width: 95px; padding: 2px 6px; font-weight: 700; color: #e9d5ff; background: #131127; border-color: #581c87;"
                               value="@ProfileManager.CurrentProfile.GreenRoomPasscode"
                               @onchange="OnGreenRoomPasscodeChanged"
                               placeholder="Passcode"
                               title="Set custom passcode required for guest DJs to enter the Green Room" />
                        <button class="pill-option" style="padding: 2px 6px; font-size: 9px; background: rgba(168, 85, 247, 0.15); border-color: #a855f7; color: #c084fc;"
                                title="Generate a random passcode"
                                @onclick="GenerateRandomGreenRoomPasscode">
                            🎲
                        </button>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <button class="pill-option" style="padding: 3px 9px; font-size: 9px; background: linear-gradient(135deg, rgba(168, 85, 247, 0.35) 0%, rgba(124, 58, 237, 0.35) 100%); border-color: #a855f7; color: #ffffff; font-weight: 700; cursor: pointer;"
                                title="Open Green Room Backstage in a new browser window automatically logged in as Host"
                                @onclick="OpenHostGreenRoomInBrowser">
                            🚀 Open Green Room Window
                        </button>
                        <button class="pill-option" style="padding: 3px 8px; font-size: 9px; background: rgba(168, 85, 247, 0.2); border-color: #a855f7; color: #e9d5ff; font-weight: 600;"
                                title="Copy mobile-friendly Backstage Portal URL with PIN to clipboard"
                                @onclick="CopyGreenRoomInviteUrl">
                            @(CopiedUrlTarget == "greenroom" ? "✓ Copied Invite!" : "📋 Copy DJ Invite Link")
                        </button>
                    </div>
                </div>

                <div style="background: #080a10; border: 1px solid #151a24; border-radius: 6px; height: 120px; overflow-y: auto; padding: 6px 8px; display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px;">
                    @if (_greenRoomMessages.Count == 0) {
                        <div style="color: #64748b; font-size: 10px; text-align: center; padding-top: 36px; font-style: italic;">
                            No backstage messages yet. Send private cues, BPM notes, or hand-off timings to co-hosts.
                        </div>
                    } else {
                        @foreach (var msg in _greenRoomMessages) {
                            <div style="font-size: 11px; line-height: 1.35; display: flex; gap: 6px; align-items: baseline;">
                                <span style="font-size: 9px; color: #64748b; font-family: monospace;">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                <span style="font-weight: 700; color: @(msg.IsHost ? "#a855f7" : (string.IsNullOrWhiteSpace(msg.Color) ? "#00d2ff" : msg.Color));">@msg.Sender:</span>
                                <span style="color: #e2e8f0; word-break: break-word;">@msg.Text</span>
                            </div>
                        }
                    }
                </div>

                <div style="display: flex; gap: 6px;">
                    <input type="text" class="scrim-input" style="font-size: 11px; flex: 1;" placeholder="Private note to DJs... (Enter to send)"
                           @bind="_newGreenRoomChatText" @bind:event="oninput" @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") SendGreenRoomMessage(); })" />
                    <button class="scrim-btn-primary" style="font-size: 11px; padding: 4px 12px; background: #8b5cf6; border-color: #8b5cf6;"
                            @onclick="SendGreenRoomMessage" disabled="@string.IsNullOrWhiteSpace(_newGreenRoomChatText)">
                        Send 💬
                    </button>
                </div>
            </div>

            <!-- Existing Streams List -->
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
                @if (RelayService.Streams.Count == 0) {
                    <div style="text-align: center; padding: 14px 8px; background: #0c0f16; border: 1px dashed #202738; border-radius: 8px; font-size: 11px; color: #64748b;">
                        No remote streams configured. Add a stream below to start relaying.
                    </div>
                }
                @foreach (var stream in RelayService.Streams) {
                    <div style="background: #10141e; border: 1px solid @(stream.IsConnected ? "rgba(0, 210, 255, 0.4)" : "#1e2638"); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                @if (stream.IsScrimOrigin && !string.IsNullOrWhiteSpace(stream.EffectiveAvatarUrl)) {
                                    <img src="@stream.EffectiveAvatarUrl" alt="DJ Avatar" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1px solid #00d2ff;" />
                                } else {
                                    <div style="width: 24px; height: 24px; border-radius: 50%; background: #1a2234; display: flex; align-items: center; justify-content: center; font-size: 11px;">📻</div>
                                }
                                <div>
                                    <div style="font-size: 12px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 6px;">
                                        @stream.EffectiveDjName
                                        @if (stream.IsScrimOrigin) {
                                            <span style="font-size: 8px; font-weight: 800; color: #00d2ff; background: rgba(0, 210, 255, 0.15); padding: 1px 5px; border-radius: 3px;">SCRIM PEER</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(stream.RemoteGreenRoomPasscode)) {
                                            <span style="font-size: 8px; font-weight: 800; color: #a855f7; background: rgba(168, 85, 247, 0.15); padding: 1px 5px; border-radius: 3px;" title="Connected to remote Green Room chat">💬 GREEN ROOM</span>
                                        }
                                        <span style="font-size: 8px; font-weight: 700; padding: 1px 5px; border-radius: 3px; color: @(stream.HealthStatus == "EXCELLENT" ? "#10b981" : (stream.HealthStatus == "GOOD" ? "#00d2ff" : (stream.HealthStatus == "BUFFERING" ? "#f59e0b" : "#ef4444"))); background: rgba(255,255,255,0.06);">
                                            @stream.HealthStatus @(stream.IsConnected && stream.BufferLatencySec > 0 ? $"({stream.BufferLatencySec:F1}s buffer)" : "")
                                        </span>
                                    </div>
                                    <div style="font-size: 10px; color: #64748b; font-family: monospace; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @stream.StreamUrl
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <button class="pill-option @(stream.IsCueActive ? "active" : "")" style="padding: 3px 8px; font-size: 9px; @(stream.IsCueActive ? "background: #f59e0b; border-color: #f59e0b; color: black; font-weight: 700;" : "")"
                                        title="Pre-Fade Listen headphone cueing"
                                        @onclick="@(() => RelayService.ToggleCue(stream.Id))">
                                    🎧 @(stream.IsCueActive ? "CUE ON" : "CUE")
                                </button>
                                <span style="font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; color: @(stream.IsConnected ? "#10b981" : (stream.IsEnabled ? "#f59e0b" : "#64748b")); background: @(stream.IsConnected ? "rgba(16, 185, 129, 0.15)" : "#161b26");">
                                    @(stream.IsConnected ? "LIVE" : (stream.IsEnabled ? "CONNECTING..." : "OFFLINE"))
                                </span>
                                <button class="pill-option @(stream.IsEnabled ? "active" : "")" style="padding: 3px 8px; font-size: 9px; @(stream.IsEnabled ? "background: #10b981; border-color: #10b981; color: white;" : "")"
                                        @onclick="@(() => RelayService.ToggleStream(stream.Id, !stream.IsEnabled))">
                                    @(stream.IsEnabled ? "DISCONNECT" : "CONNECT")
                                </button>
                                <button class="scrim-dots-btn" style="color: #ef4444;" title="Delete Stream" @onclick="@(() => RelayService.RemoveStream(stream.Id))">✕</button>
                            </div>
                        </div>

                        <!-- Remote Track Info -->
                        @if (stream.IsConnected && !string.IsNullOrWhiteSpace(stream.CurrentTrackTitle)) {
                            <div style="background: rgba(16, 185, 129, 0.07); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 6px; padding: 5px 8px; display: flex; justify-content: space-between; align-items: center; font-size: 10px;">
                                <span style="color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 300px;">
                                    🎵 <strong>@stream.CurrentTrackTitle</strong> @(!string.IsNullOrWhiteSpace(stream.CurrentTrackArtist) ? $"by {stream.CurrentTrackArtist}" : "")
                                </span>
                                <label style="display: flex; align-items: center; gap: 4px; cursor: pointer; color: #10b981; font-weight: 600; font-size: 9px;">
                                    <input type="checkbox" checked="@stream.PassthroughTrackMetadata" @onchange="@((ChangeEventArgs e) => RelayService.UpdateStreamSettings(stream.Id, stream.Volume, stream.IsMuted, stream.FadeInSeconds, stream.CustomAvatarUrl, stream.PassthroughDjBranding, (bool)(e.Value ?? true)))" style="accent-color: #10b981;" />
                                    Track Passthrough
                                </label>
                            </div>
                        }

                        <!-- Scrim Passthrough DJ Info Banner -->
                        @if (stream.IsScrimOrigin) {
                            <div style="background: rgba(0, 210, 255, 0.06); border: 1px solid rgba(0, 210, 255, 0.2); border-radius: 6px; padding: 6px 8px; display: flex; justify-content: space-between; align-items: center; font-size: 10px;">
                                <span style="color: #94a3b8;">Display <strong>@stream.OriginDjName</strong> to listeners</span>
                                <label style="display: flex; align-items: center; gap: 4px; cursor: pointer; color: #00d2ff; font-weight: 600;">
                                    <input type="checkbox" checked="@stream.PassthroughDjBranding" @onchange="@((ChangeEventArgs e) => RelayService.UpdateStreamSettings(stream.Id, stream.Volume, stream.IsMuted, stream.FadeInSeconds, stream.CustomAvatarUrl, (bool)(e.Value ?? true), stream.PassthroughTrackMetadata))" style="accent-color: #00d2ff;" />
                                    Web Passthrough
                                </label>
                            </div>
                        }

                        <!-- Controls: Volume, Fade-In, Mode -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 10px;">
                            <div>
                                <div style="display: flex; justify-content: space-between; color: #94a3b8; margin-bottom: 2px;">
                                    <span>Gain / Vol: @((int)(stream.Volume * 100))%</span>
                                    <button class="pill-option @(stream.IsMuted ? "active" : "")" style="padding: 1px 4px; font-size: 8px; @(stream.IsMuted ? "background: #ef4444; border-color: #ef4444; color: white;" : "")"
                                            @onclick="@(() => RelayService.UpdateStreamSettings(stream.Id, stream.Volume, !stream.IsMuted, stream.FadeInSeconds, stream.CustomAvatarUrl, stream.PassthroughDjBranding, stream.PassthroughTrackMetadata))">
                                        @(stream.IsMuted ? "MUTED" : "MUTE")
                                    </button>
                                </div>
                                <input type="range" min="0" max="1.5" step="0.05" value="@stream.Volume" style="width: 100%; accent-color: #00d2ff; height: 4px;"
                                       @oninput="@((ChangeEventArgs e) => RelayService.UpdateStreamSettings(stream.Id, Convert.ToSingle(e.Value), stream.IsMuted, stream.FadeInSeconds, stream.CustomAvatarUrl, stream.PassthroughDjBranding, stream.PassthroughTrackMetadata))" />
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between; color: #94a3b8; margin-bottom: 2px;">
                                    <span>Fade-In Time:</span>
                                    <span style="font-weight: 700; color: #fff;">@(stream.FadeInSeconds)s</span>
                                </div>
                                <input type="range" min="0" max="10" step="1" value="@stream.FadeInSeconds" style="width: 100%; accent-color: #10b981; height: 4px;"
                                       @oninput="@((ChangeEventArgs e) => RelayService.UpdateStreamSettings(stream.Id, stream.Volume, stream.IsMuted, Convert.ToInt32(e.Value), stream.CustomAvatarUrl, stream.PassthroughDjBranding, stream.PassthroughTrackMetadata))" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(stream.StatusText) && stream.StatusText != "Standby") {
                            <div style="font-size: 9px; color: #64748b; font-style: italic;">Status: @stream.StatusText</div>
                        }
                    </div>
                }
            </div>

            <!-- Add New Stream Form -->
            <div style="background: #090c13; border: 1px solid #161c28; border-radius: 8px; padding: 10px;">
                <div style="font-size: 11px; font-weight: 700; color: #cbd5e1; margin-bottom: 8px;">+ Add Remote Stream / Co-Host</div>
                <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 8px;">
                    <input type="text" class="scrim-input" style="font-size: 11px;" placeholder="Stream URL (e.g. http://dj-friend:8000/stream or Icecast)" @bind="_newRelayUrl" />
                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 6px;">
                        <input type="text" class="scrim-input" style="font-size: 11px;" placeholder="DJ / Station Label (Optional)" @bind="_newRelayName" />
                        <select class="scrim-select" style="font-size: 11px;" @bind="_newRelayMode">
                            <option value="@RelayStreamMode.ReencodedMix">Mix Deck</option>
                            <option value="@RelayStreamMode.RawPassthrough">Passthrough</option>
                        </select>
                    </div>
                    <input type="text" class="scrim-input" style="font-size: 11px;" placeholder="Remote Scrim Green Room PIN (Optional - for cross-station chat)" @bind="_newRelayPasscode" />
                </div>
                <button class="scrim-btn-primary" style="width: 100%; font-size: 11px;" @onclick="AddNewRelayStream" disabled="@string.IsNullOrWhiteSpace(_newRelayUrl)">
                    Add Stream To Relay Rack
                </button>
            </div>
        </div>,

        _ => @<div></div>
    };

    private string HostChatMessage = "";
    private List<ChatMessage> ConsoleChatMessages = new();
    private bool ShowBlacklistManager = false;
    private bool ShowBansManager = false;
    private string NewBlacklistWord = "";
    private bool ShowAssignNicknameModal = false;

    // SAM Pro Suite State & Methods
    private int _peakListenerCount = 0;
    private bool _multiEncoderAacActive = true;
    private bool _multiEncoderFlacActive = false;
    private bool _externalRelayEnabled = false;

    // Stream Relaying & Multi-DJ Party Hub State
    private string _newRelayUrl = "";
    private string _newRelayName = "";
    private RelayStreamMode _newRelayMode = RelayStreamMode.ReencodedMix;
    private int _newRelayFadeIn = 3;
    private string _newRelayPasscode = "";

    private void AddNewRelayStream() {
        if (!string.IsNullOrWhiteSpace(_newRelayUrl)) {
            var cfg = new RelayStreamConfig {
                StreamUrl = _newRelayUrl.Trim(),
                Name = string.IsNullOrWhiteSpace(_newRelayName) ? "Remote Stream" : _newRelayName.Trim(),
                Mode = _newRelayMode,
                FadeInSeconds = _newRelayFadeIn,
                RemoteGreenRoomPasscode = _newRelayPasscode.Trim(),
                IsEnabled = false
            };
