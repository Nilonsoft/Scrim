    private void RefreshWindows() {
        try {
            var newWindows = _enumerator.GetActiveWindows().ToList();
            var currentPids = Windows.Select(w => w.ProcessId).ToHashSet();
            var newPids = newWindows.Select(w => w.ProcessId).ToHashSet();

            bool pidsChanged = !currentPids.SetEquals(newPids);
            if (pidsChanged) {
                Windows = newWindows;
            } else {
                // Same processes: update titles in-place without replacing collection or recreating DOM elements
                var newMap = newWindows.ToDictionary(w => w.ProcessId);
                foreach (var w in Windows) {
                    if (newMap.TryGetValue(w.ProcessId, out var updated) && w.Title != updated.Title) {
                        w.Title = updated.Title;
                    }
                }
            }

            var savedName = ProfileManager.CurrentProfile.TargetProcessName;
            if (!string.IsNullOrEmpty(savedName) && !savedName.Equals("System Audio", StringComparison.OrdinalIgnoreCase)) {
                if (SelectedProcessId == 0 || SelectedProcessId == 999999 || !Windows.Any(w => w.ProcessId == SelectedProcessId)) {
                    var reconnected = Windows.FirstOrDefault(w => string.Equals(w.ProcessName, savedName, StringComparison.OrdinalIgnoreCase))
                                   ?? Windows.FirstOrDefault(w => w.Title.Contains(savedName, StringComparison.OrdinalIgnoreCase));
                    if (reconnected != null && reconnected.ProcessId != SelectedProcessId) {
                        SelectedProcessId = reconnected.ProcessId;
                        SelectedProcessDisplayName = !string.IsNullOrEmpty(reconnected.ProcessName) ? reconnected.ProcessName : reconnected.Title;
                        ProfileManager.CurrentProfile.TargetProcessId = (int)SelectedProcessId;
                        ProfileManager.SaveProfile(ProfileManager.CurrentProfile);
                        EnsureAudioMonitoring(SelectedProcessId);
                        MetadataService.StartMonitoring(SelectedProcessId);
                        InvokeAsync(StateHasChanged);
                    }
                }
            }

            if (pidsChanged) {
                InvokeAsync(StateHasChanged);
            }
        } catch { }
    }

