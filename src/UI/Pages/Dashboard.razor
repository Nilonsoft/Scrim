    private string GetLocalNetworkUrl() => NetworkDiscovery.GetLocalShareUrl(ProfileManager.CurrentProfile.Port);

    private string GetOutsideNetworkUrl() {
        var profile = ProfileManager.CurrentProfile;
        string scheme = profile.UseHttps ? "https://" : "http://";
        bool hidePort = profile.UseReverseProxy;
        int port = profile.Port;

        var custom = profile.CustomPublicUrl?.Trim();
        if (!string.IsNullOrEmpty(custom)) {
            if (custom.StartsWith("http://", StringComparison.OrdinalIgnoreCase)) {
                custom = custom.Substring(7);
            } else if (custom.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) {
                custom = custom.Substring(8);
            }

            if (hidePort) {
                int colonIdx = custom.LastIndexOf(':');
                if (colonIdx > 0 && int.TryParse(custom.Substring(colonIdx + 1), out _)) {
                    custom = custom.Substring(0, colonIdx);
                }
            }
            return $"{scheme}{custom}";
        }

        string publicIp = NetworkDiscovery.PublicIp;
        if (!string.IsNullOrEmpty(publicIp) && publicIp != "Discovering..." && publicIp != "Unavailable") {
            return hidePort ? $"{scheme}{publicIp}" : $"{scheme}{publicIp}:{port}";
        }

        string localIp = NetworkDiscovery.PrimaryLocalIp;
        return hidePort ? $"{scheme}{localIp}" : $"{scheme}{localIp}:{port}";
    }

