    private void ApplyServerPort() {
        if (CustomPortInput < 1024 || CustomPortInput > 65535) {
            PortChangeStatusMessage = "Port must be between 1024 and 65535.";
            PortChangeSuccess = false;
            return;
        }

        int oldPort = ProfileManager.CurrentProfile.Port;
        if (CustomPortInput == oldPort) {
            PortChangeStatusMessage = $"✓ Server is running on port {CustomPortInput}";
            PortChangeSuccess = true;
            return;
        }

        try {
            if (ProfileManager.CurrentProfile.EnableUpnpPortForwarding) {
                NetworkDiscovery.TryUnmapUpnpPort(oldPort);
            }

            ProfileManager.CurrentProfile.Port = CustomPortInput;
            ProfileManager.SaveProfile(ProfileManager.CurrentProfile);

            StreamServer.Stop();
            StreamServer.Start(CustomPortInput);

            if (ProfileManager.CurrentProfile.EnableUpnpPortForwarding) {
                Task.Run(() => NetworkDiscovery.TryMapUpnpPort(CustomPortInput));
            }

            PortChangeStatusMessage = $"✓ Server port changed to {CustomPortInput} and restarted";
            PortChangeSuccess = true;
        } catch (Exception ex) {
            PortChangeStatusMessage = $"Error applying port: {ex.Message}";
            PortChangeSuccess = false;
        }

        StateHasChanged();
    }

    private double GetProgressPercentage() {
        if (CurrentTrackDuration <= TimeSpan.Zero) return 0.0;
        var pos = CurrentTrackPosition;
        if (IsPlayingMedia && LastPositionUpdate > DateTimeOffset.MinValue) {
            var elapsed = DateTimeOffset.UtcNow - LastPositionUpdate;
            if (elapsed > TimeSpan.Zero && elapsed < TimeSpan.FromSeconds(10)) {
                pos += elapsed;
                if (pos > CurrentTrackDuration) pos = CurrentTrackDuration;
            }
        }
        double pct = (pos.TotalSeconds / CurrentTrackDuration.TotalSeconds) * 100.0;
        return Math.Clamp(pct, 0.0, 100.0);
    }

    private string GetTimeDisplay() {
        var pos = CurrentTrackPosition;
        if (IsPlayingMedia && LastPositionUpdate > DateTimeOffset.MinValue) {
            var elapsed = DateTimeOffset.UtcNow - LastPositionUpdate;
            if (elapsed > TimeSpan.Zero && elapsed < TimeSpan.FromSeconds(10)) {
                pos += elapsed;
                if (CurrentTrackDuration > TimeSpan.Zero && pos > CurrentTrackDuration) {
                    pos = CurrentTrackDuration;
                }
            }
        }
        if (CurrentTrackDuration > TimeSpan.Zero) {
            var remaining = CurrentTrackDuration - pos;
            if (remaining < TimeSpan.Zero) remaining = TimeSpan.Zero;
            return $"-{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}";
        }
        if (pos > TimeSpan.Zero) {
            return $"{(int)pos.TotalMinutes}:{pos.Seconds:D2}";
        }
        return "0:00";
    }

    private async Task OnProgressClick(MouseEventArgs e) {
        if (CurrentTrackDuration > TimeSpan.Zero) {
            double ratio = Math.Clamp(e.OffsetX / 260.0, 0.0, 1.0);
            var target = TimeSpan.FromSeconds(CurrentTrackDuration.TotalSeconds * ratio);
            CurrentTrackPosition = target;
            LastPositionUpdate = DateTimeOffset.UtcNow;
            await MetadataService.SeekAsync(target);
            StateHasChanged();
        }
    }

