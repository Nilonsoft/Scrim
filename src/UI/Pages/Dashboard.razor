                            <path d="M 15 75 A 55 55 0 0 1 80 23" fill="none" stroke="#22c55e" stroke-width="4" stroke-dasharray="3 1" />
                            <path d="M 80 23 A 55 55 0 0 1 98 34" fill="none" stroke="#eab308" stroke-width="4" stroke-dasharray="3 1" />
                            <path d="M 98 34 A 55 55 0 0 1 115 75" fill="none" stroke="#ef4444" stroke-width="4" stroke-dasharray="3 1" />
                            <text x="22" y="70" fill="#717a8c" font-size="8" font-family="sans-serif">-20</text>
                            <text x="44" y="38" fill="#717a8c" font-size="8" font-family="sans-serif">-8</text>
                            <text x="80" y="28" fill="#eab308" font-size="8" font-family="sans-serif">0</text>
                            <text x="104" y="65" fill="#ef4444" font-size="8" font-family="sans-serif">+3</text>
                            <text x="65" y="62" fill="#505666" font-size="11" font-weight="bold" text-anchor="middle">VU</text>
                        </svg>
                        <div class="vu-needle" id="vu-needle-right"></div>
                        <div class="vu-needle-hub"></div>
                    </div>
                </div>

                <div class="vu-labels">
                    <span>L</span>
                    <span class="vu-brand-center">Stereo</span>
                    <span>R</span>
                </div>
            </div>

            <!-- Big Circular Mic Toggle & Push-to-Talk / Push-to-Mute Button -->
            <div class="talk-button-wrapper">
                <div class="pill-group" style="margin-bottom: 12px; justify-content: center;">
                    <button class="pill-option @(Mixer.ControlMode == MicControlMode.PushToTalk ? "active" : "")" 
                            @onclick="@(() => SetMicControlMode(MicControlMode.PushToTalk))">
                        Push to Talk
                    </button>
                    <button class="pill-option @(Mixer.ControlMode == MicControlMode.PushToMute ? "active" : "")" 
                            @onclick="@(() => SetMicControlMode(MicControlMode.PushToMute))">
                        Push to Mute
                    </button>
                </div>

                <button class="talk-btn @(Mixer.IsMicLive ? "active" : "")"
                        @onclick="ToggleMicState"
                        @onmousedown="OnMicButtonDown"
                        @onmouseup="OnMicButtonUp"
                        @ontouchstart="OnMicButtonDown"
                        @ontouchend="OnMicButtonUp"
                        title="Click to toggle mic on/off, or hold down to talk/mute">
                    @(Mixer.IsMicLive ? (Mixer.ControlMode == MicControlMode.PushToTalk ? "TALK" : "LIVE") : "MUTED")
                </button>
                
                <div class="talk-subtitle">
                    @(Mixer.ControlMode == MicControlMode.PushToTalk 
                        ? (Mixer.IsMicLive ? "🔴 ON AIR (Click to Mute)" : "Click or Hold to Talk") 
                        : (Mixer.IsMicLive ? "🟢 OPEN MIC (Click or Hold to Mute)" : "🔇 MUTED (Click to Unmute)"))
                </div>

                <!-- Mic Monitoring & Mic Test Options -->
                <div class="mic-options-row">
                    <button class="mic-option-btn @(MicService.IsMonitoring ? "active-hear" : "")"
                            @onclick="ToggleHearMyself"
                            title="Mic Monitoring (Sidetone): Hear yourself through your headphones while talking">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                        </svg>
                        <span>@(MicService.IsMonitoring ? "🎧 Hear Myself: ON" : "🎧 Hear Myself: OFF")</span>
                    </button>

                    <button class="mic-option-btn @(MicService.IsMicTestMode ? "active-test" : "")"
                            @onclick="ToggleMicTestMode"
                            title="Mic Test Mode: Listen to yourself in headphones without broadcasting your voice to the live stream">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" y1="19" x2="12" y2="23"></line>
                            <line x1="8" y1="23" x2="16" y2="23"></line>
                        </svg>
                        <span>@(MicService.IsMicTestMode ? "🎙️ Testing (Off-Air)" : "🎙️ Test Mic (Off-Air)")</span>
                    </button>
                </div>

                @if (MicService.IsMicTestMode) {
                    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 6px 10px; margin-top: 8px; font-size: 11px; color: #f59e0b; text-align: center;">
                        ⚠️ <strong>Off-Air Mic Test Active</strong>: Voice is playing in your headphones only and is NOT broadcast to the stream.
                    </div>
                }
            </div>

            <!-- Stream Broadcast Output Meter (Sound Getting Out Confirmation) -->
            <div class="stream-meter-box">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: #cbd5e1; letter-spacing: 0.5px;">STREAM BROADCAST OUT</span>
                    <div id="stream-tx-badge" class="tx-badge tx-off">
                        <span class="tx-pulse-dot off"></span> OFF-AIR (LOCAL MONITOR)
                    </div>
                </div>

                <!-- Left Output Channel -->
                <div class="stream-meter-channel">
                    <span class="stream-meter-label">L</span>
                    <div class="stream-meter-track">
                        <div id="meter-stream-bar-l" class="stream-meter-fill"></div>
                    </div>
                    <span id="meter-stream-text-l" class="stream-meter-db">-inf dB</span>
                </div>

                <!-- Right Output Channel -->
                <div class="stream-meter-channel">
                    <span class="stream-meter-label">R</span>
                    <div class="stream-meter-track">
                        <div id="meter-stream-bar-r" class="stream-meter-fill"></div>
                    </div>
                    <span id="meter-stream-text-r" class="stream-meter-db">-inf dB</span>
                </div>

                <!-- Scale Ticks -->
                <div class="stream-meter-ticks">
                    <span>-40</span>
                    <span>-24</span>
                    <span>-12</span>
                    <span>-6</span>
                    <span>-3</span>
                    <span>0 dB</span>
                </div>

                <!-- Microphone Pick-up Input Level Bar -->
                <div class="stream-meter-channel" style="margin-top: 10px; border-top: 1px solid #1e222c; padding-top: 8px;">
                    <span class="stream-meter-label" style="width: 26px; font-size: 9px; color: #38bdf8;">MIC</span>
                    <div class="stream-meter-track">
                        <div id="meter-mic-bar" class="stream-meter-fill" style="background: linear-gradient(to right, #00d2ff, #38bdf8, #818cf8);"></div>
                    </div>
                    <span id="meter-mic-text" class="stream-meter-db">-inf dB</span>
                </div>
            </div>
        </div>,

        "card-voice-fx" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">Phone-In Line</h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span class="scrim-label" style="margin: 0;">Line: Status</span>
                <button class="scrim-btn-secondary" style="padding: 4px 12px; font-size: 11px;" @onclick="ToggleMicState">
                    @(Mixer.IsMicLive ? "DISCONNECT" : "CONNECT")
                </button>
            </div>
            <div>
                <label class="scrim-label">Voice Processor FX</label>
                <select class="scrim-select" @bind="MicService.CurrentEffect" @bind:after="OnVoiceEffectChanged">
                    <option value="">Normal Mic</option>
                    @foreach (var provider in EffectLoader.AvailableProviders) {
                        <option value="@provider.Id">@provider.Name</option>
                    }
                </select>
            </div>
        </div>,

        "card-queue" => @<div class="scrim-card">
            @{
                var liveQueue = RequestController.GetLiveQueue().ToList();
            }
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h3 class="scrim-card-title">Song Requests</h3>
                    <span style="font-size: 11px; padding: 2px 7px; border-radius: 10px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-weight: 700;">
                        @liveQueue.Count
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="pill-option @(ProfileManager.CurrentProfile.EnableSongRequests ? "active" : "")" 
                            style="padding: 2px 8px; font-size: 10px;"
                            @onclick="ToggleSongRequestsEnabled" 
                            title="Turn Song Requests On / Off">
                        @(ProfileManager.CurrentProfile.EnableSongRequests ? "ON" : "OFF")
                    </button>
                    @if (liveQueue.Any()) {
                        <button class="pill-option" style="padding: 2px 8px; font-size: 10px; color: #f87171; border-color: rgba(239, 68, 68, 0.35);" 
                                @onclick="ClearSongRequests" 
                                title="Clear all song requests from queue">
                            🗑️ Clear All
                        </button>
                    }
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>
            @if (!ProfileManager.CurrentProfile.EnableSongRequests) {
                <div style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.28); border-radius: 6px; padding: 6px 10px; margin-bottom: 8px; font-size: 10.5px; color: #fca5a5; display: flex; justify-content: space-between; align-items: center;">
                    <span>⏸️ Song requests are currently <strong>PAUSED</strong> for web listeners.</span>
                    <button class="pill-option" style="padding: 1px 6px; font-size: 9.5px; border-color: rgba(239, 68, 68, 0.4); color: #fca5a5;" @onclick="ToggleSongRequestsEnabled">Resume</button>
                </div>
            }
            @if (!liveQueue.Any()) {
                <div style="color: #6c7384; font-size: 13px; text-align: center; padding: 24px 0;">No listener requests pending.</div>
            } else {
                <div style="display: flex; flex-direction: column; gap: 6px; max-height: 460px; overflow-y: auto; padding-right: 4px;">
                    @for (int i = 0; i < liveQueue.Count; i++) {
                        var req = liveQueue[i];
                        int index = i;
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background: #14171e; border: 1px solid #232731; border-radius: 8px; gap: 10px;">
                            <!-- Reorder buttons -->
                            <div style="display: flex; flex-direction: column; gap: 2px;">
                                <button class="scrim-dots-btn" style="width: 20px; height: 18px; font-size: 9px; padding: 0; line-height: 1; @(index == 0 ? "opacity: 0.25; cursor: not-allowed;" : "")" 
                                        disabled="@(index == 0)" 
                                        @onclick="@(() => MoveSongRequestUp(req.Id))" 
                                        title="Move Up">▲</button>
                                <button class="scrim-dots-btn" style="width: 20px; height: 18px; font-size: 9px; padding: 0; line-height: 1; @(index == liveQueue.Count - 1 ? "opacity: 0.25; cursor: not-allowed;" : "")" 
                                        disabled="@(index == liveQueue.Count - 1)" 
                                        @onclick="@(() => MoveSongRequestDown(req.Id))" 
                                        title="Move Down">▼</button>
                            </div>

                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 11px; font-weight: 700; color: #64748b; font-family: monospace;">#@(index + 1)</span>
                                    <div style="font-weight: 600; font-size: 13px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@req.Query</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.Dedication)) {
                                    <div style="font-size: 11px; color: #f43f5e; background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.28); border-radius: 4px; padding: 2px 7px; display: inline-flex; align-items: center; gap: 4px; margin-top: 3px; font-weight: 500;">
                                        <span>❤️ Dedicated to: <strong style="color: #fff;">@req.Dedication</strong></span>
                                    </div>
                                }
                                <div style="font-size: 10px; color: #727988; margin-top: 2px; display: flex; align-items: center; gap: 6px;">
                                    <span>@req.RequestedAt.ToLocalTime().ToString("t")</span>
                                    <span>•</span>
                                    <span style="font-weight: 600; color: @(req.Status == "Accepted" ? "#4ade80" : req.Status == "Declined" ? "#f87171" : "#facc15");">@req.Status</span>
                                </div>
                            </div>

                            <!-- Actions: Accept, Decline, Remove -->
                            <div style="display: flex; align-items: center; gap: 5px;">
                                <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; color: #22c55e;" @onclick="@(() => RequestController.UpdateStatus(req.Id, "Accepted"))" title="Accept Request">✓</button>
                                <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; color: #f59e0b;" @onclick="@(() => RequestController.UpdateStatus(req.Id, "Declined"))" title="Decline Request">✗</button>
                                <button class="scrim-dots-btn" style="color: #ef4444; font-size: 12px; width: 26px; height: 26px;" @onclick="@(() => RemoveSongRequest(req.Id))" title="Remove Request">🗑️</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>,

        "card-encoding" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">Encoding</h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Codec Pills -->
            <div class="pill-group">
                <button class="pill-option @(ProfileManager.CurrentProfile.AudioFormat.Equals("Mp3", StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="@(() => SetFormat("Mp3"))">MP3</button>
                <button class="pill-option @(ProfileManager.CurrentProfile.AudioFormat.Equals("Aac", StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="@(() => SetFormat("Aac"))">AAC</button>
                <button class="pill-option @(ProfileManager.CurrentProfile.AudioFormat.Equals("Opus", StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="@(() => SetFormat("Opus"))">Opus</button>
                <button class="pill-option @(ProfileManager.CurrentProfile.AudioFormat.Equals("Flac", StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="@(() => SetFormat("Flac"))">FLAC</button>
            </div>

            <!-- Bitrate Pills per Format -->
            <label class="scrim-label">Bitrate</label>
            @if (ProfileManager.CurrentProfile.AudioFormat.Equals("Flac", StringComparison.OrdinalIgnoreCase)) {
                <div class="pill-group">
                    <span class="pill-option active" style="border-color: #22c55e; color: #22c55e;">Lossless (Auto)</span>
                </div>
            } else {
                <div class="pill-group">
                    @foreach (var br in GetBitratesForFormat(ProfileManager.CurrentProfile.AudioFormat)) {
                        <button class="pill-option @(ProfileManager.CurrentProfile.Bitrate == br ? "active" : "")" @onclick="@(() => SetBitrate(br))">@(br)k</button>
                    }
                </div>

                <!-- Custom Bitrate Input -->
                <div style="display: flex; gap: 6px; align-items: center; margin-top: 8px;">
                    <span style="font-size: 11px; color: #8e95a5;">Custom:</span>
                    <input type="number" class="scrim-input" style="width: 80px; padding: 4px 8px; font-size: 11px;" @bind="CustomBitrateInput" placeholder="kbps" />
                    <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="ApplyCustomBitrate">Set</button>
                </div>
            }

            <!-- Stream Server Port Setting -->
            <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid #232731;">
                <label class="scrim-label" style="margin-bottom: 6px;">Server Port</label>
                <div style="display: flex; gap: 6px; align-items: center;">
                    <input type="number" min="1024" max="65535" class="scrim-input" style="width: 90px; padding: 4px 8px; font-size: 11px; font-family: monospace;" 
                           value="@CustomPortInput" 
                           @oninput="@((ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out int p)) CustomPortInput = p; })" />
                    <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="ApplyServerPort">Set Port</button>
                    <span style="font-size: 10px; color: #64748b;">Current: :@(ProfileManager.CurrentProfile.Port)</span>
                </div>
            </div>

            <!-- Synchronized Broadcast Control & On Air Status -->
            <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #232731;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 10px; font-weight: 700; color: #8e95a5; letter-spacing: 0.5px;">BROADCAST STATUS</span>
                    <div class="on-air-badge @(IsLive ? "" : "offline")" style="padding: 2px 10px; font-size: 10px; cursor: pointer;" @onclick="ToggleBroadcast" title="Click to toggle broadcast (synchronized with top bar)">
                        <span class="on-air-dot"></span>
                        <span>@(IsLive ? "ON AIR" : "OFFLINE")</span>
                    </div>
                </div>

                <div style="display: flex; gap: 8px;">
                    @if (IsLive) {
                        <button class="scrim-btn-danger" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; background: linear-gradient(135deg, #ef4444, #dc2626); border: 1px solid #ef4444; box-shadow: 0 0 12px rgba(239, 68, 68, 0.35); padding: 8px 14px; border-radius: 6px; color: #fff; cursor: pointer;" @onclick="StopBroadcast" title="Stop live broadcasting">
                            <span class="on-air-dot" style="width: 7px; height: 7px; background: #fff; box-shadow: 0 0 6px #fff;"></span>
                            <span>Stop Broadcasting (ON AIR)</span>
                        </button>
                    } else {
                        <button class="scrim-btn-primary" style="flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; padding: 8px 14px; border-radius: 6px; cursor: pointer;" @onclick="StartBroadcast" title="Start live broadcasting">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                            </svg>
                            <span>Start Broadcasting (Go ON AIR)</span>
                        </button>
                    }
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #232731;">
                    <label class="scrim-label" style="margin: 0; cursor: pointer; font-size: 11px;" for="broadcastOnOpenChk">Broadcast on Open</label>
                    <input type="checkbox" id="broadcastOnOpenChk" 
                           checked="@ProfileManager.CurrentProfile.BroadcastOnOpen" 
                           @onchange="ToggleBroadcastOnOpen" 
                           style="cursor: pointer; width: 15px; height: 15px; accent-color: #00d2ff;" 
                           title="Automatically start broadcasting when Scrim opens" />
                </div>
            </div>
        </div>,

        "card-media-player" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    Media Player
                </h3>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <div class="media-player-main">
                <div class="media-album-art" style="overflow: hidden; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrEmpty(CurrentTrackAlbumArtBase64)) {
                        <img src="@CurrentTrackAlbumArtBase64" alt="Album Art" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
                    } else {
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5">
                            <path d="M9 18V5l12-2v13"></path>
                            <circle cx="6" cy="18" r="3"></circle>
                            <circle cx="18" cy="16" r="3"></circle>
                        </svg>
                    }
                </div>
                <div>
                    <h4 class="media-meta-title" style="display: flex; align-items: center; gap: 6px;">
                        <span>@CurrentTrackTitle</span>
                        @if (!string.IsNullOrWhiteSpace(CurrentTrackTitle) && CurrentTrackTitle != "Awaiting Audio Source..." && CurrentTrackTitle != "Awaiting Track Info...") {
                            <a href="@($"https://www.google.com/search?q={Uri.EscapeDataString(CurrentTrackTitle + " " + CurrentTrackArtist)}")" target="_blank" rel="noopener noreferrer" style="color: #64748b; font-size: 13px; text-decoration: none; cursor: pointer;" title="Search song on Google" onmouseover="this.style.color='#00d2ff'" onmouseout="this.style.color='#64748b'">
                                🔍
                            </a>
                        }
                    </h4>
                    <div class="media-meta-artist">@CurrentTrackArtist</div>
                    <div class="media-meta-extra">@CurrentTrackExtra</div>
                    <div class="media-reactions-row" style="display: flex; gap: 8px; align-items: center; margin-top: 6px; font-size: 12px; color: #94a3b8; flex-wrap: wrap;">
                        <span title="Thumbs Up" style="background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 12px; display: inline-flex; align-items: center; gap: 4px;">👍 <strong style="color: #38bdf8;">@ReactionService.CurrentCounts.ThumbsUp</strong></span>
                        <span title="Love" style="background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 12px; display: inline-flex; align-items: center; gap: 4px;">❤️ <strong style="color: #f43f5e;">@ReactionService.CurrentCounts.Heart</strong></span>
                        <span title="Thumbs Down" style="background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 12px; display: inline-flex; align-items: center; gap: 4px;">👎 <strong style="color: #94a3b8;">@ReactionService.CurrentCounts.ThumbsDown</strong></span>
                        <button class="pill-option" style="padding: 1px 8px; font-size: 10px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; border-radius: 10px;" @onclick="ResetCurrentSongReactions" title="Clear reactions for current track">Clear Current</button>
                        <button class="pill-option" style="padding: 1px 8px; font-size: 10px; background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.3); color: #00d2ff; border-radius: 10px;" @onclick="ToggleSongReactionsManager" title="View & clear reactions per song">
                            @(ShowAllSongReactions ? "Hide All Reactions" : $"All Songs ({ReactionService.GetAllSongReactions().Count})")
                        </button>
                        <button class="pill-option" style="padding: 1px 8px; font-size: 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc; border-radius: 10px;" @onclick="ToggleSongHistoryManager" title="View & manage session song history">
                            @(ShowSongHistory ? "Hide History" : $"History ({HistoryService.GetHistory(100).Count})")
                        </button>
                        @if (HistoryService.GetHistory(100).Count > 0) {
                            <button class="pill-option" style="padding: 1px 8px; font-size: 10px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; border-radius: 10px;" @onclick="ClearSessionHistory" title="Clear all session song history">
                                Clear History
                            </button>
                        }
                    </div>

                    @if (ShowSongHistory) {
                        <div style="margin-top: 10px; background: rgba(0,0,0,0.3); border: 1px solid #232731; border-radius: 8px; padding: 8px; max-height: 200px; overflow-y: auto;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; font-weight: 700; color: #94a3b8;">
                                <span>SESSION SONG HISTORY</span>
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    <span>@(HistoryService.GetHistory(100).Count) tracks</span>
                                    @if (HistoryService.GetHistory(100).Count > 0) {
                                        <button class="pill-option" style="padding: 1px 6px; font-size: 10px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; border-radius: 6px;" @onclick="ClearSessionHistory" title="Clear all session song history">Clear All</button>
                                    }
                                </div>
                            </div>
                            @if (HistoryService.GetHistory(100).Count == 0) {
                                <div style="font-size: 11px; color: #64748b; text-align: center; padding: 10px 0;">No songs played yet this session.</div>
                            } else {
                                @foreach (var item in HistoryService.GetHistory(100)) {
                                    var songReactions = ReactionService.GetSongReactions(item.Title, item.Artist);
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 6px; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 11px; gap: 8px;">
                                        <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; display: flex; align-items: center; gap: 4px;">
                                            <a href="@($"https://www.google.com/search?q={Uri.EscapeDataString(((item.Title ?? "") + " " + (item.Artist ?? "")).Trim())}")" target="_blank" rel="noopener noreferrer" style="color: #e2e8f0; font-weight: 500; text-decoration: none; cursor: pointer;" title="Search '@item.Title' on Google" onmouseover="this.style.color='#00d2ff'" onmouseout="this.style.color='#e2e8f0'">
                                                @item.Title
                                            </a>
                                            @if (!string.IsNullOrEmpty(item.Artist)) {
                                                <span style="color: #8e95a5;">— @item.Artist</span>
                                            }
                                            <a href="@($"https://www.google.com/search?q={Uri.EscapeDataString(((item.Title ?? "") + " " + (item.Artist ?? "")).Trim())}")" target="_blank" rel="noopener noreferrer" style="color: #64748b; font-size: 10px; text-decoration: none; margin-left: 2px;" title="Search on Google" onmouseover="this.style.color='#00d2ff'" onmouseout="this.style.color='#64748b'">
                                                🔍
                                            </a>
                                        </div>
                                        <div style="display: flex; gap: 6px; align-items: center; font-size: 10px; white-space: nowrap;">
                                            @if (songReactions.ThumbsUp > 0 || songReactions.Heart > 0 || songReactions.ThumbsDown > 0) {
                                                <span style="color: #38bdf8;" title="Thumbs Up">👍 @songReactions.ThumbsUp</span>
                                                <span style="color: #f43f5e;" title="Love">❤️ @songReactions.Heart</span>
                                                <span style="color: #94a3b8;" title="Thumbs Down">👎 @songReactions.ThumbsDown</span>
                                            }
                                            <span style="color: #64748b;">@item.PlayedAtFormatted</span>
                                            <button class="scrim-dots-btn" style="color: #ef4444; font-size: 11px; padding: 1px 4px;" @onclick="@(() => RemoveHistoryTrack(item.Id))" title="Remove '@item.Title' from history">🗑️</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (ShowAllSongReactions) {
                        <div style="margin-top: 10px; background: rgba(0,0,0,0.3); border: 1px solid #232731; border-radius: 8px; padding: 8px; max-height: 180px; overflow-y: auto;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; font-weight: 700; color: #94a3b8;">
                                <span>SONG REACTIONS PER TRACK</span>
                                <span>@(ReactionService.GetAllSongReactions().Count) tracks</span>
                            </div>
                            @if (ReactionService.GetAllSongReactions().Count == 0) {
                                <div style="font-size: 11px; color: #64748b; text-align: center; padding: 10px 0;">No reactions recorded yet.</div>
                            } else {
                                @foreach (var kvp in ReactionService.GetAllSongReactions()) {
                                    var sKey = kvp.Key;
                                    var rec = kvp.Value;
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 6px; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 11px; gap: 8px;">
                                        <span style="color: #e2e8f0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;" title="@sKey">@FormatSongKeyDisplay(sKey)</span>
                                        <div style="display: flex; gap: 6px; align-items: center; white-space: nowrap;">
                                            <span title="Thumbs Up" style="color: #38bdf8;">👍 @rec.ThumbsUp</span>
                                            <span title="Love" style="color: #f43f5e;">❤️ @rec.Heart</span>
                                            <span title="Thumbs Down" style="color: #94a3b8;">👎 @rec.ThumbsDown</span>
                                            <button class="scrim-dots-btn" style="color: #ef4444; font-size: 11px; padding: 1px 4px;" @onclick="@(() => ClearSongReactions(sKey))" title="Clear reactions for @sKey">🗑️</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="media-progress-container" @onclick="OnProgressClick" style="cursor: pointer;" title="Click to seek">
                <div class="media-progress-bar">
                    <div class="media-progress-fill" style="width: @(GetProgressPercentage().ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;">
                        <div class="media-progress-thumb"></div>
                    </div>
                </div>
                <div class="media-time">@GetTimeDisplay()</div>
            </div>

            <div class="media-controls-row" style="justify-content: center; gap: 24px;">
                <button class="media-btn" title="Previous" @onclick="SkipPrevMedia">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="19 20 9 12 19 4 19 20"></polygon>
                        <line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2"></line>
                    </svg>
                </button>
                <button class="media-play-circle" @onclick="ToggleMediaPlayback" title="@(IsPlayingMedia ? "Pause" : "Play")">
                    @if (IsPlayingMedia) {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <rect x="6" y="4" width="4" height="16"></rect>
                            <rect x="14" y="4" width="4" height="16"></rect>
                        </svg>
                    } else {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-left: 2px;">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                    }
                </button>
                <button class="media-btn" title="Next" @onclick="SkipNextMedia">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 4 15 12 5 20 5 4"></polygon>
                        <line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2"></line>
                    </svg>
                </button>
            </div>
        </div>,

        "card-soundboard" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div>
                    <h3 class="scrim-card-title">Soundboard</h3>
                    <div style="font-size: 10px; color: #00d2ff; margin-top: 1px; font-weight: 500;">⚡ Broadcasts Live to Stream & DJ Headphones</div>
                </div>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>
            <div class="soundboard-grid">
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Airhorn")'>Airhorn</button>
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Applause")'>Applause</button>
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Rimshot")'>Rimshot</button>
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Bleep")'>Bleep</button>
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Vinyl")'>Vinyl</button>
                <button class="soundboard-btn" @onclick='() => PlaySoundEffect("Laser")'>Laser</button>
                @foreach (var customSound in ProfileManager.CurrentProfile.CustomSounds) {
                    <button class="soundboard-btn" style="border-color: #00d2ff; color: #00d2ff; position: relative;" @onclick="() => PlayCustomSound(customSound)" title="@customSound.FilePath">
                        @customSound.Name
                        <span style="position: absolute; top: 2px; right: 4px; font-size: 10px; color: #ef4444;" @onclick:stopPropagation="true" @onclick="@(() => RemoveCustomSound(customSound))">✕</span>
                    </button>
                }
            </div>

            <!-- Add Custom Sound Form -->
            <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid #252830;">
                <label class="scrim-label" style="font-size: 11px;">+ Add Custom Sound File (.wav)</label>
                <div style="display: flex; gap: 6px;">
                    <input type="text" class="scrim-input" style="flex: 1; padding: 4px 8px; font-size: 11px;" @bind="NewCustomSoundName" placeholder="Sound Name" />
                    <input type="text" class="scrim-input" style="flex: 2; padding: 4px 8px; font-size: 11px;" @bind="NewCustomSoundPath" placeholder="C:\Audio\sound.wav" />
                    <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="AddCustomSound">+ Add</button>
                </div>
            </div>
        </div>,

        "card-web-branding" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    Website Branding & Links
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Station Brand / Header Title</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.StationName" @bind:event="oninput" @bind:after="SaveBranding" placeholder="e.g. GLOBAL INDIE RADIO" />
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Browser Page Title</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.PageTitle" @bind:event="oninput" @bind:after="SaveBranding" placeholder="e.g. Global Indie Radio - Live Broadcast" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                <div>
                    <label class="scrim-label">Show / Program Title</label>
                    <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.ShowTitle" @bind:event="oninput" @bind:after="SaveBranding" placeholder="e.g. Late Night Indie Drive" />
                </div>
                <div>
                    <label class="scrim-label">Host / DJ Name</label>
                    <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.HostName" @bind:event="oninput" @bind:after="SaveBranding" placeholder="e.g. Sarah J." />
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label class="scrim-label">Station Tagline / Genre</label>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.GenreTag" @bind:event="oninput" @bind:after="SaveBranding" placeholder="e.g. Indie Alternative" />
            </div>

            <div style="margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <label class="scrim-label" style="margin: 0;">Top Website Banner (Optional)</label>
                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px;" @onclick="OpenAssetsDirectory" title="Open ~/.scrim/assets/ in File Explorer">📁 Open Assets Folder</button>
                        @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.BannerUrl)) {
                            <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px; color: #ef4444;" @onclick="@(() => { ProfileManager.CurrentProfile.BannerUrl = ""; SaveBranding(); })">✕ Remove Banner</button>
                        }
                    </div>
                </div>
                <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.BannerUrl" @bind:event="oninput" @bind:after="SaveBranding" placeholder="URL (https://...) or .\assets\image.jpg (or image name in ~/.scrim/assets)" />
                <span style="font-size: 11px; color: var(--text-muted, #71717a); display: block; margin-top: 4px;">Displays a panoramic image banner across the top of the website. Supports URLs, <code>.\assets\name</code>, or images in <code>~/.scrim/assets/</code>.</span>
                @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.BannerUrl)) {
                    <div style="margin-top: 8px; border-radius: 6px; overflow: hidden; height: 60px; background: #000; border: 1px solid var(--border-color, #252830); display: flex; align-items: center; justify-content: center;">
                        <img src="@(ProfileManager.CurrentProfile.BannerUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ProfileManager.CurrentProfile.BannerUrl : $"/api/banner?t={DateTime.UtcNow.Ticks}")" 
                             alt="Banner Preview" 
                             style="width: 100%; height: 100%; object-fit: cover;" 
                             onerror="this.style.display='none'" />
                    </div>
                }
            </div>

            <div style="margin-bottom: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <label class="scrim-label" style="margin: 0;">DJ Avatar / Station Logo (Optional)</label>
                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px;" @onclick="OpenAssetsDirectory" title="Open ~/.scrim/assets/ in File Explorer">📁 Open Assets Folder</button>
                        @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.LogoUrl)) {
                            <button class="scrim-btn-secondary" style="padding: 1px 6px; font-size: 10px; color: #ef4444;" @onclick="@(() => { ProfileManager.CurrentProfile.LogoUrl = ""; SaveBranding(); })">✕ Remove Avatar</button>
                        }
                    </div>
                </div>
                <div style="display: flex; gap: 10px; align-items: center;">
                    @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.LogoUrl)) {
                        <div style="width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: #18181b; border: 2px solid var(--accent-primary, #6366f1); display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.3);">
                            <img src="@(ProfileManager.CurrentProfile.LogoUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ProfileManager.CurrentProfile.LogoUrl : $"/api/logo?t={DateTime.UtcNow.Ticks}")" 
                                 alt="Avatar Preview" 
                                 style="width: 100%; height: 100%; object-fit: cover;" 
                                 onerror="this.style.display='none'" />
                        </div>
                    }
                    <div style="flex: 1;">
                        <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.LogoUrl" @bind:event="oninput" @bind:after="SaveBranding" placeholder="URL (https://...) or .\assets\avatar.png (or image name in ~/.scrim/assets)" />
                    </div>
                </div>
                <span style="font-size: 11px; color: var(--text-muted, #71717a); display: block; margin-top: 4px;">Displays the host DJ avatar and station logo on the website player and chat. Supports URLs, <code>.\assets\name</code>, or images in <code>~/.scrim/assets/</code>.</span>
            </div>

            <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label class="scrim-label" style="margin: 0;">Website Theme</label>
                    <div style="display: flex; gap: 6px;">
                        <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 11px;" @onclick="() => ThemeService.RefreshThemes()" title="Reload user themes from disk">⟳ Refresh</button>
                        <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 11px;" @onclick="() => ThemeService.OpenThemesDirectory()" title="Open ~/.scrim/themes/ in Explorer">📁 Open Themes Folder</button>
                    </div>
                </div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    @foreach (var theme in ThemeService.GetAvailableThemes()) {
                        <button class="pill-option @(ProfileManager.CurrentProfile.WebTheme == theme.Id ? "active" : "")" 
                                style="padding: 4px 10px; font-size: 11px;" 
                                title="@theme.Description"
                                @onclick='@(() => SetWebTheme(theme.Id, theme.AccentColor))'>
                            @(theme.Icon) @(theme.Name)@(theme.IsCustom ? " (User)" : "")
                        </button>
                    }
                </div>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
                    <input type="checkbox" id="syncConsoleThemeCheck"
                           checked="@ProfileManager.CurrentProfile.SyncConsoleThemeWithWeb"
                           @onchange="ToggleSyncConsoleTheme"
                           style="accent-color: var(--accent-blue, #00d2ff); width: 15px; height: 15px; cursor: pointer;" />
                    <label for="syncConsoleThemeCheck" style="font-size: 11.5px; color: var(--text-muted, #94a3b8); cursor: pointer; user-select: none; margin: 0;">
                        Sync Scrim Console with Website Theme (desktop console updates colors to match)
                    </label>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                    <input type="checkbox" id="dynamicBackdropCheck"
                           checked="@ProfileManager.CurrentProfile.EnableDynamicBackdrop"
                           @onchange="ToggleDynamicBackdrop"
                           style="accent-color: var(--accent-blue, #00d2ff); width: 15px; height: 15px; cursor: pointer;" />
                    <label for="dynamicBackdropCheck" style="font-size: 11.5px; color: var(--text-muted, #94a3b8); cursor: pointer; user-select: none; margin: 0;">
                        Enable Dynamic Ambient Backdrop (extracts colors from album art; uncheck to prioritize your Website Theme)
                    </label>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                    <input type="checkbox" id="enableSongRequestsCheck"
                           checked="@ProfileManager.CurrentProfile.EnableSongRequests"
                           @onchange="ToggleSongRequestsEnabled"
                           style="accent-color: var(--accent-blue, #00d2ff); width: 15px; height: 15px; cursor: pointer;" />
                    <label for="enableSongRequestsCheck" style="font-size: 11.5px; color: var(--text-muted, #94a3b8); cursor: pointer; user-select: none; margin: 0;">
                        Allow Listener Song Requests (accept song requests and dedications from website listeners)
                    </label>
                </div>
            </div>

            <div style="margin-bottom: 14px;">
                <label class="scrim-label">Accent Color Theme</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="color" style="width: 36px; height: 36px; border: none; border-radius: 8px; background: transparent; cursor: pointer;"
                           value="@ProfileManager.CurrentProfile.AccentColor"
                           @onchange="@((ChangeEventArgs e) => SetAccentColor(e.Value?.ToString() ?? "#ef4444"))" />
                    
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #ef4444; color: white; border: none;" @onclick="@(() => SetAccentColor("#ef4444"))">Red</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #00d2ff; color: #121316; border: none;" @onclick="@(() => SetAccentColor("#00d2ff"))">Cyan</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #a855f7; color: white; border: none;" @onclick="@(() => SetAccentColor("#a855f7"))">Purple</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #10b981; color: white; border: none;" @onclick="@(() => SetAccentColor("#10b981"))">Green</button>
                        <button class="pill-option" style="padding: 4px 10px; font-size: 11px; background: #f59e0b; color: #121316; border: none;" @onclick="@(() => SetAccentColor("#f59e0b"))">Amber</button>
                    </div>
                </div>
            </div>

            <!-- Custom Navigation Links with Label + Exact Destination URL -->
            <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label class="scrim-label" style="margin: 0;">Navigation Links & Destinations</label>
                    <button class="scrim-btn-secondary" style="padding: 3px 8px; font-size: 11px;" @onclick="AddNavLink">+ Add Link</button>
                </div>
                @foreach (var link in ProfileManager.CurrentProfile.CustomNavLinks) {
                    <div style="display: flex; gap: 6px; margin-bottom: 8px; align-items: center;">
                        <input type="text" class="scrim-input" style="flex: 1; padding: 6px 8px; font-size: 12px;" @bind="link.Label" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Label (e.g. Discord)" />
                        <input type="text" class="scrim-input" style="flex: 2; padding: 6px 8px; font-size: 12px;" @bind="link.Url" @bind:event="oninput" @bind:after="SaveBranding" placeholder="URL (e.g. https://discord.gg/...)" />
                        <button class="scrim-dots-btn" style="color: #ef4444; font-size: 12px;" @onclick="@(() => RemoveNavLink(link))" title="Delete Link">✕</button>
                    </div>
                }
            </div>

            <!-- Audio Visualizer Reaction Modes ("Reactors") -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Audio Visualizer Reaction Modes ("Reactors")</div>
                        <div style="font-size: 11px; color: #64748b;">Configure which visualizer modes are visible to web listeners and set default startup mode</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 8px;">
                    @foreach (var reactor in ProfileManager.CurrentProfile.VisualizerReactors) {
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #161922; border: 1px solid #282f3e; border-radius: 6px; padding: 6px 10px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <input type="checkbox" checked="@reactor.IsEnabled" @onchange="@(() => ToggleReactorEnabled(reactor))" title="Show or hide this mode from web listeners" style="accent-color: #00d2ff; cursor: pointer;" />
                                <span style="font-size: 13px;">@reactor.Emoji</span>
                                <span style="font-size: 12px; font-weight: 600; color: @(reactor.IsEnabled ? "#fff" : "#64748b");">@reactor.Label</span>
                                <span style="font-size: 10px; color: #64748b; background: #0e1117; padding: 1px 5px; border-radius: 4px;">@reactor.BaseMode</span>
                                @if (reactor.IsBuiltin) {
                                    <span style="font-size: 9px; color: #8b5cf6; background: rgba(139, 92, 246, 0.15); padding: 1px 4px; border-radius: 3px;">BUILT-IN</span>
                                }
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <button class="pill-option @(reactor.IsDefault ? "active" : "")" style="padding: 2px 8px; font-size: 10px; @(reactor.IsDefault ? "background: #00d2ff; color: #000; font-weight: 700;" : "")" @onclick="@(() => SetDefaultReactor(reactor.Id))" title="Set as default startup visualizer mode">
                                    @(reactor.IsDefault ? "★ Default" : "Set Default")
                                </button>
                                @if (!reactor.IsBuiltin) {
                                    <button class="scrim-dots-btn" style="color: #ef4444; font-size: 12px; padding: 2px 6px;" title="Delete Custom Reactor" @onclick="@(() => DeleteCustomReactor(reactor))">✕</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Add Custom Reactor -->
                <div style="margin-top: 10px; border-top: 1px dashed #282f3e; padding-top: 8px;">
                    <div style="font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 6px;">+ Add Custom Reactor Preset</div>
                    <div style="display: grid; grid-template-columns: 42px 1fr 1fr auto; gap: 6px; align-items: center;">
                        <input type="text" class="scrim-input" style="padding: 4px; text-align: center; font-size: 12px;" @bind="_newReactorEmoji" placeholder="Emoji" title="Emoji icon" />
                        <input type="text" class="scrim-input" style="padding: 4px 8px; font-size: 11px;" @bind="_newReactorLabel" placeholder="Label (e.g. Neon Wave)" />
                        <select class="scrim-select" style="padding: 4px 6px; font-size: 11px;" @bind="_newReactorBase">
                            <option value="bars">Bars</option>
                            <option value="wave">Wave</option>
                            <option value="spectrum">Spectrum</option>
                            <option value="pulse">Pulse</option>
                        </select>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="AddCustomReactor" disabled="@string.IsNullOrWhiteSpace(_newReactorLabel)">Add</button>
                    </div>
                </div>
            </div>

            <!-- Recently Played Song History Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Show Recently Played Songs</div>
                        <div style="font-size: 11px; color: #64748b;">Allow web listeners to view songs played during this session</div>
                    </div>
                    <label class="scrim-switch">
                        <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableSongHistory" @onchange="ToggleSongHistoryEnabled" />
                        <span class="scrim-slider"></span>
                    </label>
                </div>
                @if (ProfileManager.CurrentProfile.EnableSongHistory) {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); gap: 8px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 11px; color: #94a3b8;">Max songs:</span>
                            <div style="display: flex; gap: 4px; align-items: center;">
                                @foreach (var count in new[] { 5, 10, 15, 20, 25, 50 }) {
                                    <button class="pill-option @(ProfileManager.CurrentProfile.SongHistoryLimit == count ? "active" : "")" style="padding: 2px 8px; font-size: 10px;" @onclick="@(() => SetSongHistoryLimit(count))">
                                        @count
                                    </button>
                                }
                                <input type="number" min="1" max="100" style="width: 48px; background: #1a1d26; border: 1px solid #2d323e; border-radius: 4px; color: #fff; font-size: 10px; padding: 2px 4px; text-align: center;" value="@ProfileManager.CurrentProfile.SongHistoryLimit" @onchange="OnSongHistoryLimitChanged" title="Custom maximum songs count (1-100)" />
                            </div>
                        </div>
                        @if (HistoryService.GetHistory(100).Count > 0) {
                            <button class="pill-option" style="padding: 2px 8px; font-size: 10px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; border-radius: 6px;" @onclick="ClearSessionHistory" title="Clear all song history from web player and console">
                                🗑️ Clear History (@(HistoryService.GetHistory(100).Count))
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Broadcaster Bio & Schedule -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 10px 12px;">
                <label class="scrim-label" style="margin-bottom: 6px;">Station Schedule & Host Bio</label>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <input type="text" class="scrim-input" @bind="ProfileManager.CurrentProfile.ScheduleDescription" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Schedule (e.g., Live Mon-Fri 8PM - 11PM EST)" />
                    <textarea class="scrim-input" style="height: 52px; resize: none; font-size: 11px;" @bind="ProfileManager.CurrentProfile.BroadcasterBio" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Broadcaster Bio / About Station..."></textarea>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px;">
                        <input type="text" class="scrim-input" style="font-size: 10.5px;" @bind="ProfileManager.CurrentProfile.SocialDiscord" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Discord URL / invite" />
                        <input type="text" class="scrim-input" style="font-size: 10.5px;" @bind="ProfileManager.CurrentProfile.SocialTwitch" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Twitch username/URL" />
                        <input type="text" class="scrim-input" style="font-size: 10.5px;" @bind="ProfileManager.CurrentProfile.SocialTwitter" @bind:event="oninput" @bind:after="SaveBranding" placeholder="Twitter / X handle" />
                    </div>
                </div>
            </div>

            <button class="scrim-btn-primary" style="width: 100%;" @onclick="SaveBranding">Save & Apply Branding</button>
        </div>,

        "card-network-access" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    Network & Internet Broadcasting
                </h3>
                <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
            </div>

            <!-- Enable Network Broadcasting Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 10px 14px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">Network Broadcasting</div>
                    <div style="font-size: 11px; color: #64748b;">Allow devices on Wi-Fi and remote listeners to connect</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableNetworkAccess" @onchange="ToggleNetworkAccess" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Enable UPnP Router Forwarding Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 10px 14px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">UPnP Router Port Forwarding</div>
                    <div style="font-size: 11px; color: #64748b;">Automatically map port @ProfileManager.CurrentProfile.Port on router</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableUpnpPortForwarding" @onchange="ToggleUpnpPortForwarding" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Stream Server Port Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Server Port (HTTP & Stream)</div>
                        <div style="font-size: 11px; color: #64748b;">Port used by the web player and audio stream listener endpoint</div>
                    </div>
                    <span style="font-family: monospace; font-size: 12px; font-weight: 700; color: #00d2ff; background: #181b22; padding: 2px 8px; border-radius: 4px; border: 1px solid #2d3342;">
                        :@(ProfileManager.CurrentProfile.Port)
                    </span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 0 8px; flex: 1; min-width: 140px;">
                        <span style="color: #64748b; font-family: monospace; font-size: 12px; margin-right: 4px;">Port:</span>
                        <input type="number" min="1024" max="65535" class="scrim-input" style="border: none; background: transparent; padding: 6px 4px; font-family: monospace; font-size: 12px; color: #fff; width: 100%;" 
                               value="@CustomPortInput" 
                               @oninput="@((ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out int p)) CustomPortInput = p; })" 
                               placeholder="e.g. 8080" />
                    </div>
                    <button class="scrim-btn-primary" style="padding: 6px 14px; font-size: 11px; white-space: nowrap;" @onclick="ApplyServerPort">
                        Apply Port
                    </button>
                    <!-- Quick preset port pills -->
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 8080 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(8080))">8080</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 8000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(8000))">8000</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 9000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(9000))">9000</button>
                    <button class="pill-option @(ProfileManager.CurrentProfile.Port == 5000 ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick="@(() => SetPresetPort(5000))">5000</button>
                </div>
                @if (!string.IsNullOrEmpty(PortChangeStatusMessage)) {
                    <div style="font-size: 11px; margin-top: 6px; color: @(PortChangeSuccess ? "#10b981" : "#ef4444");">
                        @PortChangeStatusMessage
                    </div>
                }
            </div>

            <!-- Restrict to Local Network Only (Private Stream) Toggle -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; background: #12141a; border: 1px solid @(ProfileManager.CurrentProfile.RestrictToLocalNetwork ? "rgba(245, 158, 11, 0.5)" : "#232731"); border-radius: 8px; padding: 10px 14px; transition: border-color 0.2s ease;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff; display: flex; align-items: center; gap: 6px;">
                        <span>Restrict to Local Network Only</span>
                        @if (ProfileManager.CurrentProfile.RestrictToLocalNetwork) {
                            <span style="font-size: 9px; font-weight: 700; color: #f59e0b; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); padding: 1px 6px; border-radius: 4px;">PRIVATE (LAN ONLY)</span>
                        }
                    </div>
                    <div style="font-size: 11px; color: #64748b;">When enabled, website users outside your Wi-Fi/LAN see only a "Private Stream" banner</div>
                </div>
                <label class="scrim-switch">
                    <input type="checkbox" checked="@ProfileManager.CurrentProfile.RestrictToLocalNetwork" @onchange="ToggleRestrictToLocalNetwork" />
                    <span class="scrim-slider"></span>
                </label>
            </div>

            <!-- Stream URL Mount Point Configuration -->
            <div style="margin-bottom: 14px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #fff;">Live Stream URL Path</div>
                        <div style="font-size: 11px; color: #64748b;">Direct mount path for the live audio stream</div>
                    </div>
                    <span style="font-family: monospace; font-size: 12px; font-weight: 700; color: #10b981; background: #181b22; padding: 2px 8px; border-radius: 4px; border: 1px solid #2d3342;">
                        /@(GetNormalizedMount())
                    </span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 0 8px; flex: 1; min-width: 140px;">
                        <span style="color: #64748b; font-family: monospace; font-size: 12px; margin-right: 2px;">/</span>
                        <input type="text" class="scrim-input" style="border: none; background: transparent; padding: 6px 4px; font-family: monospace; font-size: 12px; color: #fff; width: 100%;" 
                               value="@ProfileManager.CurrentProfile.StreamMountPoint" 
                               @onchange="OnStreamMountPointChanged" 
                               placeholder="stream" />
                    </div>
                    <!-- Quick preset mount pills -->
                    <button class="pill-option @(GetNormalizedMount() == "stream" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("stream")'>stream</button>
                    <button class="pill-option @(GetNormalizedMount() == "live" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("live")'>live</button>
                    <button class="pill-option @(GetNormalizedMount() == "radio" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("radio")'>radio</button>
                    <button class="pill-option @(GetNormalizedMount() == "station" ? "active" : "")" style="padding: 4px 8px; font-size: 10px;" @onclick='() => SetPresetMount("station")'>station</button>
                </div>
            </div>

            <!-- Connection URLs List -->
            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px;">
                <!-- Localhost -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Local Machine:</span>
                        <button style="background: none; border: none; color: #00d2ff; cursor: pointer; padding: 0; font-size: 10px;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")'>Open in Browser ↗</button>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #00d2ff; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                http://localhost:@(ProfileManager.CurrentProfile.Port)
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser($"http://localhost:{ProfileManager.CurrentProfile.Port}")' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl($"http://localhost:{ProfileManager.CurrentProfile.Port}", "Local")'>
                            @(CopiedUrlTarget == "Local" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Local LAN -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Local Network (Wi-Fi / LAN):</span>
                        <span style="color: #64748b; font-size: 10px;">For home devices</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #00d2ff; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetLocalNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetLocalNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl(GetLocalNetworkUrl(), "LAN")'>
                            @(CopiedUrlTarget == "LAN" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Outside Network (Public IP) -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>Outside Network (Internet):</span>
                        <span style="color: #64748b; font-size: 10px;">For remote listeners</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden; cursor: pointer;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Click to open in browser">
                            <span style="font-family: monospace; font-size: 11px; color: #10b981; text-decoration: underline; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @GetOutsideNetworkUrl()
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 8px; font-size: 11px; white-space: nowrap;" @onclick='() => OpenInBrowser(GetOutsideNetworkUrl())' title="Open in default browser">
                            Open ↗
                        </button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap;" @onclick='() => CopyUrl(GetOutsideNetworkUrl(), "WAN")'>
                            @(CopiedUrlTarget == "WAN" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>

                <!-- Custom Public Domain / Host / IP (Optional) -->
                <div style="background: #14171d; border: 1px solid #252a35; border-radius: 6px; padding: 10px 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-size: 11px; font-weight: 600; color: #cbd5e1;">Custom Domain / Public Host (Optional)</span>
                        @if (!string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.CustomPublicUrl)) {
                            <button class="pill-option" style="padding: 1px 6px; font-size: 9px; color: #ef4444;" @onclick="ClearCustomPublicUrl" title="Reset to auto-detected public IP">✕ Reset</button>
                        }
                    </div>
                    <div style="font-size: 10px; color: #64748b; margin-bottom: 6px;">
                        Override public IP with your DDNS, domain name, or custom IP.
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 8px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 4px 8px; font-family: monospace; background: #0f1115; border-color: #2b303c;"
                               placeholder="@(ProfileManager.CurrentProfile.UseReverseProxy ? "e.g. radio.mydomain.com or 123.45.67.89" : "e.g. radio.mydomain.com:8080 or 123.45.67.89:8080")"
                               value="@ProfileManager.CurrentProfile.CustomPublicUrl"
                               @onchange="OnCustomPublicUrlChanged" />
                    </div>

                    <!-- HTTPS & Reverse Proxy Options -->
                    <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; padding-top: 6px; border-top: 1px solid #1f232c;">
                        <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: #cbd5e1; user-select: none;" title="Format generated share and VLC links with https:// instead of http://">
                            <input type="checkbox" style="accent-color: #00d2ff; cursor: pointer;"
                                   checked="@ProfileManager.CurrentProfile.UseHttps"
                                   @onchange="ToggleUseHttps" />
                            <span>Use HTTPS</span>
                            @if (ProfileManager.CurrentProfile.UseHttps) {
                                <span style="font-size: 8px; font-weight: 700; color: #10b981; background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); padding: 1px 4px; border-radius: 3px;">HTTPS</span>
                            }
                        </label>

                        <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 11px; color: #cbd5e1; user-select: none;" title="Omit server port (e.g. :4242) from outside links when using Caddy, Nginx, or Cloudflare Tunnel">
                            <input type="checkbox" style="accent-color: #00d2ff; cursor: pointer;"
                                   checked="@ProfileManager.CurrentProfile.UseReverseProxy"
                                   @onchange="ToggleUseReverseProxy" />
                            <span>Using Reverse Proxy</span>
                            @if (ProfileManager.CurrentProfile.UseReverseProxy) {
                                <span style="font-size: 8px; font-weight: 700; color: #00d2ff; background: rgba(0,210,255,0.15); border: 1px solid rgba(0,210,255,0.4); padding: 1px 4px; border-radius: 3px;">NO PORT</span>
                            }
                        </label>
                    </div>
                </div>

                <!-- Direct Stream Endpoint for VLC / Media Players -->
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-bottom: 3px;">
                        <span>VLC & Media Players Endpoint:</span>
                        <span style="color: #f59e0b; font-size: 10px;">Direct Audio Stream (/@(GetNormalizedMount()))</span>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <div style="flex: 1; display: flex; align-items: center; background: #1a1d26; border: 1px solid #2d323e; border-radius: 6px; padding: 5px 8px; overflow: hidden;">
                            <span style="font-family: monospace; font-size: 11px; color: #f59e0b; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @(GetOutsideNetworkUrl())/@(GetNormalizedMount())
                            </span>
                        </div>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px; white-space: nowrap; color: #f59e0b; border-color: rgba(245, 158, 11, 0.4);" @onclick='() => CopyUrl($"{GetOutsideNetworkUrl()}/{GetNormalizedMount()}", "VLC_Card")'>
                            @(CopiedUrlTarget == "VLC_Card" ? "✓" : "Copy")
                        </button>
                    </div>
                </div>
            </div>

            <!-- UPnP & Router Status info -->
            <div style="background: #101217; border: 1px solid #1f232c; border-radius: 6px; padding: 8px 12px; font-size: 11px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: @(NetworkDiscovery.IsUpnpMapped ? "#10b981" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "#eab308" : "#64748b")); display: inline-block;"></span>
                    <span style="color: #94a3b8;">
                        UPnP Status: <strong style="color: @(NetworkDiscovery.IsUpnpMapped ? "#10b981" : "#cbd5e1");">@(NetworkDiscovery.IsUpnpMapped ? $"Port {ProfileManager.CurrentProfile.Port} Forwarded" : (ProfileManager.CurrentProfile.EnableUpnpPortForwarding ? "Ready / Manual forwarding" : "Disabled"))</strong>
                    </span>
                </div>
                <button class="scrim-btn-secondary" style="padding: 2px 8px; font-size: 10px;" @onclick="RefreshNetworkStatus">↻ Refresh</button>
            </div>
        </div>,

        "card-chat" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <h3 class="scrim-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Live Station Chat
                    @if (ProfileManager.CurrentProfile.EnableChat) {
                        <span style="display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 9px; font-weight: 700; color: #10b981; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 4px;">ACTIVE</span>
                    } else {
                        <span style="display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 9px; font-weight: 700; color: #ef4444; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 4px;">PAUSED</span>
                    }
                </h3>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="pill-option" style="padding: 2px 8px; font-size: 10px; color: #f43f5e;" @onclick="ClearChat" title="Clear all chat history">🗑️ Clear</button>
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <!-- Chat Broadcaster Controls -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: #12141a; border: 1px solid #232731; border-radius: 8px; padding: 8px 12px; flex-wrap: wrap; gap: 8px;">
                <div>
                    <div style="font-size: 12px; font-weight: 600; color: #fff;">Enable Listener Chat</div>
                    <div style="font-size: 10px; color: #64748b;">Allow web listeners to chat anonymously in real time</div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25);" @onclick="ClearChat" title="Clear all station chat history">🗑️ Clear Chat</button>
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #38bdf8; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25);" @onclick="@(() => ShowBlacklistManager = !ShowBlacklistManager)" title="Manage banned/blacklisted nicknames">🚫 Blacklist (@ProfileManager.CurrentProfile.NicknameBlacklist.Count)</button>
                    <button class="pill-option" style="padding: 4px 10px; font-size: 11px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25);" @onclick="@(() => ShowBansManager = !ShowBansManager)" title="Manage banned chat users">🔨 Bans (@ProfileManager.CurrentProfile.BannedUsers.Count)</button>
                    <label class="scrim-switch">
                        <input type="checkbox" checked="@ProfileManager.CurrentProfile.EnableChat" @onchange="ToggleChatEnabled" />
                        <span class="scrim-slider"></span>
                    </label>
                </div>
            </div>

            @if (ShowBlacklistManager) {
                <div style="background: #14171f; border: 1px solid #2a313e; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #38bdf8;">BANNED NICKNAME BLACKLIST</span>
                        <button class="scrim-dots-btn" @onclick="@(() => ShowBlacklistManager = false)" style="font-size: 10px;">✕</button>
                    </div>
                    <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 5px 8px; background: #0c0e12;" 
                               placeholder="Add word or phrase to block..." 
                               value="@NewBlacklistWord" 
                               @oninput="@((ChangeEventArgs e) => NewBlacklistWord = e.Value?.ToString() ?? "")"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") AddBlacklistWord(); })" />
                        <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 11px;" @onclick="AddBlacklistWord">+ Add</button>
                    </div>
                    @if (ProfileManager.CurrentProfile.NicknameBlacklist.Count == 0) {
                        <div style="font-size: 10px; color: #64748b; font-style: italic;">No blacklisted nicknames configured.</div>
                    } else {
                        <div style="display: flex; flex-wrap: wrap; gap: 5px; max-height: 90px; overflow-y: auto;">
                            @foreach (var banned in ProfileManager.CurrentProfile.NicknameBlacklist) {
                                <span style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; font-size: 10px; border-radius: 4px; padding: 2px 6px; display: inline-flex; align-items: center; gap: 4px;">
                                    @banned
                                    <button style="background: none; border: none; color: #f87171; cursor: pointer; padding: 0; font-size: 9px;" @onclick="@(() => RemoveBlacklistWord(banned))">✕</button>
                                </span>
                            }
                        </div>
                    }
                </div>
            }

            @if (ShowBansManager) {
                <div style="background: #14171f; border: 1px solid #382a32; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #f43f5e;">BANNED CHAT USERS</span>
                        <button class="scrim-dots-btn" @onclick="@(() => ShowBansManager = false)" style="font-size: 10px;">✕</button>
                    </div>
                    @if (ProfileManager.CurrentProfile.BannedUsers.Count == 0) {
                        <div style="font-size: 10px; color: #64748b; font-style: italic;">No users currently banned.</div>
                    } else {
                        <div style="display: flex; flex-direction: column; gap: 6px; max-height: 120px; overflow-y: auto;">
                            @foreach (var banned in ProfileManager.CurrentProfile.BannedUsers) {
                                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); border-radius: 4px; padding: 4px 8px; font-size: 10px;">
                                    <div>
                                        <strong style="color: #fca5a5;">@banned.Nickname</strong>
                                        <span style="color: #64748b; font-family: monospace; margin-left: 6px;">[@banned.UserId]</span>
                                    </div>
                                    <button class="pill-option" style="padding: 2px 6px; font-size: 9px; color: #34d399; background: rgba(52, 211, 153, 0.15); border: 1px solid rgba(52, 211, 153, 0.3);" @onclick="@(() => UnbanUser(banned.UserId))">Unban</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (ShowAssignNicknameModal && !string.IsNullOrEmpty(AssignTargetUser)) {
                <div style="background: #151922; border: 1px solid #38bdf8; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; box-shadow: 0 4px 14px rgba(0,0,0,0.5);">
                    <div style="font-size: 11px; font-weight: 700; color: #fff; margin-bottom: 4px;">
                        Assign Nickname to <span style="color: #38bdf8;">@AssignTargetUser</span>
                    </div>
                    <div style="font-size: 10px; color: #94a3b8; margin-bottom: 8px;">
                        The listener's active handle will update automatically. They can customize it anytime.
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" class="scrim-input" style="flex: 1; font-size: 11px; padding: 6px 8px; background: #0c0e12;" 
                               placeholder="Enter new nickname..." 
                               value="@NewAssignedNickname" 
                               @oninput="@((ChangeEventArgs e) => NewAssignedNickname = e.Value?.ToString() ?? "")"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") ConfirmAssignNickname(); })" />
                        <button class="scrim-btn-primary" style="padding: 4px 12px; font-size: 11px;" @onclick="ConfirmAssignNickname">Assign</button>
                        <button class="scrim-btn-secondary" style="padding: 4px 10px; font-size: 11px;" @onclick="@(() => ShowAssignNicknameModal = false)">Cancel</button>
                    </div>
                </div>
            }

            <!-- Message Stream Viewport -->
            <div style="height: 260px; overflow-y: auto; scroll-behavior: smooth; background: #0c0e12; border: 1px solid #1f232c; border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;" id="consoleChatContainer">
                @if (ConsoleChatMessages.Count == 0) {
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #64748b; font-size: 11px; text-align: center; padding: 16px;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="1.5" style="margin-bottom: 6px;">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>No chat messages yet.</span>
                        <span style="font-size: 10px; color: #475569; margin-top: 2px;">Messages from web listeners and your host replies will appear here in real time.</span>
                    </div>
                } else {
                    @foreach (var msg in ConsoleChatMessages) {
                        <div style="background: @(msg.IsHost ? "rgba(239, 68, 68, 0.08)" : "#14171d"); border: 1px solid @(msg.IsHost ? "rgba(239, 68, 68, 0.3)" : "#232731"); border-radius: 6px; padding: 6px 10px; font-size: 11px; line-height: 1.4;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <strong style="color: @(msg.IsHost ? "#ef4444" : msg.Color); cursor: @(msg.IsHost ? "default" : "pointer");" 
                                            title="@(msg.IsHost ? "" : "Click to assign a nickname to this user")" 
                                            @onclick="@(() => { if (!msg.IsHost) OpenAssignNickname(msg.Sender); })">
                                        @msg.Sender @(msg.IsHost ? "" : "✏️")
                                    </strong>
                                    @if (msg.IsHost) {
                                        <span style="font-size: 9px; font-weight: 700; color: #fff; background: #ef4444; border-radius: 3px; padding: 1px 4px; letter-spacing: 0.5px;">DJ</span>
                                    } else {
                                        <button class="pill-option" style="padding: 1px 5px; font-size: 9px; color: #f43f5e; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); margin-left: 4px;" 
                                                title="Ban this user from chat" 
                                                @onclick="@(() => BanUserFromMessage(msg))">
                                            🚫 Ban
                                        </button>
                                    }
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 9px; color: #64748b; font-family: monospace;">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <button class="scrim-dots-btn" style="color: #94a3b8; font-size: 11px; padding: 0 4px; line-height: 1; border-radius: 4px;" 
                                            title="Delete this message" 
                                            @onclick="@(() => DeleteChatMessage(msg))">
                                        ✕
                                    </button>
                                </div>
                            </div>
                            <div style="color: #e2e8f0; word-break: break-word;">@LiveChatService.ConvertEmoticons(msg.Text)</div>
                        </div>
                    }
                }
            </div>

            <!-- Broadcaster Message Input -->
            <div style="position: relative;">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div style="position: relative; flex: 1; display: flex; align-items: center;">
                        <input type="text" class="scrim-input" style="width: 100%; font-size: 12px; padding: 8px 34px 8px 10px; background: #12141a; border-color: #2b303c;" 
                               placeholder="Reply to chat as DJ... (:O, :), :D autoconvert)" 
                               value="@HostChatMessage" 
                               @oninput="OnHostChatMessageInput"
                               @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") SendHostMessage(); })" />
                        <button type="button" style="position: absolute; right: 6px; background: transparent; border: none; font-size: 16px; cursor: pointer; padding: 2px 4px; border-radius: 4px; line-height: 1; opacity: 0.8;" 
                                title="Choose emoji" 
                                @onclick="ToggleHostEmojiPicker">
                            😊
                        </button>
                    </div>
                    <button class="scrim-btn-primary" style="padding: 8px 14px; font-size: 12px; white-space: nowrap; background: #ef4444; border-color: #ef4444;" @onclick="SendHostMessage">
                        Send 🎙️
                    </button>
                </div>

                @if (ShowHostEmojiPicker) {
                    <div style="position: absolute; bottom: 100%; left: 0; margin-bottom: 6px; background: #14171e; border: 1px solid #2b303d; border-radius: 8px; padding: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.6); z-index: 50; width: 280px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; font-weight: 700; color: #00d2ff;">
                            <span>EMOJIS</span>
                            <span style="font-size: 10px; color: #64748b; font-weight: normal;">:O converts to 😮</span>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; max-height: 140px; overflow-y: auto;">
                            @foreach (var emo in QuickEmojis) {
                                <button type="button" style="background: transparent; border: 1px solid transparent; font-size: 16px; cursor: pointer; padding: 4px; border-radius: 4px;" 
                                        @onclick="@(() => InsertHostEmoji(emo))">
                                    @emo
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 10px; color: #64748b;">
                <span>Sending as verified <strong>@(string.IsNullOrWhiteSpace(ProfileManager.CurrentProfile.HostName) ? "DJ" : $"{ProfileManager.CurrentProfile.HostName} [DJ]")</strong></span>
                <span>Press Enter to send</span>
            </div>
        </div>,

        "card-plugins" => @<div class="scrim-card">
            <div class="scrim-card-header scrim-drag-handle">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <h3 class="scrim-card-title" style="margin: 0;">Plugins & Extensions</h3>
                    <span style="font-size: 11px; padding: 2px 7px; border-radius: 10px; background: rgba(139, 92, 246, 0.15); color: #c084fc; font-weight: 700;">
                        @PluginLoader.Plugins.Count(p => p.IsEnabled)/@PluginLoader.Plugins.Count Active
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <button class="scrim-dots-btn" @onclick="ReloadPlugins" title="Reload & Rescan Plugins">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                        </svg>
                    </button>
                    <button class="scrim-dots-btn" @onclick="OpenPluginsFolder" title="Open Plugins Folder in File Explorer">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </button>
                    <button class="scrim-collapse-btn" @onclick="@(() => ToggleCardCollapsed(cardId))" title="@(IsCardCollapsed(cardId) ? "Expand Card" : "Collapse Card")">@(IsCardCollapsed(cardId) ? "+" : "−")</button>
                    <button class="scrim-dots-btn" @onclick="@(() => RemoveCard(cardId))" title="Remove Card">✕</button>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; max-height: 480px; overflow-y: auto; padding-right: 4px;">
                @if (PluginLoader.Plugins.Count == 0) {
                    <div style="text-align: center; padding: 24px 12px; color: #64748b; font-size: 12px;">
                        No plugins detected. Place plugin assemblies (.dll) or Python plugins into <code>~/.scrim/plugins/</code>.
                    </div>
                } else {
                    @foreach (var plugin in PluginLoader.Plugins) {
                        <div style="background: #14171e; border: 1px solid @(plugin.IsEnabled ? "rgba(139, 92, 246, 0.3)" : "#232731"); border-radius: 8px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; transition: border-color 0.2s ease;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 13px; font-weight: 600; color: #f1f5f9;">@plugin.Name</span>
                                    @if (plugin.PluginType == "Python") {
                                        <span style="font-size: 9px; padding: 1px 5px; border-radius: 4px; background: rgba(59, 130, 246, 0.15); color: #60a5fa; font-weight: 700; border: 1px solid rgba(59, 130, 246, 0.3);">Python</span>
                                    }
                                    <span style="font-size: 9px; padding: 1px 5px; border-radius: 4px; background: @(plugin.IsEnabled ? "rgba(34, 197, 94, 0.15)" : "rgba(100, 116, 139, 0.2)"); color: @(plugin.IsEnabled ? "#4ade80" : "#94a3b8"); font-weight: 700;">
                                        @(plugin.IsEnabled ? "ON" : "OFF")
                                    </span>
                                </div>

                                <div style="font-size: 10px; color: #64748b; margin-top: 2px;">
                                    <span>v@(plugin.Version)</span>
                                    @if (!string.IsNullOrWhiteSpace(plugin.Author)) {
                                        <span> • @plugin.Author</span>
                                    }
                                </div>
                            </div>
                            <label class="scrim-switch" style="flex-shrink: 0;" title="@(plugin.IsEnabled ? "Click to Disable" : "Click to Enable")">
                                <input type="checkbox" checked="@plugin.IsEnabled" @onchange="@(() => TogglePlugin(plugin.Id))" />
                                <span class="scrim-slider"></span>
                            </label>
                        </div>
                    }
                }
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 11px;">
                <button class="pill-option" style="padding: 3px 10px; font-size: 10px; color: #c084fc; border-color: rgba(139, 92, 246, 0.3);" @onclick="OpenPluginsFolder">
                    📁 Open Folder
                </button>
                <button class="pill-option" style="padding: 3px 10px; font-size: 10px; color: #38bdf8;" @onclick="ReloadPlugins">
                    🔄 Rescan
                </button>
            </div>
        </div>,

