            Windows = _enumerator.GetActiveWindows().ToList();
            StateHasChanged();
        } catch { }
    }

    private void ToggleBroadcast() {
        var active = StationManager.GetActiveStation();
        if (active != null && !active.IsPrimary) {
            OnToggleStationLive(active);
        } else {
            if (IsLive || (active != null && active.IsLive)) {
                StopBroadcast();
            } else {
                if (!FFmpegService.IsInstalled) {
                    ShowFFmpegModal = true;
                    return;
                }
                StartBroadcast();
            }
        }
    }

    private void OnToggleStationLive(StationPipeline st) {
        if (!FFmpegService.IsInstalled) {
            ShowFFmpegModal = true;
            return;
        }

        try {
            StreamServer.Start(ProfileManager.CurrentProfile.Port);
        } catch { }

        if (st.IsPrimary) {
            if (IsLive || st.IsLive) {
                StopBroadcast();
            } else {
                StartBroadcast();
            }
            StateHasChanged();
            return;
        }

        if (st.IsLive) {
            StationManager.StopStation(st.Config.Id);
            if (st.Config.Id == (StationManager.GetActiveStation()?.Config.Id ?? "")) {
                IsLive = false;
            }
        } else {
            StationManager.StartStation(st.Config.Id, MicService, LocalPlayer);
            if (st.Config.Id == (StationManager.GetActiveStation()?.Config.Id ?? "")) {
                IsLive = true;
            }
        }
        StateHasChanged();
    }

