                <button class="pill-option @(ProfileManager.CurrentProfile.ColumnLayoutMode == "WideLeft" ? "active" : "")" 
                        @onclick='() => SetColumnLayoutMode("WideLeft")' 
                        title="Expanded left sidebar for routing, playlists, and branding (420px - 1fr - 310px)">
                    ⬅️ Wide Left (Big-Mid-Little)
                </button>
                <button class="pill-option @(ProfileManager.CurrentProfile.ColumnLayoutMode == "WideRight" ? "active" : "")" 
                        @onclick='() => SetColumnLayoutMode("WideRight")' 
