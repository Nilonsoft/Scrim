    private void AddCard(string cardId) {
        if (LeftColumn.Contains(cardId) || CenterColumn.Contains(cardId) || RightColumn.Contains(cardId)) {
            return;
        }
        // Add to the column with fewest cards
        if (LeftColumn.Count <= CenterColumn.Count && LeftColumn.Count <= RightColumn.Count) {
            LeftColumn.Add(cardId);
        } else if (CenterColumn.Count <= RightColumn.Count) {
            CenterColumn.Add(cardId);
        } else {
            RightColumn.Add(cardId);
        }
        SaveCardLayout();
        _ = ReinitDragDropAsync();
    }

