@using Scrim.Server
@using Scrim.Audio
@using Scrim.Encoding
@using Scrim.Windows
@using System.Threading
@using System.Collections.Generic
@using Scrim.Configuration
@inject HttpStreamServer StreamServer
@inject ProcessLoopbackCapture Capture
@inject MultiFormatTranscoder Transcoder
@inject IProfileManager ProfileManager

<div class="scrim-card">
    <h4 style="color: white; margin-top: 0;">Broadcast Status</h4>
    
    <div class="mb-3">
        <label class="form-label" style="color: #ccc;">Target Application</label>
        <select class="form-select bg-dark text-white border-secondary" @bind="SelectedProcessId" disabled="@IsLive">
            <option value="0">(Select an application)</option>
            @foreach (var w in Windows) {
                <option value="@w.ProcessId">@w.Title (@w.ProcessName)</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="RefreshWindows" disabled="@IsLive">Refresh</button>
    </div>

    <div class="mb-3">
        <p style="color: #ccc; margin-bottom: 0;">Status: <strong style="color: @(IsLive ? "#ff4444" : "#44ff44")">@(IsLive ? "ON AIR" : "OFFLINE")</strong></p>
        @if (IsLive)
        {
            <p style="color: #ccc; margin-top: 5px; margin-bottom: 0; font-size: 0.9em;">
                Web UI: <a href="http://localhost:@(ProfileManager.CurrentProfile.Port)" target="_blank" style="color: #00d2ff; text-decoration: none;">http://localhost:@(ProfileManager.CurrentProfile.Port)</a>
            </p>
        }
    </div>
    <div class="d-flex">
        <button class="scrim-btn-primary w-100" @onclick="StartStream" disabled="@(IsLive || SelectedProcessId == 0)">Start Stream</button>
        <button class="btn btn-danger" @onclick="StopStream" disabled="@(!IsLive)">Stop Stream</button>
    </div>
</div>

@code {
    private bool IsLive;
    private uint SelectedProcessId;
    private IEnumerable<WindowInfo> Windows = Array.Empty<WindowInfo>();
    private readonly WindowEnumerator _enumerator = new WindowEnumerator();

    protected override void OnInitialized() {
        RefreshWindows();
    }

    private void RefreshWindows() {
        Windows = _enumerator.GetActiveWindows();
    }

    private void StartStream() { 
        IsLive = true; 
        StreamServer.Start(ProfileManager.CurrentProfile.Port);
        Capture.StartCapture(SelectedProcessId);
        Transcoder.StartTranscoding(Capture.AudioStream);
    }
    
    private void StopStream() { 
        IsLive = false; 
        StreamServer.Stop();
        Transcoder.StopTranscoding();
        Capture.StopCapture();
    }
}
