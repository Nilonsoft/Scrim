<div class="scrim-card">
    <h4 style="color: white; margin-top: 0;">Now Playing</h4>
    <h2 style="color: white;">@Title</h2>
    <h5 style="color: #aaa;">@Artist</h5>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Unknown Track";
    [Parameter] public string Artist { get; set; } = "Unknown Artist";
}
