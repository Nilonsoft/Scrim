@using Scrim.Configuration
@inject IProfileManager ProfileManager

<div class="scrim-card">
    <h4 style="color: white; margin-top: 0;">Stream Profile</h4>

    <div class="mb-3">
        <label class="form-label text-muted">Active Profile</label>
        <select class="form-select bg-dark text-white border-secondary" @bind="SelectedProfileName">
            @foreach (var p in AvailableProfiles) {
                <option value="@p">@p</option>
            }
        </select>
    </div>

    @if (CurrentProfile != null) {
        <div class="mb-3">
            <label class="form-label text-muted">Profile Name</label>
            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="CurrentProfile.ProfileName" />
        </div>
        <div class="mb-3">
            <label class="form-label text-muted">Format</label>
            <select class="form-select bg-dark text-white border-secondary" @bind="CurrentProfile.AudioFormat">
                <option value="Mp3">MP3</option>
                <option value="Aac">AAC</option>
                <option value="Opus">Opus</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label text-muted">Bitrate (kbps)</label>
            <div class="input-group">
                <select class="form-select bg-dark text-white border-secondary" @bind="CurrentProfile.Bitrate" style="max-width: 120px;">
                    <option value="64">64 kbps</option>
                    <option value="96">96 kbps</option>
                    <option value="128">128 kbps</option>
                    <option value="192">192 kbps</option>
                    <option value="256">256 kbps</option>
                    <option value="320">320 kbps</option>
                </select>
                <input type="number" class="form-control bg-dark text-white border-secondary" @bind="CurrentProfile.Bitrate" placeholder="Custom..." />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label text-muted">Broadcast Port</label>
            <input type="number" class="form-control bg-dark text-white border-secondary" @bind="CurrentProfile.Port" />
        </div>
        <div class="mb-4">
            <label class="form-label text-secondary small">System Tray Behavior</label>
            <select class="form-select scrim-input" @bind="CurrentProfile.CloseMode">
                <option value="@CloseToTrayMode.Ask">Ask Every Time</option>
                <option value="@CloseToTrayMode.MinimizeToTray">Always Minimize to Tray</option>
                <option value="@CloseToTrayMode.Close">Always Exit Application</option>
            </select>
        </div>
        
        <button class="scrim-btn-primary w-100" @onclick="SaveProfile">Save Configuration</button>
    }
</div>

@code {
    private IEnumerable<string> AvailableProfiles = Array.Empty<string>();

    private string _selectedProfileName = "Default";
    public string SelectedProfileName {
        get => _selectedProfileName;
        set {
            if (_selectedProfileName != value) {
                _selectedProfileName = value;
                LoadSelectedProfile();
            }
        }
    }

    private ScrimProfile? CurrentProfile;

    protected override void OnInitialized() {
        AvailableProfiles = ProfileManager.GetAvailableProfiles();
        _selectedProfileName = AvailableProfiles.FirstOrDefault() ?? "Default";
        LoadSelectedProfile();
    }

    private void LoadSelectedProfile() {
        ProfileManager.LoadProfile(SelectedProfileName);
        CurrentProfile = ProfileManager.CurrentProfile;
    }

    private void SaveProfile() {
        if (CurrentProfile != null) {
            ProfileManager.SaveProfile(CurrentProfile);
        }
    }
}
